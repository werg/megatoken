2026-11-22T08:54:47.2229201Z FORMATTED_SOURCE_JSON {"path": "scripts/qualify_semantic_v8_target_inventory.py", "content": "#!/usr/bin/env python3\n\"\"\"Inventory positive-weight V8 target windows from the ordinary native planner.\n\nThis is a read-only preflight: it prepares the exact train windows and native\nloss plans, but does not execute backward or change model weights.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nfrom dataclasses import asdict\nfrom pathlib import Path\n\nfrom megatoken.data import PreparedCorpus, iter_windows\nfrom megatoken.data.semantic_json import stable_algorithm_hash\nfrom megatoken.loading import build_model, load_model_config\nfrom megatoken.training.config import TrainConfig\nfrom megatoken.training.engine import batch_counters, prepare_batches, window_config\nfrom megatoken.training.semantic_v8 import (\n    load_semantic_v8_codec,\n    merge_semantic_v8_target_exposures,\n    preflight_semantic_training_v8,\n    semantic_v8_target_exposure_from_batches,\n    semantic_v8_target_step_summary,\n)\nfrom megatoken.training.stream import EpisodeWindow\n\n\ndef require(condition: bool, message: str) -> None:\n    if not condition:\n        raise ValueError(message)\n\n\ndef read_json(path: Path):\n    return json.loads(path.read_text())\n\n\ndef target_inventory(config_source, expected_source_ids_source=None):\n    config_raw = (\n        read_json(config_source) if isinstance(config_source, (str, Path)) else config_source\n    )\n    config = TrainConfig.from_dict(config_raw)\n    config_identity = asdict(config)\n    for non_objective in (\n        \"output\",\n        \"max_steps\",\n        \"checkpoint_every\",\n        \"keep_checkpoints\",\n        \"log_every\",\n        \"device\",\n    ):\n        config_identity.pop(non_objective, None)\n    require(config.semantic_v8_policy is not None, \"Inventory requires an explicit V8 policy\")\n    require(\n        config.use_stage_mixture is False,\n        \"Inventory currently requires the exact flat V8 support stream\",\n    )\n    require(\n        config.microbatch_episodes == 1\n        and config.max_accumulation_windows == 1\n        and config.decoupled is None\n        and os.environ.get(\"WORLD_SIZE\", \"1\") == \"1\",\n        \"Inventory requires one synchronous, ordinary optimizer window per update\",\n    )\n    require(\n        len(config.datasets) == 1,\n        \"Inventory requires one immutable prepared support root\",\n    )\n\n    overrides = {\n        **config.model_overrides,\n        \"expert_backend\": config.expert_backend,\n        \"checkpoint_stages\": config.gradient_checkpointing,\n    }\n    model_config = load_model_config(config.model, **overrides)\n    codec = load_semantic_v8_codec(config.codec, vocab_size=model_config.vocab_size)\n    require(\n        config.generated_capacity <= model_config.max_capacity,\n        \"Configured generated capacity exceeds model\",\n    )\n    supply = preflight_semantic_training_v8(\n        config.datasets,\n        codec=codec,\n        policy=config.semantic_v8_policy,\n        max_history=model_config.max_history_chunks,\n        max_positions=model_config.max_capacity,\n    )\n    registry_digest = config.semantic_v8_policy[\"registryDigest\"]\n    require(\n        supply[\"registryDigest\"] == registry_digest,\n        \"Prepared support registry differs from policy\",\n    )\n\n    prepared_root = Path(config.datasets[0]).resolve()\n    manifest = read_json(prepared_root / \"manifest.json\")\n    registry = read_json(prepared_root / \"semantic-v8-families.json\")\n    require(\n        registry.get(\"digest\") == registry_digest,\n        \"Prepared registry digest differs from V8 policy\",\n    )\n    registry_ids = {row[\"id\"] for row in registry[\"sources\"]}\n    if expected_source_ids_source is not None:\n        inventory = (\n            read_json(expected_source_ids_source)\n            if isinstance(expected_source_ids_source, (str, Path))\n            else {\n                \"sourceIds\": list(expected_source_ids_source),\n                \"schema\": \"semantic-v8-source-population/1\",\n                \"registryDigest\": registry_digest,\n            }\n        )\n        expected_ids = inventory.get(\"sourceIds\")\n        require(\n            inventory.get(\"schema\") == \"semantic-v8-source-population/1\"\n            and inventory.get(\"registryDigest\") == registry_digest\n            and isinstance(expected_ids, list)\n            and len(expected_ids) == 64\n            and len(set(expected_ids)) == 64\n            and set(expected_ids) == registry_ids,\n            \"Support source inventory is invalid or differs from the prepared registry\",\n        )\n    else:\n        expected_ids = sorted(registry_ids)\n    expected_ids = set(expected_ids)\n    split_by_id = {}\n    for component in registry[\"components\"]:\n        for source_id in component[\"sourceIds\"]:\n            require(\n                source_id not in split_by_id,\n                \"Prepared registry assigns a source to multiple splits\",\n            )\n            split_by_id[source_id] = component[\"split\"]\n    expected_train_ids = {source_id for source_id, split in split_by_id.items() if split == \"train\"}\n    split_counts = {\n        split: sum(value == split for value in split_by_id.values())\n        for split in (\"train\", \"validation\", \"test\")\n    }\n    require(\n        len(expected_ids) == 64\n        and split_counts == {\"train\": 48, \"validation\": 12, \"test\": 4}\n        and set(split_by_id) == expected_ids,\n        \"Inventory requires the exact 64-source, 48/12/4 registry\",\n    )\n\n    model = build_model(\n        model_config,\n        codec,\n        device=\"cpu\",\n        precision=config.precision,\n        packs=config.packs,\n    )\n    effective_weights = dict(config.loss_weights)\n    effective_weights[\"router_balance\"] = 0.0\n    windows_config = window_config(config)\n    exposures = []\n    observed_sources = set()\n    observed_windows = set()\n    update_window_count = 0\n    one_pass_meter_count = 0\n    available_records = set()\n    available_denominators = {}\n    train_episode_count = 0\n    with PreparedCorpus(config.datasets, split=\"train\") as corpus:\n        require(\n            corpus.codec_fingerprint == codec.fingerprint,\n            \"Prepared corpus tokenizer differs\",\n        )\n        require(\n            len(corpus) == len(expected_train_ids),\n            \"Prepared training episode count differs from the frozen source split\",\n        )\n        for index in range(len(corpus)):\n            episode, assets = corpus.fetch(index)\n            source_id = episode.lineage.source_id\n            require(\n                source_id in expected_train_ids,\n                \"Prepared training episode is outside the frozen train source inventory\",\n            )\n            require(\n                source_id not in observed_sources,\n                \"Prepared support has a duplicate training source\",\n            )\n            require(\n                episode.lineage.frozen_split == \"train\",\n                \"Inventory enumerated a nontraining episode\",\n            )\n            observed_sources.add(source_id)\n            train_episode_count += 1\n            for window in iter_windows(episode, codec, windows_config):\n                window_key = (source_id, window.index)\n                require(\n                    window_key not in observed_windows,\n                    \"Native window iterator duplicated a window\",\n                )\n                observed_windows.add(window_key)\n                item = EpisodeWindow(episode=episode, window=window, assets=assets)\n                batches = prepare_batches(model, [item], config)\n                update_window_count += int(any(any(batch.counts.values()) for batch in batches))\n                if any(any(batch.counts.values()) for batch in batches):\n                    one_pass_meter_count += sum(\n                        getattr(batch_counters([batch]), config.schedule.meter) for batch in batches\n                    )\n                for batch in batches:\n                    for step in batch.steps:\n                        for encoded, plan in zip(step.records, step.plans, strict=True):\n                            record = encoded.record\n                            if not record.policy_mask:\n                                continue\n                            available_records.add((source_id, record.logical_id, record.record_id))\n                            for name, count in plan.denominators.items():\n                                if count:\n                                    available_denominators[name] = (\n                                        available_denominators.get(name, 0) + count\n                                    )\n                exposures.append(\n                    semantic_v8_target_exposure_from_batches(\n                        batches,\n                        registry_digest=registry_digest,\n                        effective_loss_weights=effective_weights,\n                    )\n                )\n    require(\n        observed_sources == expected_train_ids,\n        \"Prepared support omitted or substituted a frozen training source\",\n    )\n    require(observed_windows, \"Prepared support has no train windows\")\n    phase_meter, phase_budget = config.schedule.meter, config.schedule.budget\n    require(\n        phase_meter == \"P\" and one_pass_meter_count <= phase_budget,\n        \"Measured one-pass window meter exceeds or differs from the exact phase budget\",\n    )\n\n    merged = merge_semantic_v8_target_exposures(exposures, registry_digest=registry_digest)\n    scored_sources = merged[\"sources\"]\n    positive_weight = semantic_v8_target_step_summary(merged)\n    body = {\n        \"schema\": \"semantic-v8-positive-loss-target-inventory/1\",\n        \"registryDigest\": registry_digest,\n        \"sourceIds\": sorted(expected_train_ids),\n        \"scoredSourceIds\": sorted(scored_sources),\n        \"trainEpisodeCount\": train_episode_count,\n        \"windowCount\": len(observed_windows),\n        \"optimizerWindowCount\": update_window_count,\n        \"phaseMeter\": phase_meter,\n        \"phaseBudget\": phase_budget,\n        \"onePassMeterCount\": one_pass_meter_count,\n        \"preparedManifestFingerprint\": manifest[\"fingerprint\"],\n        \"codecFingerprint\": codec.fingerprint,\n        \"trainingConfigDigest\": stable_algorithm_hash(config_identity),\n        \"modelConfigDigest\": stable_algorithm_hash(model_config.to_dict()),\n        \"windowConfig\": asdict(windows_config),\n        \"effectiveLossWeights\": effective_weights,\n        \"available\": {\n            \"policyTargetRecordCount\": len(available_records),\n            \"lossDenominators\": dict(sorted(available_denominators.items())),\n        },\n        \"positiveWeight\": {\n            key: positive_weight[key]\n            for key in (\n                \"sourceCount\",\n                \"logicalTargetCount\",\n                \"physicalTargetRecordCount\",\n                \"scoredOccurrences\",\n                \"lossDenominators\",\n            )\n        },\n        \"sources\": scored_sources,\n        \"optimizerUpdates\": 0,\n        \"learnedSuccess\": None,\n    }\n    return {**body, \"digest\": stable_algorithm_hash(body)}\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--config\", type=Path, required=True)\n    parser.add_argument(\"--expected-source-ids\", type=Path)\n    parser.add_argument(\"--output\", type=Path, required=True)\n    args = parser.parse_args()\n    result = target_inventory(args.config, args.expected_source_ids)\n    args.output.parent.mkdir(parents=True, exist_ok=True)\n    args.output.write_text(json.dumps(result, indent=2, allow_nan=False) + \"\\n\")\n    print(\n        json.dumps(\n            {\n                \"output\": str(args.output.resolve()),\n                \"digest\": result[\"digest\"],\n                \"registryDigest\": result[\"registryDigest\"],\n                \"sourceCount\": result[\"positiveWeight\"][\"sourceCount\"],\n                \"windowCount\": result[\"windowCount\"],\n                \"optimizerWindowCount\": result[\"optimizerWindowCount\"],\n                \"phaseMeter\": result[\"phaseMeter\"],\n                \"phaseBudget\": result[\"phaseBudget\"],\n                \"onePassMeterCount\": result[\"onePassMeterCount\"],\n                \"logicalTargetCount\": result[\"positiveWeight\"][\"logicalTargetCount\"],\n                \"physicalTargetRecordCount\": result[\"positiveWeight\"][\"physicalTargetRecordCount\"],\n                \"scoredOccurrences\": result[\"positiveWeight\"][\"scoredOccurrences\"],\n                \"lossDenominators\": result[\"positiveWeight\"][\"lossDenominators\"],\n                \"optimizerUpdates\": 0,\n                \"learnedSuccess\": None,\n            },\n            sort_keys=True,\n        )\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}
2026-11-22T08:54:47.2580975Z FORMATTED_SOURCE_JSON {"path": "src/megatoken/training/target_inventory_v8.py", "content": "\"\"\"Bounded comparison for positive-loss target inventory and optimizer census.\"\"\"\n\nfrom __future__ import annotations\n\nfrom megatoken.data.semantic_json import stable_algorithm_hash\n\n\ndef validate_target_inventory(\n    inventory,\n    *,\n    rederived_inventory,\n    registry_digest,\n    prepared_manifest_fingerprint,\n    codec_fingerprint,\n    training_config_digest,\n    model_config_digest,\n):\n    required = {\n        \"schema\",\n        \"registryDigest\",\n        \"sourceIds\",\n        \"scoredSourceIds\",\n        \"trainEpisodeCount\",\n        \"windowCount\",\n        \"optimizerWindowCount\",\n        \"phaseMeter\",\n        \"phaseBudget\",\n        \"onePassMeterCount\",\n        \"preparedManifestFingerprint\",\n        \"codecFingerprint\",\n        \"trainingConfigDigest\",\n        \"modelConfigDigest\",\n        \"windowConfig\",\n        \"effectiveLossWeights\",\n        \"available\",\n        \"positiveWeight\",\n        \"sources\",\n        \"optimizerUpdates\",\n        \"learnedSuccess\",\n        \"digest\",\n    }\n    if not isinstance(inventory, dict) or set(inventory) != required:\n        raise ValueError(\"V8 target inventory has an invalid field set\")\n    sources = inventory.get(\"sources\")\n    if not isinstance(sources, dict):\n        raise ValueError(\"V8 target inventory sources must be an object\")\n    for source in sources.values():\n        if not isinstance(source, dict) or not isinstance(source.get(\"logicalTargets\"), dict):\n            raise ValueError(\"V8 target inventory has malformed source target rows\")\n        for target in source[\"logicalTargets\"].values():\n            if not isinstance(target, dict) or not isinstance(target.get(\"records\"), dict):\n                raise ValueError(\"V8 target inventory has malformed logical target rows\")\n            for record in target[\"records\"].values():\n                if not isinstance(record, dict):\n                    raise ValueError(\"V8 target inventory has malformed physical target rows\")\n                indices = record.get(\"windowIndices\")\n                if (\n                    not isinstance(indices, list)\n                    or any(type(index) is not int or index < 0 for index in indices)\n                    or indices != sorted(set(indices))\n                ):\n                    raise ValueError(\"V8 target inventory has duplicate or invalid window indices\")\n    if not isinstance(rederived_inventory, dict) or inventory != rederived_inventory:\n        raise ValueError(\"V8 target inventory differs from exact native planner re-derivation\")\n    body = {key: value for key, value in inventory.items() if key != \"digest\"}\n    if (\n        inventory[\"schema\"] != \"semantic-v8-positive-loss-target-inventory/1\"\n        or inventory[\"registryDigest\"] != registry_digest\n        or inventory[\"preparedManifestFingerprint\"] != prepared_manifest_fingerprint\n        or inventory[\"codecFingerprint\"] != codec_fingerprint\n        or inventory[\"trainingConfigDigest\"] != training_config_digest\n        or inventory[\"modelConfigDigest\"] != model_config_digest\n        or inventory[\"digest\"] != stable_algorithm_hash(body)\n        or inventory[\"optimizerUpdates\"] != 0\n        or inventory[\"learnedSuccess\"] is not None\n        or type(inventory[\"windowCount\"]) is not int\n        or inventory[\"windowCount\"] < 1\n        or type(inventory[\"optimizerWindowCount\"]) is not int\n        or not 1 <= inventory[\"optimizerWindowCount\"] <= inventory[\"windowCount\"]\n        or inventory[\"phaseMeter\"] != \"P\"\n        or type(inventory[\"phaseBudget\"]) is not int\n        or inventory[\"phaseBudget\"] < 1\n        or type(inventory[\"onePassMeterCount\"]) is not int\n        or not 0 <= inventory[\"onePassMeterCount\"] <= inventory[\"phaseBudget\"]\n        or type(inventory[\"trainEpisodeCount\"]) is not int\n        or inventory[\"trainEpisodeCount\"] != len(inventory[\"sourceIds\"])\n        or len(inventory[\"sourceIds\"]) != 48\n        or len(set(inventory[\"sourceIds\"])) != 48\n        or inventory[\"sourceIds\"] != sorted(inventory[\"sourceIds\"])\n        or inventory[\"scoredSourceIds\"] != sorted(inventory[\"sources\"])\n        or not set(inventory[\"scoredSourceIds\"]) <= set(inventory[\"sourceIds\"])\n    ):\n        raise ValueError(\"V8 target inventory identity, count or seal is invalid\")\n    if (\n        not isinstance(inventory[\"sourceIds\"], list)\n        or any(not isinstance(item, str) or not item for item in inventory[\"sourceIds\"])\n        or not isinstance(inventory[\"scoredSourceIds\"], list)\n        or len(set(inventory[\"scoredSourceIds\"])) != len(inventory[\"scoredSourceIds\"])\n    ):\n        raise ValueError(\"V8 target inventory source IDs are malformed or duplicated\")\n    expected = inventory[\"positiveWeight\"]\n    expected_keys = {\n        (source_id, logical_id, record_id)\n        for source_id, source in inventory[\"sources\"].items()\n        for logical_id, target in source[\"logicalTargets\"].items()\n        for record_id in target[\"records\"]\n    }\n    if (\n        any(source.get(\"split\") != \"train\" for source in inventory[\"sources\"].values())\n        or any(\n            not isinstance(record.get(\"windowIndices\"), list)\n            or record[\"windowIndices\"] != sorted(set(record[\"windowIndices\"]))\n            or any(type(index) is not int or index < 0 for index in record[\"windowIndices\"])\n            for source in inventory[\"sources\"].values()\n            for target in source[\"logicalTargets\"].values()\n            for record in target[\"records\"].values()\n        )\n        or not isinstance(expected, dict)\n        or expected.get(\"sourceCount\") != len(inventory[\"sources\"])\n        or expected.get(\"logicalTargetCount\")\n        != len(\n            {\n                (source_id, logical_id)\n                for source_id, source in inventory[\"sources\"].items()\n                for logical_id in source[\"logicalTargets\"]\n            }\n        )\n        or expected.get(\"physicalTargetRecordCount\") != len(expected_keys)\n    ):\n        raise ValueError(\"V8 positive-loss target inventory summary differs from its keys\")\n    return expected_keys\n\n\ndef compare_target_inventory(inventory, actual_sources, *, rederived_inventory, **identities):\n    \"\"\"Compare target presence only; token/position-level coverage is not retained.\"\"\"\n    expected_keys = validate_target_inventory(\n        inventory, rederived_inventory=rederived_inventory, **identities\n    )\n    if not isinstance(actual_sources, dict):\n        raise ValueError(\"Optimizer target exposure has no source map\")\n    actual_keys = {\n        (source_id, logical_id, record_id)\n        for source_id, source in actual_sources.items()\n        for logical_id, target in source[\"logicalTargets\"].items()\n        for record_id in target[\"records\"]\n    }\n    missing = sorted(expected_keys - actual_keys)\n    unexpected = sorted(actual_keys - expected_keys)\n    if unexpected:\n        raise ValueError(\n            f\"Optimizer census contains {len(unexpected)} physical target keys outside the rederived inventory\"\n        )\n    expected_logical = {(source_id, logical_id) for source_id, logical_id, _ in expected_keys}\n    actual_logical = {(source_id, logical_id) for source_id, logical_id, _ in actual_keys}\n    expected_records = {\n        (source_id, logical_id, record_id): record\n        for source_id, source in inventory[\"sources\"].items()\n        for logical_id, target in source[\"logicalTargets\"].items()\n        for record_id, record in target[\"records\"].items()\n    }\n    actual_records = {\n        (source_id, logical_id, record_id): record\n        for source_id, source in actual_sources.items()\n        for logical_id, target in source[\"logicalTargets\"].items()\n        for record_id, record in target[\"records\"].items()\n    }\n    occurrence_mismatches = []\n    window_mismatches = []\n    denominator_mismatches = []\n    for key in sorted(expected_keys & actual_keys):\n        expected_record = expected_records[key]\n        actual_record = actual_records[key]\n        if expected_record[\"scoredOccurrences\"] != actual_record.get(\"scoredOccurrences\"):\n            occurrence_mismatches.append(\n                [\n                    list(key),\n                    expected_record[\"scoredOccurrences\"],\n                    actual_record.get(\"scoredOccurrences\"),\n                ]\n            )\n        if expected_record[\"windowIndices\"] != actual_record.get(\"windowIndices\"):\n            window_mismatches.append(\n                [list(key), expected_record[\"windowIndices\"], actual_record.get(\"windowIndices\")]\n            )\n        if expected_record[\"lossDenominators\"] != actual_record.get(\"lossDenominators\"):\n            denominator_mismatches.append(\n                [\n                    list(key),\n                    expected_record[\"lossDenominators\"],\n                    actual_record.get(\"lossDenominators\"),\n                ]\n            )\n    repeated = any(\n        record.get(\"scoredOccurrences\", 0) > len(record.get(\"windowIndices\", []))\n        for source in actual_sources.values()\n        for target in source[\"logicalTargets\"].values()\n        for record in target[\"records\"].values()\n    )\n    total = len(expected_keys)\n    covered = total - len(missing)\n    exact_census = (\n        bool(total)\n        and not missing\n        and not unexpected\n        and not (occurrence_mismatches or window_mismatches or denominator_mismatches)\n    )\n    return {\n        \"schema\": \"semantic-v8-target-presence-comparison/1\",\n        \"inventoryDigest\": inventory[\"digest\"],\n        \"expectedPositiveWeightPhysicalTargets\": total,\n        \"coveredPositiveWeightPhysicalTargets\": covered,\n        \"expectedPositiveWeightLogicalTargets\": len(expected_logical),\n        \"coveredPositiveWeightLogicalTargets\": len(expected_logical & actual_logical),\n        \"missingPositiveWeightPhysicalTargets\": [list(row) for row in missing],\n        \"unexpectedPhysicalTargets\": [list(row) for row in unexpected],\n        \"targetPresenceCoverage\": 1.0\n        if total and not missing and not unexpected\n        else (covered / total if total else 0.0),\n        \"allPositiveWeightTargetsExposed\": bool(total) and not missing and not unexpected,\n        \"exactOnePassCensus\": exact_census,\n        \"scoredOccurrenceMismatches\": occurrence_mismatches,\n        \"windowIndexMismatches\": window_mismatches,\n        \"positiveWeightDenominatorMismatches\": denominator_mismatches,\n        \"repeatedWindowExposureObserved\": repeated,\n        \"tokenOrMaskPositionCoverage\": \"unmeasured\",\n        \"learnedSuccess\": None,\n    }\n"}
2026-11-22T08:54:47.3281556Z FORMATTED_SOURCE_JSON {"path": "tests/test_semantic_v8_target_inventory.py", "content": "\"\"\"Exact positive-loss inventory and optimizer target-presence comparison controls.\"\"\"\n\nfrom copy import deepcopy\n\nimport pytest\n\nfrom megatoken.data.semantic_json import stable_algorithm_hash\nfrom megatoken.training.target_inventory_v8 import (\n    compare_target_inventory,\n    validate_target_inventory,\n)\n\nREGISTRY = \"a\" * 64\nMANIFEST = \"b\" * 64\nCODEC = \"c\" * 64\nTRAINING = \"d\" * 64\nMODEL = \"e\" * 64\n\n\ndef _inventory():\n    sources = {\n        \"source-a\": {\n            \"split\": \"train\",\n            \"logicalTargets\": {\n                \"target-one\": {\n                    \"records\": {\n                        \"record-one\": {\n                            \"windowIndices\": [0, 1],\n                            \"lossDenominators\": {\"language_model\": 8},\n                            \"scoredOccurrences\": 2,\n                        }\n                    }\n                }\n            },\n        }\n    }\n    body = {\n        \"schema\": \"semantic-v8-positive-loss-target-inventory/1\",\n        \"registryDigest\": REGISTRY,\n        \"sourceIds\": [\"source-a\" if index == 0 else f\"train-{index:02d}\" for index in range(48)],\n        \"scoredSourceIds\": [\"source-a\"],\n        \"trainEpisodeCount\": 48,\n        \"windowCount\": 120,\n        \"optimizerWindowCount\": 100,\n        \"phaseMeter\": \"P\",\n        \"phaseBudget\": 200000000,\n        \"onePassMeterCount\": 5000,\n        \"preparedManifestFingerprint\": MANIFEST,\n        \"codecFingerprint\": CODEC,\n        \"trainingConfigDigest\": TRAINING,\n        \"modelConfigDigest\": MODEL,\n        \"windowConfig\": {},\n        \"effectiveLossWeights\": {\"language_model\": 1.0},\n        \"available\": {\"policyTargetRecordCount\": 1, \"lossDenominators\": {\"language_model\": 8}},\n        \"positiveWeight\": {\n            \"sourceCount\": 1,\n            \"logicalTargetCount\": 1,\n            \"physicalTargetRecordCount\": 1,\n            \"scoredOccurrences\": 2,\n            \"lossDenominators\": {\"language_model\": 8},\n        },\n        \"sources\": sources,\n        \"optimizerUpdates\": 0,\n        \"learnedSuccess\": None,\n    }\n    return {**body, \"digest\": stable_algorithm_hash(body)}\n\n\ndef _identities():\n    return {\n        \"registry_digest\": REGISTRY,\n        \"prepared_manifest_fingerprint\": MANIFEST,\n        \"codec_fingerprint\": CODEC,\n        \"training_config_digest\": TRAINING,\n        \"model_config_digest\": MODEL,\n    }\n\n\ndef _actual(*, extra=False):\n    rows = {\n        \"source-a\": {\n            \"split\": \"train\",\n            \"logicalTargets\": {\n                \"target-one\": {\n                    \"records\": {\n                        \"record-one\": {\n                            \"windowIndices\": [0],\n                            \"scoredOccurrences\": 1,\n                        }\n                    }\n                }\n            },\n        }\n    }\n    if extra:\n        rows[\"source-b\"] = {\n            \"split\": \"train\",\n            \"logicalTargets\": {\n                \"unlisted\": {\"records\": {\"forged\": {\"windowIndices\": [0], \"scoredOccurrences\": 1}}}\n            },\n        }\n    return rows\n\n\ndef test_exact_target_presence_passes_without_claiming_position_coverage():\n    result = compare_target_inventory(\n        _inventory(), _actual(), rederived_inventory=_inventory(), **_identities()\n    )\n    assert result[\"allPositiveWeightTargetsExposed\"] is True\n    assert result[\"exactOnePassCensus\"] is False\n    assert result[\"targetPresenceCoverage\"] == 1.0\n    assert result[\"tokenOrMaskPositionCoverage\"] == \"unmeasured\"\n    assert result[\"repeatedWindowExposureObserved\"] is False\n    assert result[\"learnedSuccess\"] is None\n\n\ndef test_missing_inventory_targets_are_reported_without_inflating_coverage():\n    result = compare_target_inventory(\n        _inventory(), {}, rederived_inventory=_inventory(), **_identities()\n    )\n    assert result[\"allPositiveWeightTargetsExposed\"] is False\n    assert result[\"targetPresenceCoverage\"] == 0.0\n    assert result[\"missingPositiveWeightPhysicalTargets\"] == [\n        [\"source-a\", \"target-one\", \"record-one\"]\n    ]\n\n\ndef test_unexpected_optimizer_target_is_integrity_failure():\n    with pytest.raises(ValueError, match=\"outside the rederived inventory\"):\n        compare_target_inventory(\n            _inventory(), _actual(extra=True), rederived_inventory=_inventory(), **_identities()\n        )\n\n\n@pytest.mark.parametrize(\n    \"field\",\n    [\n        \"registryDigest\",\n        \"preparedManifestFingerprint\",\n        \"codecFingerprint\",\n        \"trainingConfigDigest\",\n        \"modelConfigDigest\",\n    ],\n)\ndef test_inventory_bound_to_other_run_identity_is_refused(field):\n    keys = {\n        \"registryDigest\": \"registry_digest\",\n        \"preparedManifestFingerprint\": \"prepared_manifest_fingerprint\",\n        \"codecFingerprint\": \"codec_fingerprint\",\n        \"trainingConfigDigest\": \"training_config_digest\",\n        \"modelConfigDigest\": \"model_config_digest\",\n    }\n    identities = _identities()\n    identities[keys[field]] = \"f\" * 64\n    with pytest.raises(ValueError, match=\"identity\"):\n        validate_target_inventory(_inventory(), rederived_inventory=_inventory(), **identities)\n\n\ndef test_rehashed_forged_target_keys_still_fail_count_invariant():\n    value = deepcopy(_inventory())\n    value[\"sources\"][\"source-a\"][\"logicalTargets\"][\"target-two\"] = {\n        \"records\": {\"record-two\": {\"windowIndices\": [0], \"scoredOccurrences\": 1}}\n    }\n    body = {key: child for key, child in value.items() if key != \"digest\"}\n    value[\"digest\"] = stable_algorithm_hash(body)\n    with pytest.raises(ValueError, match=\"re-derivation\"):\n        validate_target_inventory(value, rederived_inventory=_inventory(), **_identities())\n\n\ndef test_repeated_window_occurrence_is_reported_separately_from_unique_target_coverage():\n    actual = _actual()\n    record = actual[\"source-a\"][\"logicalTargets\"][\"target-one\"][\"records\"][\"record-one\"]\n    record[\"windowIndices\"] = [0]\n    record[\"scoredOccurrences\"] = 2\n    result = compare_target_inventory(\n        _inventory(), actual, rederived_inventory=_inventory(), **_identities()\n    )\n    assert result[\"allPositiveWeightTargetsExposed\"] is True\n    assert result[\"exactOnePassCensus\"] is False\n    assert result[\"repeatedWindowExposureObserved\"] is True\n\n\ndef test_rehashed_inventory_that_disagrees_with_rederived_planner_is_refused():\n    value = _inventory()\n    tampered = deepcopy(value)\n    tampered[\"sources\"][\"source-a\"][\"logicalTargets\"][\"target-one\"][\"records\"][\"record-one\"][\n        \"lossDenominators\"\n    ][\"language_model\"] = 99\n    body = {key: child for key, child in tampered.items() if key != \"digest\"}\n    tampered[\"digest\"] = stable_algorithm_hash(body)\n    with pytest.raises(ValueError, match=\"re-derivation\"):\n        validate_target_inventory(tampered, rederived_inventory=value, **_identities())\n\n\ndef test_inventory_omitting_train_source_or_duplicate_source_id_is_refused():\n    value = _inventory()\n    missing = deepcopy(value)\n    missing[\"sourceIds\"] = missing[\"sourceIds\"][:-1]\n    body = {key: child for key, child in missing.items() if key != \"digest\"}\n    missing[\"digest\"] = stable_algorithm_hash(body)\n    with pytest.raises(ValueError, match=\"identity, count\"):\n        validate_target_inventory(missing, rederived_inventory=missing, **_identities())\n\n    duplicate = deepcopy(value)\n    duplicate[\"sourceIds\"][-1] = duplicate[\"sourceIds\"][0]\n    body = {key: child for key, child in duplicate.items() if key != \"digest\"}\n    duplicate[\"digest\"] = stable_algorithm_hash(body)\n    with pytest.raises(ValueError, match=\"identity, count\"):\n        validate_target_inventory(duplicate, rederived_inventory=duplicate, **_identities())\n\n\ndef test_duplicate_window_ids_in_inventory_are_refused():\n    value = deepcopy(_inventory())\n    record = value[\"sources\"][\"source-a\"][\"logicalTargets\"][\"target-one\"][\"records\"][\"record-one\"]\n    record[\"windowIndices\"] = [0, 0]\n    body = {key: child for key, child in value.items() if key != \"digest\"}\n    value[\"digest\"] = stable_algorithm_hash(body)\n    with pytest.raises(ValueError, match=\"duplicate or invalid window indices\"):\n        validate_target_inventory(value, rederived_inventory=value, **_identities())\n\n\ndef test_exact_occurrence_windows_and_denominators_prove_one_pass_census():\n    actual = _actual()\n    record = actual[\"source-a\"][\"logicalTargets\"][\"target-one\"][\"records\"][\"record-one\"]\n    record.update(\n        windowIndices=[0, 1],\n        scoredOccurrences=2,\n        lossDenominators={\"language_model\": 8},\n    )\n    result = compare_target_inventory(\n        _inventory(),\n        actual,\n        rederived_inventory=_inventory(),\n        **_identities(),\n    )\n    assert result[\"allPositiveWeightTargetsExposed\"] is True\n    assert result[\"exactOnePassCensus\"] is True\n    assert result[\"scoredOccurrenceMismatches\"] == []\n    assert result[\"windowIndexMismatches\"] == []\n    assert result[\"positiveWeightDenominatorMismatches\"] == []\n\n\ndef test_all_keys_can_be_present_while_occurrence_census_still_differs():\n    actual = _actual()\n    record = actual[\"source-a\"][\"logicalTargets\"][\"target-one\"][\"records\"][\"record-one\"]\n    record.update(\n        windowIndices=[0, 1],\n        scoredOccurrences=3,\n        lossDenominators={\"language_model\": 12},\n    )\n    result = compare_target_inventory(\n        _inventory(),\n        actual,\n        rederived_inventory=_inventory(),\n        **_identities(),\n    )\n    assert result[\"allPositiveWeightTargetsExposed\"] is True\n    assert result[\"exactOnePassCensus\"] is False\n    assert result[\"scoredOccurrenceMismatches\"] == [\n        [[\"source-a\", \"target-one\", \"record-one\"], 2, 3]\n    ]\n"}
2026-11-22T08:54:47.3319137Z FORMATTED_SOURCE_JSON {"path": "scripts/qualify_semantic_v8_target_coverage.py", "content": "#!/usr/bin/env python3\n\"\"\"Verify ordinary training exposed every positive-loss V8 target in an inventory.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nfrom pathlib import Path\n\nfrom megatoken.data.semantic_json import stable_algorithm_hash\nfrom megatoken.semantic_lineage_v8 import checkpoint_lineage_v8\nfrom megatoken.training.checkpoint import load_checkpoint\nfrom megatoken.training.semantic_v8 import validate_semantic_v8_target_exposure\nfrom megatoken.training.target_inventory_v8 import compare_target_inventory\n\n\ndef read_json(path: Path):\n    return json.loads(path.read_text())\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--checkpoint\", type=Path, required=True)\n    parser.add_argument(\"--prepared\", type=Path, required=True)\n    parser.add_argument(\"--expected-source-ids\", type=Path, required=True)\n    parser.add_argument(\"--inventory\", type=Path, required=True)\n    parser.add_argument(\"--output\", type=Path, required=True)\n    args = parser.parse_args()\n\n    from qualify_semantic_v8_target_inventory import target_inventory\n\n    checkpoint, metadata = load_checkpoint(args.checkpoint, map_location=\"cpu\")\n    lineage = checkpoint_lineage_v8(checkpoint, metadata)\n    policy = checkpoint[\"train_config\"].get(\"semantic_v8_policy\")\n    if not isinstance(policy, dict):\n        raise ValueError(\"Coverage checkpoint has no explicit V8 policy\")\n    registry_digest = policy[\"registryDigest\"]\n    prepared_manifest = read_json(args.prepared / \"manifest.json\")\n    derived = target_inventory(checkpoint[\"train_config\"], args.expected_source_ids)\n    supplied = read_json(args.inventory)\n    state = validate_semantic_v8_target_exposure(\n        checkpoint.get(\"semantic_v8_target_exposure\"),\n        registry_digest=registry_digest,\n    )\n    comparison = compare_target_inventory(\n        supplied,\n        state[\"sources\"],\n        rederived_inventory=derived,\n        registry_digest=registry_digest,\n        prepared_manifest_fingerprint=prepared_manifest[\"fingerprint\"],\n        codec_fingerprint=prepared_manifest[\"codec_fingerprint\"],\n        training_config_digest=derived[\"trainingConfigDigest\"],\n        model_config_digest=derived[\"modelConfigDigest\"],\n    )\n    if state[\"startingGlobalStep\"] != 0 or state[\"optimizerUpdates\"] != checkpoint[\"global_step\"]:\n        raise ValueError(\"Coverage checkpoint does not retain a fresh complete optimizer census\")\n    if checkpoint[\"global_step\"] != derived[\"optimizerWindowCount\"]:\n        raise ValueError(\n            \"Coverage training stopped before the one-pass optimizer-update bound: \"\n            f\"expected {derived['optimizerWindowCount']}, got {checkpoint['global_step']}\"\n        )\n    if not comparison[\"exactOnePassCensus\"]:\n        raise ValueError(\n            \"Ordinary training differs from the exact one-pass target census: \"\n            f\"{len(comparison['missingPositiveWeightPhysicalTargets'])} missing keys, \"\n            f\"{len(comparison['scoredOccurrenceMismatches'])} occurrence mismatches, \"\n            f\"{len(comparison['windowIndexMismatches'])} window-set mismatches, \"\n            f\"{len(comparison['positiveWeightDenominatorMismatches'])} denominator mismatches\"\n        )\n    body = {\n        \"schema\": \"semantic-v8-ordinary-target-coverage/1\",\n        \"consumerRevision\": policy[\"consumerRevision\"],\n        \"checkpointStateSha256\": metadata[\"state_sha256\"],\n        \"globalStep\": checkpoint[\"global_step\"],\n        \"trainingLineage\": lineage,\n        \"preparedManifestFingerprint\": prepared_manifest[\"fingerprint\"],\n        \"inventory\": {\n            \"digest\": derived[\"digest\"],\n            \"windowCount\": derived[\"windowCount\"],\n            \"optimizerWindowCount\": derived[\"optimizerWindowCount\"],\n            \"phaseMeter\": derived[\"phaseMeter\"],\n            \"phaseBudget\": derived[\"phaseBudget\"],\n            \"onePassMeterCount\": derived[\"onePassMeterCount\"],\n            \"sourceIds\": derived[\"sourceIds\"],\n            \"available\": derived[\"available\"],\n            \"positiveWeight\": derived[\"positiveWeight\"],\n        },\n        \"optimizerTargetExposure\": {\n            \"digest\": state[\"digest\"],\n            \"previousDigest\": state[\"previousDigest\"],\n            \"sourceCount\": len(state[\"sources\"]),\n            \"sources\": state[\"sources\"],\n        },\n        \"comparison\": comparison,\n        \"targetPresenceCoverage\": \"complete: every positive-weight logical/physical target record contributed at least once\",\n        \"tokenOrMaskPositionCoverage\": \"unmeasured\",\n        \"learnedSuccess\": None,\n    }\n    if comparison[\"allPositiveWeightTargetsExposed\"] is not True:\n        raise ValueError(\"Exact one-pass census is missing one or more target keys\")\n    body[\"digest\"] = stable_algorithm_hash(body)\n    args.output.parent.mkdir(parents=True, exist_ok=True)\n    args.output.write_text(json.dumps(body, indent=2, allow_nan=False) + \"\\n\")\n    print(\n        \"V8_TARGET_COVERAGE_EVIDENCE_JSON \"\n        + json.dumps(body, sort_keys=True, separators=(\",\", \":\"))\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}
