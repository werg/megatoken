h.name, temp)\n        finally:\n            os.close(fd)\n        try:\n            os.link(temp, path, follow_symlinks=False)\n        except FileExistsError as exc:\n            raise NativeRequestConflict(\"immutable journal slot already exists\") from exc\n        finally:\n            try:\n                os.unlink(temp)\n            except FileNotFoundError:\n                pass\n        self._sync_directory(path.parent, \"record-publish\")\n        self._after_published(path.name, path)\n\n    def _after_temp_fsync(self, target_name: str, temp_path: Path) -> None:\n        \"\"\"Private fault-injection seam; production implementation has no side effects.\"\"\"\n\n    def _after_published(self, target_name: str, path: Path) -> None:\n        \"\"\"Private fault-injection seam used to model a lost acknowledgement.\"\"\"\n\n    def _request_id(self, scope_id: str, ordinal: int) -> str:\n        return _digest(\n            _canonical(\n                {\"schema\": \"semantic-native-request-slot/1\", \"scope\": scope_id, \"ordinal\": ordinal}\n            )\n        )\n\n    def _check_slot(\n        self,\n        directory: Path,\n        scope_id: str,\n        identity: dict,\n        request: bytes,\n        previous_outcome: str | None,\n    ):\n        ordinal = identity[\"ordinal\"]\n        intent_path, outcome_path = self._paths(directory, ordinal)\n        intent = self._read_record(intent_path, self.max_request_bytes * 2 + 8192)\n        if intent is None:\n            if (\n                os.path.lexists(outcome_path)\n                or self._read_record(outcome_path, self.max_result_bytes * 2 + 8192) is not None\n            ):\n                raise NativeRequestJournalError(\"orphan outcome exists without its intent\")\n            if any(\n                int(match.group(1)) > ordinal\n                for item in directory.iterdir()\n                if (match := re.fullmatch(r\"([0-9]{20})\\.(?:intent|outcome)\\.json\", item.name))\n            ):\n                raise NativeRequestJournalError(\n                    \"missing request slot precedes retained higher ordinal\"\n                )\n            return None, None\n        expected_intent = {\n            \"schema\": _SCHEMA_INTENT,\n            \"request_id\": self._request_id(scope_id, ordinal),\n            \"identity\": identity,\n            \"request_sha256\": _digest(request),\n            \"request_b64\": base64.b64encode(request).decode(\"ascii\"),\n            \"previous_outcome_sha256\": previous_outcome,\n        }\n        if intent != expected_intent:\n            raise NativeRequestConflict(\"request slot identity or exact bytes differ\")\n        outcome = self._read_record(outcome_path, self.max_result_bytes * 2 + 8192)\n        if outcome is None:\n            return intent, None\n        try:\n            result = base64.b64decode(outcome[\"result_b64\"], validate=True)\n        except (KeyError, ValueError, TypeError) as exc:\n            raise NativeRequestJournalError(\"invalid stored outcome bytes\") from exc\n        expected_outcome = {\n            \"schema\": _SCHEMA_OUTCOME,\n            \"request_id\": self._request_id(scope_id, ordinal),\n            \"request_sha256\": _digest(request),\n            \"result_sha256\": _digest(result),\n            \"result_b64\": base64.b64encode(result).decode(\"ascii\"),\n        }\n        if outcome != expected_outcome or len(result) > self.max_result_bytes:\n            raise NativeRequestJournalError(\"stored outcome integrity failure\")\n        return intent, result\n\n    def _scan_prior(self, directory: Path, scope_id: str, identity: dict) -> tuple[str | None, int]:\n        previous = None\n        highest = 0\n        for ordinal in range(1, identity[\"ordinal\"]):\n            intent_path, outcome_path = self._paths(directory, ordinal)\n            if not os.path.lexists(intent_path):\n                for item in directory.iterdir():\n                    match = re.fullmatch(r\"([0-9]{20})\\.(?:intent|outcome)\\.json\", item.name)\n                    if match and int(match.group(1)) > ordinal:\n                        raise NativeRequestJournalError(\n                            \"missing request intent precedes retained later records\"\n                        )\n                break\n            intent = self._read_record(intent_path, self.max_request_bytes * 2 + 8192)\n            if (\n                not isinstance(intent, dict)\n                or set(intent)\n                != {\n                    \"schema\",\n                    \"request_id\",\n                    \"identity\",\n                    \"request_sha256\",\n                    \"request_b64\",\n                    \"previous_outcome_sha256\",\n                }\n                or intent.get(\"schema\") != _SCHEMA_INTENT\n                or intent.get(\"request_id\") != self._request_id(scope_id, ordinal)\n            ):\n                raise NativeRequestJournalError(\"corrupt prior request intent\")\n            prior_identity = _validate_identity(intent[\"identity\"])\n            if (\n                prior_identity[\"ordinal\"] != ordinal\n                or any(prior_identity[key] != identity[key] for key in _SCOPE_KEYS)\n                or intent.get(\"previous_outcome_sha256\") != previous\n            ):\n                raise NativeRequestJournalError(\"broken request history link\")\n            if prior_identity[\"model_identity\"] != identity[\"model_identity\"]:\n                raise NativeRequestConflict(\"model identity changed within session generation\")\n            try:\n                prior_request = base64.b64decode(intent[\"request_b64\"], validate=True)\n            except (ValueError, TypeError) as exc:\n                raise NativeRequestJournalError(\"invalid prior request bytes\") from exc\n            if (\n                len(prior_request) > self.max_request_bytes\n                or intent.get(\"request_b64\") != base64.b64encode(prior_request).decode(\"ascii\")\n                or intent.get(\"request_sha256\") != _digest(prior_request)\n            ):\n                raise NativeRequestJournalError(\"prior request integrity failure\")\n            outcome = self._read_record(outcome_path, self.max_result_bytes * 2 + 8192)\n            if outcome is None:\n                raise NativeRequestOutcomeUnknown(\"earlier request outcome is unknown\")\n            try:\n                result = base64.b64decode(outcome[\"result_b64\"], validate=True)\n            except (KeyError, ValueError, TypeError) as exc:\n                raise NativeRequestJournalError(\"invalid prior outcome\") from exc\n            if (\n                not isinstance(outcome, dict)\n                or set(outcome)\n                != {\"schema\", \"request_id\", \"request_sha256\", \"result_sha256\", \"result_b64\"}\n                or outcome.get(\"result_b64\") != base64.b64encode(result).decode(\"ascii\")\n                or outcome.get(\"request_id\") != self._request_id(scope_id, ordinal)\n                or outcome.get(\"request_sha256\") != intent.get(\"request_sha256\")\n                or outcome.get(\"result_sha256\") != _digest(result)\n                or outcome.get(\"schema\") != _SCHEMA_OUTCOME\n                or len(result) > self.max_result_bytes\n            ):\n                raise NativeRequestJournalError(\"prior outcome integrity failure\")\n            previous = _digest(_canonical(outcome))\n            highest = ordinal\n        return previous, highest\n\n    def execute(\n        self, identity: dict, request_bytes: bytes, callback: Callable[[bytes], bytes]\n    ) -> bytes:\n        identity = _validate_identity(identity)\n        if not isinstance(request_bytes, bytes) or len(request_bytes) > self.max_request_bytes:\n            raise NativeRequestJournalError(\"request must be bounded exact bytes\")\n        if not callable(callback):\n            raise TypeError(\"callback must be callable\")\n        with self._locked(identity) as (directory, scope_id):\n            previous, highest = self._scan_prior(directory, scope_id, identity)\n            ordinal = identity[\"ordinal\"]\n            if ordinal > self.max_requests:\n                raise NativeRequestJournalError(\"request count limit exceeded\")\n            if ordinal > highest + 1:\n                raise NativeRequestConflict(\"request ordinal is not the next slot\")\n            intent, result = self._check_slot(\n                directory, scope_id, identity, request_bytes, previous\n            )\n            if intent is not None:\n                if result is None:\n                    raise NativeRequestOutcomeUnknown(\"admitted request has no durable outcome\")\n                return result\n            if ordinal != highest + 1:\n                raise NativeRequestConflict(\"request ordinal is not the next slot\")\n            if (\n                self._used_bytes(directory)\n                + len(\n                    _canonical(\n                        {\n                            \"schema\": _SCHEMA_INTENT,\n                            \"request_id\": self._request_id(scope_id, ordinal),\n                            \"identity\": identity,\n                            \"request_sha256\": _digest(request_bytes),\n                            \"request_b64\": base64.b64encode(request_bytes).decode(\"ascii\"),\n                            \"previous_outcome_sha256\": previous,\n                        }\n                    )\n                )\n                > self.max_log_bytes\n            ):\n                raise NativeRequestJournalError(\"journal scope byte limit exceeded\")\n            intent_path, _ = self._paths(directory, ordinal)\n            record = {\n                \"schema\": _SCHEMA_INTENT,\n                \"request_id\": self._request_id(scope_id, ordinal),\n                \"identity\": identity,\n                \"request_sha256\": _digest(request_bytes),\n                \"request_b64\": base64.b64encode(request_bytes).decode(\"ascii\"),\n                \"previous_outcome_sha256\": previous,\n            }\n            self._publish(intent_path, record, self.max_request_bytes * 2 + 8192)\n            # The callback can run only after intent publication and directory fsync.\n            result_bytes = callback(request_bytes)\n            if not isinstance(result_bytes, bytes) or len(result_bytes) > self.max_result_bytes:\n                raise NativeRequestJournalError(\"callback must return bounded exact bytes\")\n            _, outcome_path = self._paths(directory, ordinal)\n            outcome_record = {\n                \"schema\": _SCHEMA_OUTCOME,\n                \"request_id\": self._request_id(scope_id, ordinal),\n                \"request_sha256\": _digest(request_bytes),\n                \"result_sha256\": _digest(result_bytes),\n                \"result_b64\": base64.b64encode(result_bytes).decode(\"ascii\"),\n            }\n            if self._used_bytes(directory) + len(_canonical(outcome_record)) > self.max_log_bytes:\n                raise NativeRequestJournalError(\"journal scope byte limit exceeded\")\n            self._publish(outcome_path, outcome_record, self.max_result_bytes * 2 + 8192)\n            return result_bytes\n\n    def inspect(self, identity: dict, request_bytes: bytes) -> dict:\n        identity = _validate_identity(identity)\n        if not isinstance(request_bytes, bytes) or len(request_bytes) > self.max_request_bytes:\n            raise NativeRequestJournalError(\"request must be bounded exact bytes\")\n        with self._locked(identity) as (directory, scope_id):\n            previous, highest = self._scan_prior(directory, scope_id, identity)\n            ordinal = identity[\"ordinal\"]\n            intent, result = self._check_slot(\n                directory, scope_id, identity, request_bytes, previous\n            )\n            if intent is None:\n                if ordinal <= highest:\n                    raise NativeRequestJournalError(\"missing request slot in retained history\")\n                return {\n                    \"status\": \"never-admitted\",\n                    \"request_id\": self._request_id(scope_id, ordinal),\n                }\n            if result is None:\n                return {\"status\": \"unknown\", \"request_id\": self._request_id(scope_id, ordinal)}\n            _, outcome_path = self._paths(directory, ordinal)\n            outcome = self._read_record(outcome_path, self.max_result_bytes * 2 + 8192)\n            return {\n                \"status\": \"completed\",\n                \"request_id\": self._request_id(scope_id, ordinal),\n                \"result_bytes\": result,\n                \"outcome_sha256\": _digest(_canonical(outcome)),\n            }\n"}
2026-11-22T08:40:30.4622532Z FORMATTED_SOURCE_JSON {"path": "tests/test_semantic_request_journal_v8.py", "content": "from __future__ import annotations\n\nimport os\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\nfrom megatoken.semantic_request_journal_v8 import (\n    DurableNativeRequestJournal,\n    NativeRequestConflict,\n    NativeRequestJournalError,\n    NativeRequestOutcomeUnknown,\n)\n\nFIXTURE = Path(__file__).parent / \"fixtures\" / \"semantic_request_journal_worker_v8.py\"\n\n\ndef identity(ordinal=1, **changes):\n    value = {\n        \"schema\": \"semantic-native-request-identity/1\",\n        \"session_id\": \"session-a\",\n        \"stream_id\": \"stream-a\",\n        \"session_generation\": 1,\n        \"ordinal\": ordinal,\n        \"operation\": \"generate\",\n        \"model_identity\": {\"checkpoint\": \"a\" * 64, \"tokenizer\": \"b\" * 64},\n    }\n    value.update(changes)\n    return value\n\n\ndef run_worker(root, mode, **env):\n    child_env = dict(\n        os.environ,\n        PYTHONPATH=str(Path(__file__).resolve().parents[1] / \"src\"),\n        JOURNAL_ROOT=str(root),\n        JOURNAL_MODE=mode,\n        **env,\n    )\n    return subprocess.run(\n        [sys.executable, str(FIXTURE)], env=child_env, capture_output=True, text=True, timeout=15\n    )\n\n\ndef test_exact_result_persisted_and_same_slot_is_idempotent(tmp_path):\n    journal = DurableNativeRequestJournal(tmp_path / \"journal\")\n    calls = []\n    request = b'{\"op\":\"generate\",\"prompt\":\"x\"}'\n    result = journal.execute(\n        identity(), request, lambda data: calls.append(data) or b'{\"tokens\":[1]}'\n    )\n    assert result == b'{\"tokens\":[1]}'\n    inspected = journal.inspect(identity(), request)\n    assert inspected[\"status\"] == \"completed\"\n    assert inspected[\"result_bytes\"] == result\n    assert len(inspected[\"request_id\"]) == 64\n    assert len(inspected[\"outcome_sha256\"]) == 64\n    assert (\n        journal.execute(identity(), request, lambda _: pytest.fail(\"callback repeated\")) == result\n    )\n    assert calls == [request]\n\n\ndef test_payload_operation_and_model_substitution_conflict(tmp_path):\n    journal = DurableNativeRequestJournal(tmp_path / \"journal\")\n    request = b\"same\"\n    journal.execute(identity(), request, lambda _: b\"ok\")\n    with pytest.raises(NativeRequestConflict):\n        journal.execute(identity(), b\"changed\", lambda _: b\"bad\")\n    with pytest.raises(NativeRequestConflict):\n        journal.execute(identity(operation=\"score\"), request, lambda _: b\"bad\")\n    with pytest.raises(NativeRequestConflict):\n        journal.execute(\n            identity(model_identity={\"checkpoint\": \"c\" * 64, \"tokenizer\": \"b\" * 64}),\n            request,\n            lambda _: b\"bad\",\n        )\n\n\ndef test_ordinals_are_contiguous_and_scopes_are_separate(tmp_path):\n    journal = DurableNativeRequestJournal(tmp_path / \"journal\")\n    with pytest.raises(NativeRequestConflict):\n        journal.execute(identity(2), b\"later\", lambda _: b\"bad\")\n    journal.execute(identity(), b\"first\", lambda _: b\"one\")\n    journal.execute(identity(2), b\"second\", lambda _: b\"two\")\n    other = identity(session_generation=2)\n    assert journal.execute(other, b\"first\", lambda _: b\"new\") == b\"new\"\n\n\ndef test_crash_before_intent_publication_is_never_admitted(tmp_path):\n    child = run_worker(tmp_path / \"journal\", \"before-admission\")\n    assert child.returncode == 70\n    journal = DurableNativeRequestJournal(tmp_path / \"journal\")\n    request = b\"request\"\n    scope = next((tmp_path / \"journal\").iterdir())\n    assert any(item.name.startswith(\".tmp-\") for item in scope.iterdir())\n    assert journal.inspect(identity(), request)[\"status\"] == \"never-admitted\"\n    assert not any(item.name.startswith(\".tmp-\") for item in scope.iterdir())\n    assert journal.execute(identity(), request, lambda _: b\"result\") == b\"result\"\n\n\ndef test_crash_after_intent_leaves_unknown_and_never_reexecutes(tmp_path):\n    child = run_worker(tmp_path / \"journal\", \"after-admission\")\n    assert child.returncode == 71\n    journal = DurableNativeRequestJournal(tmp_path / \"journal\")\n    request = b\"request\"\n    assert journal.inspect(identity(), request)[\"status\"] == \"unknown\"\n    with pytest.raises(NativeRequestOutcomeUnknown):\n        journal.execute(identity(), request, lambda _: pytest.fail(\"unknown request redispatched\"))\n\n\ndef test_crash_after_outcome_publication_is_readable_without_callback(tmp_path):\n    child = run_worker(tmp_path / \"journal\", \"after-outcome\")\n    assert child.returncode == 72\n    journal = DurableNativeRequestJournal(tmp_path / \"journal\")\n    request = b\"request\"\n    result = journal.inspect(identity(), request)\n    assert result[\"status\"] == \"completed\"\n    assert result[\"result_bytes\"] == b\"response\"\n    assert (\n        journal.execute(\n            identity(), request, lambda _: pytest.fail(\"completed request redispatched\")\n        )\n        == b\"response\"\n    )\n\n\ndef test_live_second_process_cannot_enter_same_scope(tmp_path):\n    first = subprocess.Popen(\n        [sys.executable, str(FIXTURE)],\n        env=dict(\n            os.environ,\n            PYTHONPATH=str(Path(__file__).resolve().parents[1] / \"src\"),\n            JOURNAL_ROOT=str(tmp_path / \"journal\"),\n            JOURNAL_MODE=\"hold\",\n        ),\n        stdin=subprocess.PIPE,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n        text=True,\n    )\n    try:\n        assert first.stdout.readline().strip() == \"ADMITTED\"\n        second = run_worker(tmp_path / \"journal\", \"contend\")\n        assert second.returncode == 73\n        first.stdin.write(\"continue\\n\")\n        first.stdin.flush()\n        assert first.stdout.readline().strip() == \"RESULT:response\"\n        assert first.wait(timeout=10) == 0\n    finally:\n        if first.poll() is None:\n            first.kill()\n            first.wait(timeout=10)\n\n\ndef test_model_identity_is_frozen_for_session_generation(tmp_path):\n    journal = DurableNativeRequestJournal(tmp_path / \"journal\")\n    journal.execute(identity(), b\"one\", lambda _: b\"one-result\")\n    with pytest.raises(NativeRequestConflict):\n        journal.execute(\n            identity(2, model_identity={\"checkpoint\": \"c\" * 64, \"tokenizer\": \"b\" * 64}),\n            b\"two\",\n            lambda _: b\"wrong\",\n        )\n\n\ndef test_scope_creation_sync_failure_prevents_callback(tmp_path):\n    class FailScopeDirectorySync(DurableNativeRequestJournal):\n        def _after_directory_fsync(self, path, reason):\n            if reason == \"mkdir-self\" and path.parent == self.root:\n                raise OSError(\"injected scope directory sync failure\")\n\n    journal = FailScopeDirectorySync(tmp_path / \"journal\")\n    calls = []\n    with pytest.raises(NativeRequestJournalError):\n        journal.execute(identity(), b\"request\", lambda _: calls.append(\"called\") or b\"result\")\n    assert calls == []\n\n\ndef test_lost_outcome_publication_ack_is_recovered_only_after_fresh_sync(tmp_path):\n    class LoseOutcomeAck(DurableNativeRequestJournal):\n        publications = 0\n\n        def _after_directory_fsync(self, path, reason):\n            if reason == \"record-publish\":\n                self.publications += 1\n                if self.publications == 2:\n                    raise OSError(\"injected outcome publication acknowledgement loss\")\n\n    journal = LoseOutcomeAck(tmp_path / \"journal\")\n    with pytest.raises(OSError):\n        journal.execute(identity(), b\"request\", lambda _: b\"response\")\n    fresh = DurableNativeRequestJournal(tmp_path / \"journal\")\n    observed = fresh.inspect(identity(), b\"request\")\n    assert observed[\"status\"] == \"completed\"\n    assert observed[\"result_bytes\"] == b\"response\"\n\n\ndef test_readback_sync_failure_is_not_reported_as_completed(tmp_path):\n    path = tmp_path / \"journal\"\n    DurableNativeRequestJournal(path).execute(identity(), b\"request\", lambda _: b\"response\")\n\n    class FailReadSync(DurableNativeRequestJournal):\n        def _after_directory_fsync(self, directory, reason):\n            if reason == \"record-read\":\n                raise OSError(\"injected readback sync failure\")\n\n    with pytest.raises(OSError):\n        FailReadSync(path).inspect(identity(), b\"request\")\n\n\ndef test_orphan_outcome_and_missing_lower_slot_refuse(tmp_path):\n    journal = DurableNativeRequestJournal(tmp_path / \"journal\")\n    scope, _ = journal._scope(identity())\n    _, orphan = journal._paths(scope, 1)\n    orphan.write_bytes(b\"{}\")\n    orphan.chmod(0o600)\n    with pytest.raises(NativeRequestJournalError, match=\"orphan outcome\"):\n        journal.execute(identity(), b\"request\", lambda _: pytest.fail(\"orphan dispatched\"))\n\n    orphan.unlink()\n    journal.execute(identity(), b\"first\", lambda _: b\"done\")\n    journal.execute(identity(2), b\"second\", lambda _: b\"done\")\n    intent, _ = journal._paths(scope, 1)\n    intent.unlink()\n    with pytest.raises(NativeRequestJournalError, match=\"missing request intent\"):\n        journal.inspect(identity(3), b\"third\")\n"}
2026-11-22T08:40:30.4649414Z FORMATTED_SOURCE_JSON {"path": "tests/fixtures/semantic_request_journal_worker_v8.py", "content": "from __future__ import annotations\n\nimport os\nimport sys\nfrom pathlib import Path\n\nfrom megatoken.semantic_request_journal_v8 import (\n    DurableNativeRequestJournal,\n    NativeRequestBusy,\n)\n\nROOT = Path(os.environ[\"JOURNAL_ROOT\"])\nMODE = os.environ[\"JOURNAL_MODE\"]\nIDENTITY = {\n    \"schema\": \"semantic-native-request-identity/1\",\n    \"session_id\": \"session-a\",\n    \"stream_id\": \"stream-a\",\n    \"session_generation\": 1,\n    \"ordinal\": 1,\n    \"operation\": \"generate\",\n    \"model_identity\": {\"checkpoint\": \"a\" * 64, \"tokenizer\": \"b\" * 64},\n}\nREQUEST = b\"request\"\n\n\nclass CrashingJournal(DurableNativeRequestJournal):\n    def _after_temp_fsync(self, target_name, temp_path):\n        if MODE == \"before-admission\" and target_name.endswith(\".intent.json\"):\n            os._exit(70)\n\n    def _after_published(self, target_name, path):\n        if MODE == \"after-outcome\" and target_name.endswith(\".outcome.json\"):\n            os._exit(72)\n\n\njournal = CrashingJournal(ROOT)\nif MODE == \"after-admission\":\n    journal.execute(IDENTITY, REQUEST, lambda _: os._exit(71))\nelif MODE == \"after-outcome\":\n    journal.execute(IDENTITY, REQUEST, lambda _: b\"response\")\nelif MODE == \"before-admission\":\n    journal.execute(IDENTITY, REQUEST, lambda _: b\"must-not-run\")\nelif MODE == \"hold\":\n\n    def wait_for_release(_):\n        print(\"ADMITTED\", flush=True)\n        sys.stdin.readline()\n        return b\"response\"\n\n    result = journal.execute(IDENTITY, REQUEST, wait_for_release)\n    print(\"RESULT:\" + result.decode(\"ascii\"), flush=True)\nelif MODE == \"contend\":\n    try:\n        journal.execute(IDENTITY, REQUEST, lambda _: b\"wrong\")\n    except NativeRequestBusy:\n        raise SystemExit(73)\n    raise SystemExit(74)\nelse:\n    raise SystemExit(\"unknown test mode\")\n"}
2026-11-22T08:40:30.5549025Z FORMATTED_SOURCE_JSON {"path": "scripts/qualify_semantic_v8_target_inventory.py", "content": "#!/usr/bin/env python3\n\"\"\"Inventory positive-weight V8 target windows from the ordinary native planner.\n\nThis is a read-only preflight: it prepares the exact train windows and native\nloss plans, but does not execute backward or change model weights.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nfrom dataclasses import asdict\nfrom pathlib import Path\n\nfrom megatoken.data import PreparedCorpus, iter_windows\nfrom megatoken.data.semantic_json import stable_algorithm_hash\nfrom megatoken.loading import build_model, load_model_config\nfrom megatoken.training.config import TrainConfig\nfrom megatoken.training.engine import prepare_batches, window_config\nfrom megatoken.training.semantic_v8 import (\n    load_semantic_v8_codec,\n    merge_semantic_v8_target_exposures,\n    preflight_semantic_training_v8,\n    semantic_v8_target_exposure_from_batches,\n    semantic_v8_target_step_summary,\n)\nfrom megatoken.training.stream import EpisodeWindow\n\n\ndef require(condition: bool, message: str) -> None:\n    if not condition:\n        raise ValueError(message)\n\n\ndef read_json(path: Path):\n    return json.loads(path.read_text())\n\n\ndef target_inventory(config_source, expected_source_ids_source=None):\n    config_raw = (\n        read_json(config_source) if isinstance(config_source, (str, Path)) else config_source\n    )\n    config = TrainConfig.from_dict(config_raw)\n    config_identity = asdict(config)\n    for non_objective in (\n        \"output\",\n        \"max_steps\",\n        \"checkpoint_every\",\n        \"keep_checkpoints\",\n        \"log_every\",\n        \"device\",\n    ):\n        config_identity.pop(non_objective, None)\n    require(config.semantic_v8_policy is not None, \"Inventory requires an explicit V8 policy\")\n    require(\n        config.use_stage_mixture is False,\n        \"Inventory currently requires the exact flat V8 support stream\",\n    )\n    require(\n        len(config.datasets) == 1,\n        \"Inventory requires one immutable prepared support root\",\n    )\n\n    overrides = {\n        **config.model_overrides,\n        \"expert_backend\": config.expert_backend,\n        \"checkpoint_stages\": config.gradient_checkpointing,\n    }\n    model_config = load_model_config(config.model, **overrides)\n    codec = load_semantic_v8_codec(config.codec, vocab_size=model_config.vocab_size)\n    require(\n        config.generated_capacity <= model_config.max_capacity,\n        \"Configured generated capacity exceeds model\",\n    )\n    supply = preflight_semantic_training_v8(\n        config.datasets,\n        codec=codec,\n        policy=config.semantic_v8_policy,\n        max_history=model_config.max_history_chunks,\n        max_positions=model_config.max_capacity,\n    )\n    registry_digest = config.semantic_v8_policy[\"registryDigest\"]\n    require(\n        supply[\"registryDigest\"] == registry_digest,\n        \"Prepared support registry differs from policy\",\n    )\n\n    prepared_root = Path(config.datasets[0]).resolve()\n    manifest = read_json(prepared_root / \"manifest.json\")\n    registry = read_json(prepared_root / \"semantic-v8-families.json\")\n    require(\n        registry.get(\"digest\") == registry_digest,\n        \"Prepared registry digest differs from V8 policy\",\n    )\n    registry_ids = {row[\"id\"] for row in registry[\"sources\"]}\n    if expected_source_ids_source is not None:\n        inventory = (\n            read_json(expected_source_ids_source)\n            if isinstance(expected_source_ids_source, (str, Path))\n            else {\n                \"sourceIds\": list(expected_source_ids_source),\n                \"schema\": \"semantic-v8-source-population/1\",\n                \"registryDigest\": registry_digest,\n            }\n        )\n        expected_ids = inventory.get(\"sourceIds\")\n        require(\n            inventory.get(\"schema\") == \"semantic-v8-source-population/1\"\n            and inventory.get(\"registryDigest\") == registry_digest\n            and isinstance(expected_ids, list)\n            and len(expected_ids) == 64\n            and len(set(expected_ids)) == 64\n            and set(expected_ids) == registry_ids,\n            \"Support source inventory is invalid or differs from the prepared registry\",\n        )\n    else:\n        expected_ids = sorted(registry_ids)\n    expected_ids = set(expected_ids)\n    split_by_id = {}\n    for component in registry[\"components\"]:\n        for source_id in component[\"sourceIds\"]:\n            require(\n                source_id not in split_by_id,\n                \"Prepared registry assigns a source to multiple splits\",\n            )\n            split_by_id[source_id] = component[\"split\"]\n    expected_train_ids = {source_id for source_id, split in split_by_id.items() if split == \"train\"}\n    split_counts = {\n        split: sum(value == split for value in split_by_id.values())\n        for split in (\"train\", \"validation\", \"test\")\n    }\n    require(\n        len(expected_ids) == 64\n        and split_counts == {\"train\": 48, \"validation\": 12, \"test\": 4}\n        and set(split_by_id) == expected_ids,\n        \"Inventory requires the exact 64-source, 48/12/4 registry\",\n    )\n\n    model = build_model(\n        model_config,\n        codec,\n        device=\"cpu\",\n        precision=config.precision,\n        packs=config.packs,\n    )\n    effective_weights = dict(config.loss_weights)\n    effective_weights[\"router_balance\"] = 0.0\n    windows_config = window_config(config)\n    exposures = []\n    observed_sources = set()\n    observed_windows = set()\n    available_records = set()\n    available_denominators = {}\n    train_episode_count = 0\n    with PreparedCorpus(config.datasets, split=\"train\") as corpus:\n        require(\n            corpus.codec_fingerprint == codec.fingerprint,\n            \"Prepared corpus tokenizer differs\",\n        )\n        require(\n            len(corpus) == len(expected_train_ids),\n            \"Prepared training episode count differs from the frozen source split\",\n        )\n        for index in range(len(corpus)):\n            episode, assets = corpus.fetch(index)\n            source_id = episode.lineage.source_id\n            require(\n                source_id in expected_train_ids,\n                \"Prepared training episode is outside the frozen train source inventory\",\n            )\n            require(\n                source_id not in observed_sources,\n                \"Prepared support has a duplicate training source\",\n            )\n            require(\n                episode.lineage.frozen_split == \"train\",\n                \"Inventory enumerated a nontraining episode\",\n            )\n            observed_sources.add(source_id)\n            train_episode_count += 1\n            for window in iter_windows(episode, codec, windows_config):\n                window_key = (source_id, window.index)\n                require(\n                    window_key not in observed_windows,\n                    \"Native window iterator duplicated a window\",\n                )\n                observed_windows.add(window_key)\n                item = EpisodeWindow(episode=episode, window=window, assets=assets)\n                batches = prepare_batches(model, [item], config)\n                for batch in batches:\n                    for step in batch.steps:\n                        for encoded, plan in zip(step.records, step.plans, strict=True):\n                            record = encoded.record\n                            if not record.policy_mask:\n                                continue\n                            available_records.add((source_id, record.logical_id, record.record_id))\n                            for name, count in plan.denominators.items():\n                                if count:\n                                    available_denominators[name] = (\n                                        available_denominators.get(name, 0) + count\n                                    )\n                exposures.append(\n                    semantic_v8_target_exposure_from_batches(\n                        batches,\n                        registry_digest=registry_digest,\n                        effective_loss_weights=effective_weights,\n                    )\n                )\n    require(\n        observed_sources == expected_train_ids,\n        \"Prepared support omitted or substituted a frozen training source\",\n    )\n    require(observed_windows, \"Prepared support has no train windows\")\n\n    merged = merge_semantic_v8_target_exposures(exposures, registry_digest=registry_digest)\n    scored_sources = merged[\"sources\"]\n    positive_weight = semantic_v8_target_step_summary(merged)\n    body = {\n        \"schema\": \"semantic-v8-positive-loss-target-inventory/1\",\n        \"registryDigest\": registry_digest,\n        \"sourceIds\": sorted(expected_train_ids),\n        \"scoredSourceIds\": sorted(scored_sources),\n        \"trainEpisodeCount\": train_episode_count,\n        \"windowCount\": len(observed_windows),\n        \"preparedManifestFingerprint\": manifest[\"fingerprint\"],\n        \"codecFingerprint\": codec.fingerprint,\n        \"trainingConfigDigest\": stable_algorithm_hash(config_identity),\n        \"modelConfigDigest\": stable_algorithm_hash(model_config.to_dict()),\n        \"windowConfig\": asdict(windows_config),\n        \"effectiveLossWeights\": effective_weights,\n        \"available\": {\n            \"policyTargetRecordCount\": len(available_records),\n            \"lossDenominators\": dict(sorted(available_denominators.items())),\n        },\n        \"positiveWeight\": {\n            key: positive_weight[key]\n            for key in (\n                \"sourceCount\",\n                \"logicalTargetCount\",\n                \"physicalTargetRecordCount\",\n                \"scoredOccurrences\",\n                \"lossDenominators\",\n            )\n        },\n        \"sources\": scored_sources,\n        \"optimizerUpdates\": 0,\n        \"learnedSuccess\": None,\n    }\n    return {**body, \"digest\": stable_algorithm_hash(body)}\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--config\", type=Path, required=True)\n    parser.add_argument(\"--expected-source-ids\", type=Path)\n    parser.add_argument(\"--output\", type=Path, required=True)\n    args = parser.parse_args()\n    result = target_inventory(args.config, args.expected_source_ids)\n    args.output.parent.mkdir(parents=True, exist_ok=True)\n    args.output.write_text(json.dumps(result, indent=2, allow_nan=False) + \"\\n\")\n    print(\n        json.dumps(\n            {\n                \"output\": str(args.output.resolve()),\n                \"digest\": result[\"digest\"],\n                \"registryDigest\": result[\"registryDigest\"],\n                \"sourceCount\": result[\"positiveWeight\"][\"sourceCount\"],\n                \"windowCount\": result[\"windowCount\"],\n                \"logicalTargetCount\": result[\"positiveWeight\"][\"logicalTargetCount\"],\n                \"physicalTargetRecordCount\": result[\"positiveWeight\"][\"physicalTargetRecordCount\"],\n                \"scoredOccurrences\": result[\"positiveWeight\"][\"scoredOccurrences\"],\n                \"lossDenominators\": result[\"positiveWeight\"][\"lossDenominators\"],\n                \"optimizerUpdates\": 0,\n                \"learnedSuccess\": None,\n            },\n            sort_keys=True,\n        )\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}
2026-11-22T08:40:30.5598135Z FORMATTED_SOURCE_JSON {"path": "src/megatoken/training/target_inventory_v8.py", "content": "\"\"\"Bounded comparison for positive-loss target inventory and optimizer census.\"\"\"\n\nfrom __future__ import annotations\n\nfrom megatoken.data.semantic_json import stable_algorithm_hash\n\n\ndef validate_target_inventory(\n    inventory,\n    *,\n    rederived_inventory,\n    registry_digest,\n    prepared_manifest_fingerprint,\n    codec_fingerprint,\n    training_config_digest,\n    model_config_digest,\n):\n    required = {\n        \"schema\",\n        \"registryDigest\",\n        \"sourceIds\",\n        \"scoredSourceIds\",\n        \"trainEpisodeCount\",\n        \"windowCount\",\n        \"preparedManifestFingerprint\",\n        \"codecFingerprint\",\n        \"trainingConfigDigest\",\n        \"modelConfigDigest\",\n        \"windowConfig\",\n        \"effectiveLossWeights\",\n        \"available\",\n        \"positiveWeight\",\n        \"sources\",\n        \"optimizerUpdates\",\n        \"learnedSuccess\",\n        \"digest\",\n    }\n    if not isinstance(inventory, dict) or set(inventory) != required:\n        raise ValueError(\"V8 target inventory has an invalid field set\")\n    if not isinstance(rederived_inventory, dict) or inventory != rederived_inventory:\n        raise ValueError(\"V8 target inventory differs from exact native planner re-derivation\")\n    body = {key: value for key, value in inventory.items() if key != \"digest\"}\n    if (\n        inventory[\"schema\"] != \"semantic-v8-positive-loss-target-inventory/1\"\n        or inventory[\"registryDigest\"] != registry_digest\n        or inventory[\"preparedManifestFingerprint\"] != prepared_manifest_fingerprint\n        or inventory[\"codecFingerprint\"] != codec_fingerprint\n        or inventory[\"trainingConfigDigest\"] != training_config_digest\n        or inventory[\"modelConfigDigest\"] != model_config_digest\n        or inventory[\"digest\"] != stable_algorithm_hash(body)\n        or inventory[\"optimizerUpdates\"] != 0\n        or inventory[\"learnedSuccess\"] is not None\n        or type(inventory[\"windowCount\"]) is not int\n        or inventory[\"windowCount\"] < 1\n        or type(inventory[\"trainEpisodeCount\"]) is not int\n        or inventory[\"trainEpisodeCount\"] != len(inventory[\"sourceIds\"])\n        or len(inventory[\"sourceIds\"]) != 48\n        or len(set(inventory[\"sourceIds\"])) != 48\n        or inventory[\"sourceIds\"] != sorted(inventory[\"sourceIds\"])\n        or inventory[\"scoredSourceIds\"] != sorted(inventory[\"sources\"])\n        or not set(inventory[\"scoredSourceIds\"]) <= set(inventory[\"sourceIds\"])\n    ):\n        raise ValueError(\"V8 target inventory identity, count or seal is invalid\")\n    if (\n        not isinstance(inventory[\"sourceIds\"], list)\n        or any(not isinstance(item, str) or not item for item in inventory[\"sourceIds\"])\n        or not isinstance(inventory[\"scoredSourceIds\"], list)\n        or len(set(inventory[\"scoredSourceIds\"])) != len(inventory[\"scoredSourceIds\"])\n    ):\n        raise ValueError(\"V8 target inventory source IDs are malformed or duplicated\")\n    expected = inventory[\"positiveWeight\"]\n    expected_keys = {\n        (source_id, logical_id, record_id)\n        for source_id, source in inventory[\"sources\"].items()\n        for logical_id, target in source[\"logicalTargets\"].items()\n        for record_id in target[\"records\"]\n    }\n    if (\n        any(source.get(\"split\") != \"train\" for source in inventory[\"sources\"].values())\n        or any(\n            not isinstance(record.get(\"windowIndices\"), list)\n            or record[\"windowIndices\"] != sorted(set(record[\"windowIndices\"]))\n            or any(type(index) is not int or index < 0 for index in record[\"windowIndices\"])\n            for source in inventory[\"sources\"].values()\n            for target in source[\"logicalTargets\"].values()\n            for record in target[\"records\"].values()\n        )\n        or not isinstance(expected, dict)\n        or expected.get(\"sourceCount\") != len(inventory[\"sources\"])\n        or expected.get(\"logicalTargetCount\")\n        != len(\n            {\n                (source_id, logical_id)\n                for source_id, source in inventory[\"sources\"].items()\n                for logical_id in source[\"logicalTargets\"]\n            }\n        )\n        or expected.get(\"physicalTargetRecordCount\") != len(expected_keys)\n    ):\n        raise ValueError(\"V8 positive-loss target inventory summary differs from its keys\")\n    return expected_keys\n\n\ndef compare_target_inventory(inventory, actual_sources, *, rederived_inventory, **identities):\n    \"\"\"Compare target presence only; token/position-level coverage is not retained.\"\"\"\n    expected_keys = validate_target_inventory(\n        inventory, rederived_inventory=rederived_inventory, **identities\n    )\n    if not isinstance(actual_sources, dict):\n        raise ValueError(\"Optimizer target exposure has no source map\")\n    actual_keys = {\n        (source_id, logical_id, record_id)\n        for source_id, source in actual_sources.items()\n        for logical_id, target in source[\"logicalTargets\"].items()\n        for record_id in target[\"records\"]\n    }\n    missing = sorted(expected_keys - actual_keys)\n    unexpected = sorted(actual_keys - expected_keys)\n    if unexpected:\n        raise ValueError(\n            f\"Optimizer census contains {len(unexpected)} physical target keys outside the rederived inventory\"\n        )\n    expected_logical = {(source_id, logical_id) for source_id, logical_id, _ in expected_keys}\n    actual_logical = {(source_id, logical_id) for source_id, logical_id, _ in actual_keys}\n    repeated = any(\n        record.get(\"scoredOccurrences\", 0) > len(record.get(\"windowIndices\", []))\n        for source in actual_sources.values()\n        for target in source[\"logicalTargets\"].values()\n        for record in target[\"records\"].values()\n    )\n    total = len(expected_keys)\n    covered = total - len(missing)\n    return {\n        \"schema\": \"semantic-v8-target-presence-comparison/1\",\n        \"inventoryDigest\": inventory[\"digest\"],\n        \"expectedPositiveWeightPhysicalTargets\": total,\n        \"coveredPositiveWeightPhysicalTargets\": covered,\n        \"expectedPositiveWeightLogicalTargets\": len(expected_logical),\n        \"coveredPositiveWeightLogicalTargets\": len(expected_logical & actual_logical),\n        \"missingPositiveWeightPhysicalTargets\": [list(row) for row in missing],\n        \"unexpectedPhysicalTargets\": [list(row) for row in unexpected],\n        \"targetPresenceCoverage\": 1.0\n        if total and not missing and not unexpected\n        else (covered / total if total else 0.0),\n        \"allPositiveWeightTargetsExposed\": bool(total) and not missing and not unexpected,\n        \"repeatedWindowExposureObserved\": repeated,\n        \"tokenOrMaskPositionCoverage\": \"unmeasured\",\n        \"learnedSuccess\": None,\n    }\n"}
2026-11-22T08:40:30.6033820Z FORMATTED_SOURCE_JSON {"path": "tests/test_semantic_v8_target_inventory.py", "content": "\"\"\"Exact positive-loss inventory and optimizer target-presence comparison controls.\"\"\"\n\nfrom copy import deepcopy\n\nimport pytest\n\nfrom megatoken.data.semantic_json import stable_algorithm_hash\nfrom megatoken.training.target_inventory_v8 import (\n    compare_target_inventory,\n    validate_target_inventory,\n)\n\nREGISTRY = \"a\" * 64\nMANIFEST = \"b\" * 64\nCODEC = \"c\" * 64\nTRAINING = \"d\" * 64\nMODEL = \"e\" * 64\n\n\ndef _inventory():\n    sources = {\n        \"source-a\": {\n            \"split\": \"train\",\n            \"logicalTargets\": {\n                \"target-one\": {\n                    \"records\": {\n                        \"record-one\": {\n                            \"windowIndices\": [0, 1],\n                            \"lossDenominators\": {\"language_model\": 8},\n                            \"scoredOccurrences\": 2,\n                        }\n                    }\n                }\n            },\n        }\n    }\n    body = {\n        \"schema\": \"semantic-v8-positive-loss-target-inventory/1\",\n        \"registryDigest\": REGISTRY,\n        \"sourceIds\": [\"source-a\" if index == 0 else f\"train-{index:02d}\" for index in range(48)],\n        \"scoredSourceIds\": [\"source-a\"],\n        \"trainEpisodeCount\": 48,\n        \"windowCount\": 120,\n        \"preparedManifestFingerprint\": MANIFEST,\n        \"codecFingerprint\": CODEC,\n        \"trainingConfigDigest\": TRAINING,\n        \"modelConfigDigest\": MODEL,\n        \"windowConfig\": {},\n        \"effectiveLossWeights\": {\"language_model\": 1.0},\n        \"available\": {\"policyTargetRecordCount\": 1, \"lossDenominators\": {\"language_model\": 8}},\n        \"positiveWeight\": {\n            \"sourceCount\": 1,\n            \"logicalTargetCount\": 1,\n            \"physicalTargetRecordCount\": 1,\n            \"scoredOccurrences\": 2,\n            \"lossDenominators\": {\"language_model\": 8},\n        },\n        \"sources\": sources,\n        \"optimizerUpdates\": 0,\n        \"learnedSuccess\": None,\n    }\n    return {**body, \"digest\": stable_algorithm_hash(body)}\n\n\ndef _identities():\n    return {\n        \"registry_digest\": REGISTRY,\n        \"prepared_manifest_fingerprint\": MANIFEST,\n        \"codec_fingerprint\": CODEC,\n        \"training_config_digest\": TRAINING,\n        \"model_config_digest\": MODEL,\n    }\n\n\ndef _actual(*, extra=False):\n    rows = {\n        \"source-a\": {\n            \"split\": \"train\",\n            \"logicalTargets\": {\n                \"target-one\": {\n                    \"records\": {\n                        \"record-one\": {\n                            \"windowIndices\": [0],\n                            \"scoredOccurrences\": 1,\n                        }\n                    }\n                }\n            },\n        }\n    }\n    if extra:\n        rows[\"source-b\"] = {\n            \"split\": \"train\",\n            \"logicalTargets\": {\n                \"unlisted\": {\"records\": {\"forged\": {\"windowIndices\": [0], \"scoredOccurrences\": 1}}}\n            },\n        }\n    return rows\n\n\ndef test_exact_target_presence_passes_without_claiming_position_coverage():\n    result = compare_target_inventory(\n        _inventory(), _actual(), rederived_inventory=_inventory(), **_identities()\n    )\n    assert result[\"allPositiveWeightTargetsExposed\"] is True\n    assert result[\"targetPresenceCoverage\"] == 1.0\n    assert result[\"tokenOrMaskPositionCoverage\"] == \"unmeasured\"\n    assert result[\"repeatedWindowExposureObserved\"] is False\n    assert result[\"learnedSuccess\"] is None\n\n\ndef test_missing_inventory_targets_are_reported_without_inflating_coverage():\n    result = compare_target_inventory(\n        _inventory(), {}, rederived_inventory=_inventory(), **_identities()\n    )\n    assert result[\"allPositiveWeightTargetsExposed\"] is False\n    assert result[\"targetPresenceCoverage\"] == 0.0\n    assert result[\"missingPositiveWeightPhysicalTargets\"] == [\n        [\"source-a\", \"target-one\", \"record-one\"]\n    ]\n\n\ndef test_unexpected_optimizer_target_is_integrity_failure():\n    with pytest.raises(ValueError, match=\"outside the rederived inventory\"):\n        compare_target_inventory(\n            _inventory(), _actual(extra=True), rederived_inventory=_inventory(), **_identities()\n        )\n\n\n@pytest.mark.parametrize(\n    \"field\",\n    [\n        \"registryDigest\",\n        \"preparedManifestFingerprint\",\n        \"codecFingerprint\",\n        \"trainingConfigDigest\",\n        \"modelConfigDigest\",\n    ],\n)\ndef test_inventory_bound_to_other_run_identity_is_refused(field):\n    keys = {\n        \"registryDigest\": \"registry_digest\",\n        \"preparedManifestFingerprint\": \"prepared_manifest_fingerprint\",\n        \"codecFingerprint\": \"codec_fingerprint\",\n        \"trainingConfigDigest\": \"training_config_digest\",\n        \"modelConfigDigest\": \"model_config_digest\",\n    }\n    identities = _identities()\n    identities[keys[field]] = \"f\" * 64\n    with pytest.raises(ValueError, match=\"identity\"):\n        validate_target_inventory(_inventory(), rederived_inventory=_inventory(), **identities)\n\n\ndef test_rehashed_forged_target_keys_still_fail_count_invariant():\n    value = deepcopy(_inventory())\n    value[\"sources\"][\"source-a\"][\"logicalTargets\"][\"target-two\"] = {\n        \"records\": {\"record-two\": {\"windowIndices\": [0], \"scoredOccurrences\": 1}}\n    }\n    body = {key: child for key, child in value.items() if key != \"digest\"}\n    value[\"digest\"] = stable_algorithm_hash(body)\n    with pytest.raises(ValueError, match=\"re-derivation\"):\n        validate_target_inventory(value, rederived_inventory=_inventory(), **_identities())\n\n\ndef test_repeated_window_occurrence_is_reported_separately_from_unique_target_coverage():\n    actual = _actual()\n    record = actual[\"source-a\"][\"logicalTargets\"][\"target-one\"][\"records\"][\"record-one\"]\n    record[\"windowIndices\"] = [0]\n    record[\"scoredOccurrences\"] = 2\n    result = compare_target_inventory(\n        _inventory(), actual, rederived_inventory=_inventory(), **_identities()\n    )\n    assert result[\"allPositiveWeightTargetsExposed\"] is True\n    assert result[\"repeatedWindowExposureObserved\"] is True\n\n\ndef test_rehashed_inventory_that_disagrees_with_rederived_planner_is_refused():\n    value = _inventory()\n    tampered = deepcopy(value)\n    tampered[\"sources\"][\"source-a\"][\"logicalTargets\"][\"target-one\"][\"records\"][\"record-one\"][\n        \"lossDenominators\"\n    ][\"language_model\"] = 99\n    body = {key: child for key, child in tampered.items() if key != \"digest\"}\n    tampered[\"digest\"] = stable_algorithm_hash(body)\n    with pytest.raises(ValueError, match=\"re-derivation\"):\n        validate_target_inventory(tampered, rederived_inventory=value, **_identities())\n\n\ndef test_inventory_omitting_train_source_or_duplicate_source_id_is_refused():\n    value = _inventory()\n    missing = deepcopy(value)\n    missing[\"sourceIds\"] = missing[\"sourceIds\"][:-1]\n    body = {key: child for key, child in missing.items() if key != \"digest\"}\n    missing[\"digest\"] = stable_algorithm_hash(body)\n    with pytest.raises(ValueError, match=\"identity, count\"):\n        validate_target_inventory(missing, rederived_inventory=missing, **_identities())\n\n    duplicate = deepcopy(value)\n    duplicate[\"sourceIds\"][-1] = duplicate[\"sourceIds\"][0]\n    body = {key: child for key, child in duplicate.items() if key != \"digest\"}\n    duplicate[\"digest\"] = stable_algorithm_hash(body)\n    with pytest.raises(ValueError, match=\"identity, count\"):\n        validate_target_inventory(duplicate, rederived_inventory=duplicate, **_identities())\n\n\ndef test_duplicate_window_ids_in_inventory_are_refused():\n    value = deepcopy(_inventory())\n    record = value[\"sources\"][\"source-a\"][\"logicalTargets\"][\"target-one\"][\"records\"][\"record-one\"]\n    record[\"windowIndices\"] = [0, 0]\n    body = {key: child for key, child in value.items() if key != \"digest\"}\n    value[\"digest\"] = stable_algorithm_hash(body)\n    with pytest.raises(ValueError, match=\"identity, count\"):\n        validate_target_inventory(value, rederived_inventory=value, **_identities())\n"}
2026-11-22T08:40:30.6571906Z FORMATTED_SOURCE_JSON {"path": "scripts/qualify_semantic_v8_lifecycle.py", "content": "#!/usr/bin/env python3\n\"\"\"Verify ordinary V8 optimizer/resume/export and real JSONL serving evidence.\n\nRun preparation, two bounded normal trainer invocations and export first. This\ncollector requires their actual artifacts, a clean pinned consumer checkout and\nthe ordinary pinned tokenizer. It never injects a decoder or changes admission.\nGenerated output is retained without making a learned-success claim.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport copy\nimport hashlib\nimport json\nimport os\nimport selectors\nimport subprocess\nimport sys\nfrom pathlib import Path\n\n\ndef read_json(path):\n    return json.loads(Path(path).read_text())\n\n\ndef write_json(path, value):\n    Path(path).write_text(json.dumps(value, indent=2, allow_nan=False) + \"\\n\")\n\n\ndef file_identity(path):\n    path = Path(path).resolve()\n    digest = hashlib.sha256()\n    with path.open(\"rb\") as stream:\n        for block in iter(lambda: stream.read(1 << 20), b\"\"):\n            digest.update(block)\n    return {\"path\": str(path), \"bytes\": path.stat().st_size, \"sha256\": digest.hexdigest()}\n\n\ndef require(condition, message):\n    if not condition:\n        raise ValueError(message)\n\n\nclass Service:\n    def __init__(self, root, served, output, name):\n        self.output = output\n        self.name = name\n        self.calls = []\n        self.stderr = (output / f\"{name}-stderr.log\").open(\"w\")\n        self.process = subprocess.Popen(\n            [\n                sys.executable,\n                str(root / \"scripts/serve_semantic_v8.py\"),\n                \"--served\",\n                str(served),\n                \"--device\",\n                \"cpu\",\n                \"--threads\",\n                \"1\",\n                \"--max-tokens\",\n                \"4\",\n                \"--max-fragments\",\n                \"1\",\n                \"--profile-output\",\n                str(output / f\"{name}-profile.json\"),\n            ],\n            cwd=root,\n            env={\n                **os.environ,\n                \"PYTHONPATH\": str(root / \"src\"),\n                \"OMP_NUM_THREADS\": \"1\",\n                \"MKL_NUM_THREADS\": \"1\",\n            },\n            stdin=subprocess.PIPE,\n            stdout=subprocess.PIPE,\n            stderr=self.stderr,\n            text=True,\n        )\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, error_type, *_):\n        self.process.stdin.close()\n        try:\n            self.process.wait(timeout=30)\n        except subprocess.TimeoutExpired:\n            self.process.kill()\n            self.process.wait()\n        finally:\n            self.process.stdout.close()\n            self.stderr.close()\n            write_json(self.output / f\"{self.name}-rpc.json\", self.calls)\n        if error_type is None:\n            require(\n                self.process.returncode == 0, f\"Native service {self.name} did not close cleanly\"\n            )\n\n    def call(self, operation, **fields):\n        request = {\"id\": f\"{self.name}-{len(self.calls)}\", \"op\": operation, **fields}\n        self.process.stdin.write(json.dumps(request, allow_nan=False) + \"\\n\")\n        self.process.stdin.flush()\n        with selectors.DefaultSelector() as ready:\n            ready.register(self.process.stdout, selectors.EVENT_READ)\n            if not ready.select(timeout=180):\n                raise TimeoutError(f\"Native V8 service timed out on {operation}\")\n        line = self.process.stdout.readline()\n        require(line, f\"Native V8 service exited on {operation}; inspect {self.name}-stderr.log\")\n        response = json.loads(line)\n        self.calls.append({\"request\": request, \"response\": response})\n        require(response.get(\"id\") == request[\"id\"], \"Native service changed the request ID\")\n        return response\n\n\ndef success(response):\n    require(response.get(\"ok\") is True, f\"Native RPC refused: {response.get('error')}\")\n    return response[\"result\"]\n\n\ndef original_attempt(response):\n    attempt = (\n        response[\"result\"].get(\"selection\")\n        if response.get(\"ok\")\n        else response[\"error\"].get(\"evidence\")\n    )\n    require(isinstance(attempt, dict), \"Selection failed before producing model evidence\")\n    require(\n        attempt.get(\"origin\") == \"actual-model-selected\"\n        and attempt.get(\"modelSelected\") is True\n        and attempt.get(\"generatedTokens\", 0) > 0\n        and attempt.get(\"fragments\"),\n        \"Qualification requires original tokens from the loaded model\",\n    )\n    return attempt\n\n\ndef qualify_serving(root, served, source, output, manifest):\n    example = read_json(source)\n    orchestration = \"orchestrationTranscript\" in example.get(\"sidecar\", {})\n    context = copy.deepcopy(example[\"contexts\"][0])\n    public = copy.deepcopy(example[\"public\"])\n    public[\"timeline\"] = public[\"timeline\"][: context[\"visibleThrough\"]]\n    selection = {\n        \"session\": public[\"timeline\"][0][\"fields\"][\"session\"],\n        \"public\": public,\n        \"contexts\": [],\n        \"context\": context,\n    }\n    identity = {\n        \"seed\": 17,\n        \"checkpointIdentity\": manifest[\"model_sha256\"],\n        \"tokenizerIdentity\": manifest[\"codec_fingerprint\"],\n        \"trainingIdentity\": manifest[\"semantic_v8_lineage_digest\"],\n    }\n    controls = []\n    with Service(root, served, output, \"original\") as service:\n        for label, invalid in (\n            (\n                \"omitted\",\n                {key: value for key, value in identity.items() if key != \"trainingIdentity\"},\n            ),\n            (\"null\", {**identity, \"trainingIdentity\": None}),\n            (\"substituted\", {**identity, \"trainingIdentity\": \"0\" * 64}),\n        ):\n            response = service.call(\"initialize\", **invalid)\n            require(response.get(\"ok\") is False, f\"Serving accepted {label} training identity\")\n            controls.append({\"kind\": label, \"error\": response[\"error\"]})\n        initialized = success(service.call(\"initialize\", **identity))\n        require(initialized[\"trainingIdentity\"] == identity[\"trainingIdentity\"], \"Lineage changed\")\n        select_operation = \"select\"\n        if orchestration:\n            opened = success(\n                service.call(\n                    \"open-orchestration\",\n                    session=selection[\"session\"],\n                    public={**example[\"public\"], \"timeline\": example[\"public\"][\"timeline\"][:2]},\n                    origin=\"model\",\n                    childBudget=100000,\n                )\n            )\n            selection = {\"session\": selection[\"session\"], \"track\": opened[\"track\"]}\n            select_operation = \"select-orchestration\"\n        first_response = service.call(select_operation, **selection)\n        first = original_attempt(first_response)\n        packet = success(service.call(\"checkpoint\"))\n        write_json(output / \"live-checkpoint.json\", packet)\n        if first_response[\"ok\"]:\n            success(\n                service.call(\n                    \"reject\",\n                    session=selection[\"session\"],\n                    selectionId=first[\"selectionId\"],\n                    reason=\"Lifecycle qualification does not acknowledge generated semantics\",\n                )\n            )\n        expected = original_attempt(service.call(select_operation, **selection))\n    with Service(root, served, output, \"restored\") as service:\n        restored = success(service.call(\"restore\", checkpoint=packet))\n        actual = original_attempt(service.call(select_operation, **selection))\n    compared = (\n        \"selectionId\",\n        \"fragments\",\n        \"payloadHex\",\n        \"generatedTokens\",\n        \"checkpointIdentity\",\n        \"tokenizerIdentity\",\n        \"trainingIdentity\",\n    )\n    for key in compared:\n        require(actual[key] == expected[key], f\"Fresh-process next selection differs: {key}\")\n    require(restored[\"restored\"] is True, \"Live state did not restore\")\n    require(restored[\"reexecutedSelections\"] == 0, \"Unexpected acknowledged model selections\")\n    return {\n        \"initialization\": initialized,\n        \"identityRefusals\": controls,\n        \"firstSelection\": first,\n        \"firstSelectionError\": first_response.get(\"error\"),\n        \"restoration\": restored,\n        \"nextSelectionComparedFields\": list(compared),\n        \"nextSelectionExact\": True,\n        \"acknowledgedModelSelections\": 0,\n        \"selectionFamily\": \"orchestration\" if orchestration else \"semantic\",\n        \"learnedSuccess\": None,\n        \"scope\": \"Actual trained CPU weights and pinned tokenizer; original token selection and fresh-process initial-state/RNG continuation. No semantic record was acknowledged.\",\n    }\n\n\ndef qualify_orchestration_preparation(source, prepared_path, report):\n    \"\"\"Inspect real saved rows without mistaking materialization for exposure.\"\"\"\n    from megatoken.data import PreparedCorpus\n    from megatoken.data.semantic_orchestration_training_v8 import (\n        validate_orchestration_records_v8,\n        validate_orchestration_transcript_v8,\n    )\n\n    example = read_json(source)\n    if \"orchestrationTranscript\" not in example.get(\"sidecar\", {}):\n        require(not report[\"counts\"].get(\"orchestrationRecords\"), \"Detached orchestration count\")\n        return None\n    validation = validate_orchestration_transcript_v8(example)\n    require(\n        report[\"counts\"].get(\"orchestrationRecords\") == 4,\n        \"Ordinary preparation omitted lifecycle targets\",\n    )\n    with PreparedCorpus([prepared_path], split=\"train\") as corpus:\n        require(len(corpus) == 1, \"Orchestration qualification needs its single admitted episode\")\n        episode = next(corpus.iter_episodes())\n        require(\n            validate_orchestration_records_v8(episode, validation),\n            \"Saved physical lifecycle records differ from the source-qualified transcript\",\n        )\n        targets = [\n            record\n            for record in episode.records\n            if record.logical_id.startswith(\"semantic:v8:orchestration:target:\")\n        ]\n        require(\n            len({record.logical_id for record in targets}) == 4\n            and all(record.policy_mask for record in targets),\n            \"Saved lifecycle targets lost loss-bearing physical parts\",\n        )\n        semantic = json.loads(episode.supervision.annotations_json)[\"semantic_execution\"]\n        return {\n            \"transcriptDigest\": validation[\"transcriptDigest\"],\n            \"logicalLifecycleTargets\": 4,\n            \"physicalLifecycleTargetParts\": len(targets),\n            \"trackOwners\": sorted(track.track_id for track in episode.tracks),\n            \"nativeTrainingDigest\": semantic[\"nativeAdmission\"][\"nativeTrainingDigest\"],\n            \"workAccounting\": example[\"sidecar\"][\"orchestrationTranscript\"][\"policy\"][\n                \"workAccounting\"\n            ],\n            \"optimizerExposurePerTarget\": None,\n            \"actualModelFragmentBudgetEquivalence\": None,\n        }\n\n\ndef qualify_checkpoints(\n    first_path,\n    resumed_path,\n    prepared,\n    served,\n    manifest,\n    registry_digest,\n    allowed_source_ids=None,\n    target_inventory_path=None,\n):\n    import torch\n\n    from megatoken.semantic_lineage_v8 import checkpoint_lineage_v8, validate_served_lineage_v8\n    from megatoken.training.checkpoint import load_checkpoint\n\n    first, first_metadata = load_checkpoint(first_path, map_location=\"cpu\")\n    resumed, resumed_metadata = load_checkpoint(resumed_path, map_location=\"cpu\")\n    first_lineage = checkpoint_lineage_v8(first, first_metadata)\n    resumed_lineage = checkpoint_lineage_v8(resumed, resumed_metadata)\n    require(\n        first_lineage is not None and first_lineage == resumed_lineage, \"Training lineage changed\"\n    )\n    require(\n        first[\"global_step\"] == 1 and resumed[\"global_step\"] == 2, \"Expected one step then resume\"\n    )\n    require(\n        first_lineage[\"preparedManifestFingerprints\"] == [prepared[\"fingerprint\"]],\n        \"Checkpoint does not bind this single prepared corpus\",\n    )\n    require(manifest[\"model_version\"] == 2, \"Serving bundle did not export the resumed step\")\n    require(\n        manifest[\"checkpoint_sha256\"] == resumed_metadata[\"state_sha256\"],\n        \"Serving bundle names another training checkpoint\",\n    )\n    moments1 = first[\"optimizer\"][\"moments\"]\n    moments2 = resumed[\"optimizer\"][\"moments\"]\n    require(moments1 and set(moments1) <= set(moments2), \"Optimizer lost existing moment owners\")\n    advanced = [\n        name\n        for name in moments1\n        if float(moments1[name].get(\"step\", 0)) == 1 and float(moments2[name].get(\"step\", 0)) == 2\n    ]\n    require(advanced, \"No retained optimizer moment advanced from step one to two\")\n    changed = [\n        name\n        for name in first[\"optimizer\"][\"master_weights\"]\n        if not torch.equal(\n            first[\"optimizer\"][\"master_weights\"][name],\n            resumed[\"optimizer\"][\"master_weights\"][name],\n        )\n    ]\n    require(changed, \"Resumed training did not update model master weights\")\n    target_exposure = qualify_target_exposure(\n        first,\n        resumed,\n        registry_digest=registry_digest,\n        allowed_source_ids=allowed_source_ids,\n    )\n    if target_inventory_path is not None:\n        require(\n            allowed_source_ids is not None,\n            \"Positive-loss target inventory is only valid for the exact support population\",\n        )\n        from qualify_semantic_v8_target_inventory import target_inventory\n\n        from megatoken.training.target_inventory_v8 import compare_target_inventory\n\n        stored_inventory = read_json(target_inventory_path)\n        derived_inventory = target_inventory(first[\"train_config\"], allowed_source_ids)\n        resumed_inventory = target_inventory(resumed[\"train_config\"], allowed_source_ids)\n        require(\n            derived_inventory == resumed_inventory,\n            \"Resumed target-affecting config differs from the inventoried objective\",\n        )\n        comparison = compare_target_inventory(\n            stored_inventory,\n            resumed[\"semantic_v8_target_exposure\"][\"sources\"],\n            rederived_inventory=derived_inventory,\n            registry_digest=registry_digest,\n            prepared_manifest_fingerprint=prepared[\"fingerprint\"],\n            codec_fingerprint=prepared[\"codec_fingerprint\"],\n            training_config_digest=derived_inventory[\"trainingConfigDigest\"],\n            model_config_digest=derived_inventory[\"modelConfigDigest\"],\n        )\n        target_exposure[\"targetPresenceComparison\"] = comparison\n        target_exposure[\"allTargetsExposed\"] = comparison[\"allPositiveWeightTargetsExposed\"]\n        target_exposure[\"targetInventory\"] = {\n            \"digest\": derived_inventory[\"digest\"],\n            \"windowCount\": derived_inventory[\"windowCount\"],\n            \"available\": derived_inventory[\"available\"],\n            \"positiveWeight\": derived_inventory[\"positiveWeight\"],\n        }\n    served_lineage = read_json(served / \"semantic-v8-lineage.json\")\n    validate_served_lineage_v8(served_lineage, manifest)\n    require(served_lineage[\"training\"] == resumed_lineage, \"Serving lineage changed\")\n    return {\n        \"firstGlobalStep\": first[\"global_step\"],\n        \"resumedGlobalStep\": resumed[\"global_step\"],\n        \"firstCheckpointSha256\": first_metadata[\"state_sha256\"],\n        \"resumedCheckpointSha256\": resumed_metadata[\"state_sha256\"],\n        \"retainedMomentOwners\": len(moments1),\n        \"advancedMomentOwners\": len(advanced),\n        \"changedMasterWeights\": len(changed),\n        \"changedMasterWeightNames\": changed,\n        \"trainingLineage\": resumed_lineage,\n        \"servingLineageDigest\": served_lineage[\"digest\"],\n        \"optimizerTargetExposure\": target_exposure,\n    }\n\n\ndef qualify_target_exposure(first, resumed, *, registry_digest, allowed_source_ids=None):\n    from megatoken.training.semantic_v8 import (\n        semantic_v8_target_exposure_report,\n        validate_semantic_v8_target_exposure,\n    )\n\n    first_state = first.get(\"semantic_v8_target_exposure\")\n    resumed_state = resumed.get(\"semantic_v8_target_exposure\")\n    require(\n        first_state is not None and resumed_state is not None,\n        \"V8 lifecycle checkpoint lost its target-exposure census\",\n    )\n    first_state = validate_semantic_v8_target_exposure(first_state, registry_digest=registry_digest)\n    resumed_state = validate_semantic_v8_target_exposure(\n        resumed_state, registry_digest=registry_digest\n    )\n    require(\n        first_state[\"startingGlobalStep\"] == 0\n        and first_state[\"lastGlobalStep\"] == first[\"global_step\"] == 1\n        and first_state[\"optimizerUpdates\"] == 1,\n        \"First checkpoint target-exposure history is not exactly optimizer step one\",\n    )\n    require(\n        resumed_state[\"startingGlobalStep\"] == first_state[\"startingGlobalStep\"]\n        and resumed_state[\"lastGlobalStep\"] == resumed[\"global_step\"] == 2\n        and resumed_state[\"optimizerUpdates\"] == 2,\n        \"Resumed target-exposure history is not the exact step-one to step-two continuation\",\n    )\n    require(\n        resumed_state[\"previousDigest\"] == first_state[\"digest\"],\n        \"Resumed target-exposure history does not name the exact step-one parent\",\n    )\n    allowed = None if allowed_source_ids is None else set(allowed_source_ids)\n    for source_id, source in first_state[\"sources\"].items():\n        require(source_id in resumed_state[\"sources\"], \"Resume dropped a scored source\")\n        if allowed is not None:\n            require(\n                source_id in allowed,\n                \"Target exposure includes a source outside the support inventory\",\n            )\n        old_source = source\n        new_source = resumed_state[\"sources\"][source_id]\n        require(\n            old_source[\"split\"] == new_source[\"split\"] == \"train\",\n            \"Target exposure changed split\",\n        )\n        for logical_id, old_target in old_source[\"logicalTargets\"].items():\n            require(\n                logical_id in new_source[\"logicalTargets\"],\n                \"Resume dropped a scored logical target\",\n            )\n            new_target = new_source[\"logicalTargets\"][logical_id]\n            for record_id, old_record in old_target[\"records\"].items():\n                require(\n                    record_id in new_target[\"records\"],\n                    \"Resume dropped a scored physical record\",\n                )\n                new_record = new_target[\"records\"][record_id]\n                require(\n                    set(old_record[\"windowIndices\"]) <= set(new_record[\"windowIndices\"])\n                    and old_record[\"scoredOccurrences\"] <= new_record[\"scoredOccurrences\"]\n                    and old_record[\"optimizerUpdates\"] <= new_record[\"optimizerUpdates\"]\n                    and old_record[\"firstGlobalStep\"] == new_record[\"firstGlobalStep\"]\n                    and old_record[\"lastGlobalStep\"] <= new_record[\"lastGlobalStep\"]\n                    and all(\n                        old_record[\"lossDenominators\"][name]\n                        <= new_record[\"lossDenominators\"].get(name, 0)\n                        for name in old_record[\"lossDenominators\"]\n                    ),\n                    \"Resume target-exposure history is not cumulative from step one\",\n                )\n    if allowed is not None:\n        require(\n            set(resumed_state[\"sources\"]) <= allowed,\n            \"Target exposure includes a source outside the support inventory\",\n        )\n    first_report = semantic_v8_target_exposure_report(first_state)\n    resumed_report = semantic_v8_target_exposure_report(resumed_state)\n    return {\n        \"schema\": resumed_report[\"schema\"],\n        \"registryDigest\": registry_digest,\n        \"historyContinued\": True,\n        \"firstCheckpointDigest\": first_state[\"digest\"],\n        \"resumedCheckpointDigest\": resumed_state[\"digest\"],\n        \"firstCheckpointCounts\": {\n            key: first_report[key]\n            for key in (\n                \"sourceCount\",\n                \"logicalTargetCount\",\n                \"physicalTargetRecordCount\",\n                \"scoredOccurrences\",\n                \"lossDenominators\",\n            )\n        },\n        \"resumedCounts\": {\n            key: resumed_report[key]\n            for key in (\n                \"sourceCount\",\n                \"logicalTargetCount\",\n                \"physicalTargetRecordCount\",\n                \"scoredOccurrences\",\n                \"lossDenominators\",\n            )\n        },\n        \"positiveWeightLossDenominators\": resumed_report[\"lossDenominators\"],\n        \"sources\": resumed_report[\"sources\"],\n        \"allTargetsExposed\": False,\n    }\n\n\ndef read_support_source_inventory(path, registry_digest):\n    value = read_json(path)\n    require(\n        isinstance(value, dict)\n        and set(value) == {\"schema\", \"registryDigest\", \"sourceIds\"}\n        and value[\"schema\"] == \"semantic-v8-source-population/1\"\n        and value[\"registryDigest\"] == registry_digest,\n        \"Support inventory is malformed or bound to another registry\",\n    )\n    ids = value[\"sourceIds\"]\n    require(\n        isinstance(ids, list)\n        and len(ids) == 64\n        and all(isinstance(item, str) and item for item in ids)\n        and len(set(ids)) == 64,\n        \"Support inventory must contain exactly 64 unique source IDs\",\n    )\n    return tuple(sorted(ids))\n\n\ndef validate_support_population(prepared_root, source_path, inventory_path):\n    from megatoken.data import PreparedCorpus\n    from megatoken.data.semantic_corpus_v8 import _verify_binding\n    from megatoken.data.semantic_json import stable_algorithm_hash\n\n    prepared_root = Path(prepared_root)\n    registry = read_json(prepared_root / \"semantic-v8-families.json\")\n    registry_digest = registry.get(\"digest\") if isinstance(registry, dict) else None\n    expected = read_support_source_inventory(inventory_path, registry_digest)\n    require(\n        isinstance(registry, dict)\n        and registry.get(\"schema\") == \"semantic-region-family-registry/1\"\n        and stable_algorithm_hash(\n            {key: value for key, value in registry.items() if key != \"digest\"}\n        )\n        == registry_digest,\n        \"Prepared support registry digest is invalid\",\n    )\n    source_rows = registry.get(\"sources\")\n    require(\n        isinstance(source_rows, list)\n        and len(source_rows) == 64\n        and {row.get(\"id\") for row in source_rows if isinstance(row, dict)} == set(expected),\n        \"Prepared support registry differs from the immutable 64-source inventory\",\n    )\n    split_by_id = {}\n    for component in registry.get(\"components\", []):\n        require(\n            isinstance(component, dict)\n            and component.get(\"split\") in {\"train\", \"validation\", \"test\"}\n            and isinstance(component.get(\"sourceIds\"), list),\n            \"Prepared support registry has a malformed split component\",\n        )\n        for source_id in component[\"sourceIds\"]:\n            require(\n                source_id in expected and source_id not in split_by_id,\n                \"Prepared support registry duplicates or substitutes a source\",\n            )\n            split_by_id[source_id] = component[\"split\"]\n    require(set(split_by_id) == set(expected), \"Prepared support registry omits source assignments\")\n    sample_document = read_json(source_path)\n    sample_identity, sample_member, sample_component, sample_binding = _verify_binding(\n        sample_document, registry\n    )\n    sample_source_id = sample_identity[\"sourceId\"]\n    require(\n        sample_source_id in expected and sample_component[\"split\"] == \"train\",\n        \"Lifecycle sample must be a source-bound member of the frozen training inventory\",\n    )\n    counts = {split: 0 for split in (\"train\", \"validation\", \"test\")}\n    observed = set()\n    sample_semantic = None\n    with PreparedCorpus([str(prepared_root)], split=None) as corpus:\n        for episode in corpus.iter_episodes():\n            try:\n                semantic = json.loads(episode.supervision.annotations_json)[\"semantic_execution\"]\n            except (KeyError, TypeError, json.JSONDecodeError) as error:\n                raise ValueError(\"Prepared support episode has no source identity\") from error\n            source_id, split = semantic.get(\"sourceId\"), episode.lineage.frozen_split\n            require(\n                source_id in split_by_id\n                and source_id not in observed\n                and split_by_id[source_id] == split,\n                \"Prepared support episode differs from its frozen inventory or split\",\n            )\n            observed.add(source_id)\n            counts[split] += 1\n            if source_id == sample_source_id:\n                sample_semantic = semantic\n    require(observed == set(expected), \"Prepared support corpus is missing an inventory source\")\n    require(isinstance(sample_semantic, dict), \"Prepared support corpus lacks the selected sample\")\n    public_artifact = {\"public\": sample_document[\"public\"], \"contexts\": sample_document[\"contexts\"]}\n    if \"orchestrationTranscript\" in sample_document[\"sidecar\"]:\n        public_artifact[\"sidecar\"] = sample_document[\"sidecar\"]\n    require(\n        sample_semantic.get(\"datasetBinding\") == sample_binding\n        and sample_semantic.get(\"publicArtifact\") == public_artifact,\n        \"Lifecycle sample public/context/source bytes differ from the prepared training episode\",\n    )\n    require(\n        counts == {\"train\": 48, \"validation\": 12, \"test\": 4},\n        \"Prepared support corpus differs from its frozen 48/12/4 source split\",\n    )\n    return {\n        \"registryDigest\": registry_digest,\n        \"sourceCount\": len(expected),\n        \"sourceInventory\": list(expected),\n        \"splitCounts\": counts,\n        \"sampleSourceId\": sample_source_id,\n        \"sampleDatasetBinding\": sample_binding,\n        \"sampleMember\": sample_member,\n    }\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--expected-source-ids\", type=Path)\n    parser.add_argument(\"--target-inventory\", type=Path)\n    for name in (\n        \"consumer-root\",\n        \"prepared\",\n        \"source\",\n        \"first-checkpoint\",\n        \"resumed-checkpoint\",\n        \"served\",\n        \"output\",\n    ):\n        parser.add_argument(\"--\" + name, type=Path, required=True)\n    options = parser.parse_args()\n    driver = file_identity(__file__)\n    root = options.consumer_root.resolve()\n    options.output.mkdir(parents=True, exist_ok=False)\n    output = options.output.resolve()\n    sys.path.insert(0, str(root / \"src\"))\n    head = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=root, text=True).strip()\n    dirty = subprocess.check_output(\n        [\"git\", \"status\", \"--porcelain\", \"--untracked-files=all\"], cwd=root, text=True\n    )\n    require(not dirty, \"Qualification consumer checkout must be clean\")\n    prepared = read_json(options.prepared / \"manifest.json\")\n    report = read_json(options.prepared / \"semantic-v8-report.json\")\n    require(report[\"consumerRevision\"] == head, \"Prepared data names another consumer revision\")\n    if options.expected_source_ids:\n        require(\n            options.target_inventory is not None,\n            \"Support lifecycle requires the immutable positive-loss target inventory\",\n        )\n        support = validate_support_population(\n            options.prepared, options.source, options.expected_source_ids\n        )\n        require(\n            report[\"counts\"][\"admitted\"] == support[\"sourceCount\"] and not report[\"refusals\"],\n            \"Prepared support report differs from the immutable source inventory\",\n        )\n        require(\n            report.get(\"registryDigest\") == support[\"registryDigest\"],\n            \"Prepared support report names another registry\",\n        )\n        orchestration = None\n    else:\n        support = None\n        require(\n            report[\"counts\"][\"admitted\"] == 1 and not report[\"refusals\"],\n            \"Expected one admitted source\",\n        )\n        orchestration = qualify_orchestration_preparation(options.source, options.prepared, report)\n    manifest = read_json(options.served / \"manifest.json\")\n    registry = read_json(options.prepared / \"semantic-v8-families.json\")\n    checkpoint = qualify_checkpoints(\n        options.first_checkpoint,\n        options.resumed_checkpoint,\n        prepared,\n        options.served,\n        manifest,\n        registry_digest=registry[\"digest\"],\n        allowed_source_ids=None if support is None else support[\"sourceInventory\"],\n        target_inventory_path=options.target_inventory,\n    )\n    serving = qualify_serving(root, options.served.resolve(), options.source, output, manifest)\n    artifacts = [\n        options.source,\n        options.prepared / \"manifest.json\",\n        options.prepared / \"semantic-v8-report.json\",\n        *([options.expected_source_ids] if options.expected_source_ids else []),\n        *([options.target_inventory] if options.target_inventory else []),\n    ]\n    for directory in (options.first_checkpoint, options.resumed_checkpoint, options.served):\n        artifacts.extend(sorted(path for path in directory.rglob(\"*\") if path.is_file()))\n    summary = {\n        \"schema\": \"semantic-ordinary-lifecycle-qualification/8\",\n        \"consumerRevision\": head,\n        \"driver\": driver,\n        \"preparation\": report,\n        \"preparedManifestFingerprint\": prepared[\"fingerprint\"],\n        **(\n            {\n                \"supportPopulation\": support,\n                \"fullLaunchQualified\": False,\n                \"supportSourceInventory\": file_identity(options.expected_source_ids),\n            }\n            if support is not None\n            else {}\n        ),\n        \"optimizerResumeExport\": checkpoint,\n        \"serving\": serving,\n        **({\"orchestrationPreparation\": orchestration} if orchestration is not None else {}),\n        \"artifacts\": [file_identity(path) for path in artifacts],\n        \"learnedSuccess\": None,\n        \"limits\": [\n            \"Target-presence comparison counts exact positive-weight physical target records; token or mask-position coverage remains unmeasured.\",\n            \"Two optimizer updates do not qualify learned execution quality or prove every positive-loss target was exposed.\",\n            *(\n                []\n                if support is not None\n                else [\n                    \"One source family and two optimizer steps do not qualify learned execution quality.\"\n                ]\n            ),\n            \"Fresh-process recovery retained original failed/unacknowledged selections; accepted-record recovery was not exercised.\",\n            \"Artifact hashes identify local complete bundles. Durable external bundle publication is a separate recorded step.\",\n        ],\n    }\n    write_json(output / \"summary.json\", summary)\n    print(\n        json.dumps(\n            {\n                \"output\": str(output),\n                \"resumedStep\": 2,\n                \"nextSelectionExact\": True,\n                **(\n                    {\n                        \"optimizerTargetExposure\": {\n                            key: value\n                            for key, value in checkpoint[\"optimizerTargetExposure\"][\n                                \"resumedCounts\"\n                            ].items()\n                            if key != \"lossDenominators\"\n                        }\n                        | {\n                            \"registryDigest\": checkpoint[\"optimizerTargetExposure\"][\n                                \"registryDigest\"\n                            ],\n                            \"positiveWeightLossDenominators\": checkpoint[\"optimizerTargetExposure\"][\n                                \"positiveWeightLossDenominators\"\n                            ],\n                            \"historyContinued\": checkpoint[\"optimizerTargetExposure\"][\n                                \"historyContinued\"\n                            ],\n                            \"allTargetsExposed\": False,\n                        }\n                    }\n                    if \"optimizerTargetExposure\" in checkpoint\n                    else {}\n                ),\n                \"learnedSuccess\": None,\n            }\n        )\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}
2026-11-22T08:40:30.6660554Z FORMATTED_SOURCE_JSON {"path": "scripts/qualify_semantic_v8_target_coverage.py", "content": "#!/usr/bin/env python3\n\"\"\"Verify ordinary training exposed every positive-loss V8 target in an inventory.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nfrom pathlib import Path\n\nfrom megatoken.data.semantic_json import stable_algorithm_hash\nfrom megatoken.semantic_lineage_v8 import checkpoint_lineage_v8\nfrom megatoken.training.checkpoint import load_checkpoint\nfrom megatoken.training.semantic_v8 import validate_semantic_v8_target_exposure\nfrom megatoken.training.target_inventory_v8 import compare_target_inventory\n\n\ndef read_json(path: Path):\n    return json.loads(path.read_text())\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--checkpoint\", type=Path, required=True)\n    parser.add_argument(\"--prepared\", type=Path, required=True)\n    parser.add_argument(\"--expected-source-ids\", type=Path, required=True)\n    parser.add_argument(\"--inventory\", type=Path, required=True)\n    parser.add_argument(\"--output\", type=Path, required=True)\n    args = parser.parse_args()\n\n    from qualify_semantic_v8_target_inventory import target_inventory\n\n    checkpoint, metadata = load_checkpoint(args.checkpoint, map_location=\"cpu\")\n    lineage = checkpoint_lineage_v8(checkpoint, metadata)\n    policy = checkpoint[\"train_config\"].get(\"semantic_v8_policy\")\n    if not isinstance(policy, dict):\n        raise ValueError(\"Coverage checkpoint has no explicit V8 policy\")\n    registry_digest = policy[\"registryDigest\"]\n    prepared_manifest = read_json(args.prepared / \"manifest.json\")\n    derived = target_inventory(checkpoint[\"train_config\"], args.expected_source_ids)\n    supplied = read_json(args.inventory)\n    state = validate_semantic_v8_target_exposure(\n        checkpoint.get(\"semantic_v8_target_exposure\"),\n        registry_digest=registry_digest,\n    )\n    comparison = compare_target_inventory(\n        supplied,\n        state[\"sources\"],\n        rederived_inventory=derived,\n        registry_digest=registry_digest,\n        prepared_manifest_fingerprint=prepared_manifest[\"fingerprint\"],\n        codec_fingerprint=prepared_manifest[\"codec_fingerprint\"],\n        training_config_digest=derived[\"trainingConfigDigest\"],\n        model_config_digest=derived[\"modelConfigDigest\"],\n    )\n    if state[\"startingGlobalStep\"] != 0 or state[\"optimizerUpdates\"] != checkpoint[\"global_step\"]:\n        raise ValueError(\"Coverage checkpoint does not retain a fresh complete optimizer census\")\n    if checkpoint[\"global_step\"] != derived[\"windowCount\"]:\n        raise ValueError(\n            \"Coverage training stopped before the one-pass optimizer-update bound: \"\n            f\"expected {derived['windowCount']}, got {checkpoint['global_step']}\"\n        )\n    if not comparison[\"allPositiveWeightTargetsExposed\"]:\n        raise ValueError(\n            \"Ordinary training did not expose the complete positive-loss target inventory: \"\n            f\"{len(comparison['missingPositiveWeightPhysicalTargets'])} missing, \"\n            f\"{len(comparison['unexpectedPhysicalTargets'])} unexpected\"\n        )\n    body = {\n        \"schema\": \"semantic-v8-ordinary-target-coverage/1\",\n        \"consumerRevision\": metadata.get(\"consumer_revision\"),\n        \"checkpointStateSha256\": metadata[\"state_sha256\"],\n        \"globalStep\": checkpoint[\"global_step\"],\n        \"trainingLineage\": lineage,\n        \"preparedManifestFingerprint\": prepared_manifest[\"fingerprint\"],\n        \"inventory\": {\n            \"digest\": derived[\"digest\"],\n            \"windowCount\": derived[\"windowCount\"],\n            \"sourceIds\": derived[\"sourceIds\"],\n            \"available\": derived[\"available\"],\n            \"positiveWeight\": derived[\"positiveWeight\"],\n        },\n        \"optimizerTargetExposure\": {\n            \"digest\": state[\"digest\"],\n            \"previousDigest\": state[\"previousDigest\"],\n            \"sourceCount\": len(state[\"sources\"]),\n            \"sources\": state[\"sources\"],\n        },\n        \"comparison\": comparison,\n        \"targetPresenceCoverage\": \"complete: every positive-weight logical/physical target record contributed at least once\",\n        \"tokenOrMaskPositionCoverage\": \"unmeasured\",\n        \"learnedSuccess\": None,\n    }\n    body[\"digest\"] = stable_algorithm_hash(body)\n    args.output.parent.mkdir(parents=True, exist_ok=True)\n    args.output.write_text(json.dumps(body, indent=2, allow_nan=False) + \"\\n\")\n    print(\n        \"V8_TARGET_COVERAGE_EVIDENCE_JSON \"\n        + json.dumps(body, sort_keys=True, separators=(\",\", \":\"))\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}
