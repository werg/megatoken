 or binding.get(\"split\") != split\n            or split != \"train\"\n            or not isinstance(source_id, str)\n            or not source_id\n        ):\n            raise ValueError(\"V8 optimizer target has a changed source, registry or split binding\")\n        for step in batch.steps:\n            if not step.plans:\n                continue\n            for encoded, plan in zip(step.records, step.plans, strict=True):\n                record = encoded.record\n                if not record.policy_mask:\n                    raise ValueError(\"V8 optimizer plan exposes a record outside the target mask\")\n                denominators = plan.denominators\n                if not isinstance(denominators, dict) or any(\n                    type(value) is not int or value < 0 for value in denominators.values()\n                ):\n                    raise ValueError(\"V8 optimizer plan has invalid loss denominators\")\n                positive = {\n                    name: count\n                    for name, count in denominators.items()\n                    if count\n                    and name != \"router_balance\"\n                    and effective_loss_weights.get(name, 0) > 0\n                }\n                if not positive:\n                    continue\n                occurrence = {\n                    \"sourceId\": source_id,\n                    \"registryDigest\": registry_digest,\n                    \"split\": split,\n                    \"logicalTargetId\": record.logical_id,\n                    \"physicalRecordId\": record.record_id,\n                    \"windowIndex\": item.window.index,\n                    \"lossDenominators\": positive,\n                }\n                occurrences.append(\n                    _validate_semantic_v8_target_occurrence(occurrence, registry_digest)\n                )\n    return {\n        \"schema\": V8_TARGET_EXPOSURE_SCHEMA,\n        \"registryDigest\": registry_digest,\n        \"occurrences\": occurrences,\n    }\n\n\ndef merge_semantic_v8_target_exposures(exposures, *, registry_digest):\n    \"\"\"Aggregate every scored occurrence while separately deduplicating target coverage.\"\"\"\n    merged = {\"schema\": V8_TARGET_EXPOSURE_SCHEMA, \"registryDigest\": registry_digest, \"sources\": {}}\n    for exposure in exposures:\n        if (\n            not isinstance(exposure, dict)\n            or exposure.get(\"schema\") != V8_TARGET_EXPOSURE_SCHEMA\n            or exposure.get(\"registryDigest\") != registry_digest\n            or not isinstance(exposure.get(\"occurrences\"), list)\n        ):\n            raise ValueError(\"Distributed V8 target exposure changed its registry\")\n        for occurrence in exposure[\"occurrences\"]:\n            row = _validate_semantic_v8_target_occurrence(occurrence, registry_digest)\n            source = merged[\"sources\"].setdefault(\n                row[\"sourceId\"], {\"split\": row[\"split\"], \"logicalTargets\": {}}\n            )\n            if source[\"split\"] != row[\"split\"]:\n                raise ValueError(\"Distributed V8 target source changed split\")\n            logical = source[\"logicalTargets\"].setdefault(row[\"logicalTargetId\"], {\"records\": {}})\n            record = logical[\"records\"].setdefault(\n                row[\"physicalRecordId\"],\n                {\n                    \"windowIndices\": [],\n                    \"lossDenominators\": {},\n                    \"scoredOccurrences\": 0,\n                },\n            )\n            record[\"windowIndices\"] = sorted(set(record[\"windowIndices\"]) | {row[\"windowIndex\"]})\n            record[\"scoredOccurrences\"] += 1\n            for name, count in row[\"lossDenominators\"].items():\n                record[\"lossDenominators\"][name] = record[\"lossDenominators\"].get(name, 0) + count\n    return merged\n\n\ndef advance_semantic_v8_target_exposure(state, step_exposure, *, optimizer_step, registry_digest):\n    validate_semantic_v8_target_exposure(state, registry_digest=registry_digest)\n    if (\n        type(optimizer_step) is not int\n        or optimizer_step != state[\"lastGlobalStep\"] + 1\n        or step_exposure.get(\"schema\") != V8_TARGET_EXPOSURE_SCHEMA\n        or step_exposure.get(\"registryDigest\") != registry_digest\n    ):\n        raise ValueError(\"V8 target exposure can advance only after the next optimizer update\")\n    updated = json.loads(json.dumps(state))\n    updated[\"lastGlobalStep\"] = optimizer_step\n    updated[\"optimizerUpdates\"] += 1\n    for source_id, source in step_exposure[\"sources\"].items():\n        if source.get(\"split\") != \"train\":\n            raise ValueError(\"V8 target exposure can only advance with training sources\")\n        dest_source = updated[\"sources\"].setdefault(\n            source_id, {\"split\": \"train\", \"logicalTargets\": {}}\n        )\n        if dest_source[\"split\"] != source[\"split\"]:\n            raise ValueError(\"V8 target exposure source changed split\")\n        for logical_id, target in source[\"logicalTargets\"].items():\n            dest_target = dest_source[\"logicalTargets\"].setdefault(logical_id, {\"records\": {}})\n            for record_id, current in target[\"records\"].items():\n                old = dest_target[\"records\"].get(record_id)\n                if old is None:\n                    dest_target[\"records\"][record_id] = {\n                        \"windowIndices\": list(current[\"windowIndices\"]),\n                        \"lossDenominators\": dict(current[\"lossDenominators\"]),\n                        \"scoredOccurrences\": current[\"scoredOccurrences\"],\n                        \"optimizerUpdates\": 1,\n                        \"firstGlobalStep\": optimizer_step,\n                        \"lastGlobalStep\": optimizer_step,\n                    }\n                    continue\n                old[\"windowIndices\"] = sorted(\n                    set(old[\"windowIndices\"]) | set(current[\"windowIndices\"])\n                )\n                old[\"lossDenominators\"] = {\n                    name: old[\"lossDenominators\"].get(name, 0)\n                    + current[\"lossDenominators\"].get(name, 0)\n                    for name in set(old[\"lossDenominators\"]) | set(current[\"lossDenominators\"])\n                }\n                old[\"scoredOccurrences\"] += current[\"scoredOccurrences\"]\n                old[\"optimizerUpdates\"] += 1\n                old[\"lastGlobalStep\"] = optimizer_step\n    result = _seal_semantic_v8_target_exposure(updated)\n    return validate_semantic_v8_target_exposure(result, registry_digest=registry_digest)\n\n\ndef semantic_v8_target_exposure_report(state):\n    source_rows = {}\n    loss_denominators = {}\n    scored_occurrences = 0\n    for source_id, source in sorted(state[\"sources\"].items()):\n        targets = source[\"logicalTargets\"]\n        source_rows[source_id] = {\n            \"split\": source[\"split\"],\n            \"logicalTargetIds\": sorted(targets),\n            \"physicalTargetRecords\": {\n                logical_id: {\n                    record_id: dict(record)\n                    for record_id, record in sorted(target[\"records\"].items())\n                }\n                for logical_id, target in sorted(targets.items())\n            },\n        }\n        for target in targets.values():\n            for record in target[\"records\"].values():\n                scored_occurrences += record[\"scoredOccurrences\"]\n                for name, value in record[\"lossDenominators\"].items():\n                    loss_denominators[name] = loss_denominators.get(name, 0) + value\n    logical_count = sum(len(source[\"logicalTargets\"]) for source in state[\"sources\"].values())\n    physical_count = sum(\n        len(target[\"records\"])\n        for source in state[\"sources\"].values()\n        for target in source[\"logicalTargets\"].values()\n    )\n    return {\n        \"schema\": V8_TARGET_EXPOSURE_SCHEMA,\n        \"registryDigest\": state[\"registryDigest\"],\n        \"startingGlobalStep\": state[\"startingGlobalStep\"],\n        \"lastGlobalStep\": state[\"lastGlobalStep\"],\n        \"optimizerUpdates\": state[\"optimizerUpdates\"],\n        \"sourceCount\": len(state[\"sources\"]),\n        \"logicalTargetCount\": logical_count,\n        \"physicalTargetRecordCount\": physical_count,\n        \"scoredOccurrences\": scored_occurrences,\n        \"lossDenominators\": loss_denominators,\n        \"sources\": source_rows,\n        \"digest\": state[\"digest\"],\n    }\n\n\ndef semantic_v8_target_step_summary(step_exposure):\n    logical_ids = {\n        (source_id, logical_id)\n        for source_id, source in step_exposure[\"sources\"].items()\n        for logical_id in source[\"logicalTargets\"]\n    }\n    physical_ids = {\n        (source_id, logical_id, record_id)\n        for source_id, source in step_exposure[\"sources\"].items()\n        for logical_id, target in source[\"logicalTargets\"].items()\n        for record_id in target[\"records\"]\n    }\n    denominators = {}\n    occurrences = 0\n    for source in step_exposure[\"sources\"].values():\n        for target in source[\"logicalTargets\"].values():\n            for record in target[\"records\"].values():\n                occurrences += record[\"scoredOccurrences\"]\n                for name, count in record[\"lossDenominators\"].items():\n                    denominators[name] = denominators.get(name, 0) + count\n    return {\n        \"sourceCount\": len(step_exposure[\"sources\"]),\n        \"logicalTargetCount\": len(logical_ids),\n        \"physicalTargetRecordCount\": len(physical_ids),\n        \"scoredOccurrences\": occurrences,\n        \"lossDenominators\": denominators,\n    }\n\n\ndef validate_semantic_training_policy_v8(policy):\n    fields = {\"schema\", \"producerRevision\", \"consumerRevision\", \"registryDigest\"}\n    if (\n        not isinstance(policy, dict)\n        or set(policy) != fields\n        or policy.get(\"schema\") != \"semantic-training-policy/8\"\n        or any(\n            not isinstance(policy.get(key), str)\n            or re.fullmatch(r\"[0-9a-f]{40}\", policy[key]) is None\n            for key in (\"producerRevision\", \"consumerRevision\")\n        )\n        or not isinstance(policy.get(\"registryDigest\"), str)\n        or re.fullmatch(r\"[0-9a-f]{64}\", policy[\"registryDigest\"]) is None\n    ):\n        raise ValueError(\"V8 training requires exact producer, consumer and family-registry pins\")\n    return policy\n\n\ndef load_semantic_v8_codec(path, *, vocab_size):\n    \"\"\"Load only the pinned raw tokenizer bytes used by V8 admission.\"\"\"\n    from megatoken.generation.codec import ByteCodec\n\n    source = Path(path)\n    if source.is_dir():\n        metadata = json.loads((source / \"codec.json\").read_text())\n        if metadata.get(\"tokenizer_sha256\") != LING_TOKENIZER_SHA256:\n            raise ValueError(\"V8 training codec metadata does not pin the approved tokenizer bytes\")\n        tokenizer = source / metadata[\"tokenizer_file\"]\n        if tokenizer.parent.resolve() != source.resolve():\n            raise ValueError(\"V8 tokenizer must remain inside its declared codec directory\")\n    else:\n        tokenizer = source\n    return ByteCodec.from_tokenizer_json(\n        tokenizer,\n        expected_sha256=LING_TOKENIZER_SHA256,\n        expected_vocab_size=vocab_size,\n    )\n\n\ndef _verify_registry(registry, expected_digest):\n    required = {\n        \"schema\",\n        \"policy\",\n        \"traceFormat\",\n        \"coreSchema\",\n        \"seed\",\n        \"holdouts\",\n        \"sources\",\n        \"components\",\n        \"diagnostics\",\n        \"digest\",\n    }\n    if (\n        not isinstance(registry, dict)\n        or set(registry) != required\n        or registry[\"schema\"] != \"semantic-region-family-registry/1\"\n        or registry[\"policy\"] != \"semantic-region-family-components/1\"\n        or registry[\"traceFormat\"] != \"semantic-trace/8\"\n        or registry[\"coreSchema\"] != \"semantic-algorithm/2\"\n        or type(registry[\"seed\"]) is not int\n        or registry[\"digest\"] != expected_digest\n        or stable_algorithm_hash({k: v for k, v in registry.items() if k != \"digest\"})\n        != expected_digest\n    ):\n        raise ValueError(\"V8 prepared data has no exact frozen source-family registry\")\n    sources = registry[\"sources\"]\n    components = registry[\"components\"]\n    if not isinstance(sources, list) or not sources or not isinstance(components, list):\n        raise ValueError(\"V8 registry is incomplete\")\n    ids = [row.get(\"id\") for row in sources if isinstance(row, dict)]\n    if len(ids) != len(sources) or len(ids) != len(set(ids)):\n        raise ValueError(\"V8 registry source inventory is malformed\")\n    membership = {}\n    for component in components:\n        if (\n            not isinstance(component, dict)\n            or not isinstance(component.get(\"sourceIds\"), list)\n            or component.get(\"split\") not in {\"train\", \"validation\", \"test\"}\n        ):\n            raise ValueError(\"V8 registry component or split is malformed\")\n        for source_id in component[\"sourceIds\"]:\n            if source_id in membership:\n                raise ValueError(\"V8 source is assigned to more than one component\")\n            membership[source_id] = component\n    if set(membership) != set(ids):\n        raise ValueError(\"V8 registry does not assign every inventoried source exactly once\")\n    return sources, membership\n\n\ndef validate_semantic_episode_v8(\n    episode,\n    *,\n    codec,\n    policy,\n    registry,\n    max_history=None,\n    max_positions=None,\n    expected_split=None,\n):\n    from megatoken.data.native_v8 import prepare_native_v8_training\n    from megatoken.data.source_identity_v8 import validate_source_binding_v8\n\n    policy = validate_semantic_training_policy_v8(policy)\n    sources, components = _verify_registry(registry, policy[\"registryDigest\"])\n    annotations = json.loads(episode.supervision.annotations_json)\n    semantic = annotations.get(\"semantic_execution\")\n    expected = {\"session_metadata\", \"semantic_execution\", \"semantic_geometry\"}\n    if set(annotations) != expected or not isinstance(semantic, dict):\n        raise ValueError(\"V8 semantic annotations are missing or contain undeclared data\")\n    geometry = annotations[\"semantic_geometry\"]\n    if (\n        episode.stream != \"semantic_execution\"\n        or semantic.get(\"schema\") != \"semantic-execution/8\"\n        or semantic.get(\"representation\") != \"mixed\"\n        or semantic.get(\"admission\") != \"admitted\"\n        or semantic.get(\"continuation\") != \"teacher_conditioned\"\n        or semantic.get(\"targetEligibility\") != \"source_admitted\"\n        or semantic.get(\"modelExecutionOutcome\") != \"unmeasured\"\n        or geometry.get(\"schema\") != \"semantic-native-geometry/8\"\n        or any(\n            type(geometry.get(key)) is not int or geometry[key] < 1\n            for key in (\"maxHistory\", \"maxPositions\")\n        )\n    ):\n        raise ValueError(\n            \"Ordinary V8 training requires source-admitted, freshly prepared V8 targets\"\n        )\n    if max_history is not None and geometry[\"maxHistory\"] > max_history:\n        raise ValueError(\"V8 data exceeds model history geometry\")\n    if max_positions is not None and geometry[\"maxPositions\"] > max_positions:\n        raise ValueError(\"V8 data exceeds model position geometry\")\n    binding = semantic.get(\"datasetBinding\")\n    document = semantic.get(\"publicArtifact\")\n    sidecar = document.get(\"sidecar\") if isinstance(document, dict) else None\n    has_orchestration = isinstance(sidecar, dict) and \"orchestrationTranscript\" in sidecar\n    orchestration = None\n    if has_orchestration:\n        from megatoken.data.semantic_orchestration_training_v8 import (\n            validate_orchestration_transcript_v8,\n        )\n\n        orchestration = validate_orchestration_transcript_v8(document)\n    if (\n        not isinstance(binding, dict)\n        or binding.get(\"schema\") != \"semantic-region-dataset-binding/1\"\n        or binding.get(\"traceFormat\") != \"semantic-trace/8\"\n        or binding.get(\"registryDigest\") != policy[\"registryDigest\"]\n        or binding.get(\"componentId\") != episode.lineage.family_id\n        or binding.get(\"split\") != episode.lineage.frozen_split\n        or binding.get(\"sourceId\") != semantic.get(\"sourceId\")\n        or has_orchestration\n        and binding.get(\"orchestrationTranscriptDigest\") != orchestration[\"transcriptDigest\"]\n        or not has_orchestration\n        and \"orchestrationTranscriptDigest\" in binding\n        or binding.get(\"split\") != semantic.get(\"split\")\n        or expected_split is not None\n        and binding.get(\"split\") != expected_split\n        or tuple(sorted(\"semantic-family:\" + item for item in semantic.get(\"members\", [])))\n        != tuple(sorted(episode.lineage.ancestor_ids))\n    ):\n        raise ValueError(\"V8 training row moved outside its frozen family split or source binding\")\n    source = next((row for row in sources if row[\"id\"] == semantic.get(\"sourceId\")), None)\n    component = components.get(semantic.get(\"sourceId\"))\n    if (\n        source is None\n        or component is None\n        or component[\"id\"] != binding[\"componentId\"]\n        or component[\"split\"] != binding[\"split\"]\n        or source[\"sourceDigest\"] != binding.get(\"sourceDigest\")\n        or source.get(\"coreDigest\") != binding.get(\"coreDigest\")\n    ):\n        raise ValueError(\"V8 exact source or component is absent from its complete registry\")\n    source_receipt, native = semantic.get(\"sourceAdmission\"), semantic.get(\"nativeAdmission\")\n    native_checks = native.get(\"checks\") if isinstance(native, dict) else None\n    native_counts = native.get(\"counts\") if isinstance(native, dict) else None\n    if not isinstance(native_checks, dict):\n        native_checks = {}\n    if not isinstance(native_counts, dict):\n        native_counts = {}\n    direct_source = validate_source_binding_v8(binding)\n    if (\n        not isinstance(source_receipt, dict)\n        or source_receipt.get(\"schema\") != \"semantic-native-source-recheck/1\"\n        or source_receipt.get(\"producerRevision\") != policy[\"producerRevision\"]\n        or source_receipt.get(\"sourceValidated\") is not True\n        or source_receipt.get(\"projectionValidated\") is not True\n        or source_receipt.get(\"replayValidated\") is not True\n        or source_receipt.get(\"sourceArtifactDigest\") != binding.get(\"sourceArtifactDigest\")\n        or direct_source\n        and (\n            source_receipt.get(\"sourceIdentityDigest\") != binding[\"sourceIdentityDigest\"]\n            or source_receipt.get(\"identityValidated\") is not True\n        )\n        or source_receipt.get(\"publicDigest\") != binding.get(\"episodeDigest\")\n        or source_receipt.get(\"contextDigest\") != binding.get(\"contextsDigest\")\n        or source_receipt.get(\"familyBindingValidated\") is not True\n        or source_receipt.get(\"registryDigest\") != policy[\"registryDigest\"]\n        or source_receipt.get(\"datasetBindingDigest\") != stable_algorithm_hash(binding)\n        or has_orchestration\n        and (\n            source_receipt.get(\"orchestrationValidated\") is not True\n            or source_receipt.get(\"orchestrationTranscriptDigest\")\n            != orchestration[\"transcriptDigest\"]\n        )\n        or not has_orchestration\n        and any(\n            key in source_receipt\n            for key in (\"orchestrationValidated\", \"orchestrationTranscriptDigest\")\n        )\n        or not isinstance(native, dict)\n        or native.get(\"schema\") != \"semantic-native-admission/8\"\n        or native.get(\"traceFormat\") != \"semantic-trace/8\"\n        or native.get(\"contextFormat\") != \"semantic-context/8\"\n        or native.get(\"componentGate\") != \"native-consumer-only\"\n        or native.get(\"admitted\") is not True\n        or native.get(\"consumerRevision\") != policy[\"consumerRevision\"]\n        or native.get(\"contractDigest\") != CONTRACT_DIGEST\n        or native.get(\"fixtureDigest\") != FIXTURE_DIGEST\n        or native.get(\"interoperabilityDigest\") != INTEROPERABILITY_DIGEST\n        or native.get(\"publicDigest\") != binding.get(\"episodeDigest\")\n        or native.get(\"contextsDigest\") != binding.get(\"contextsDigest\")\n        or native.get(\"sourceArtifactDigest\") != binding.get(\"sourceArtifactDigest\")\n        or direct_source\n        and native.get(\"sourceIdentityDigest\") != binding[\"sourceIdentityDigest\"]\n        or native.get(\"datasetBindingDigest\") != stable_algorithm_hash(binding)\n        or has_orchestration\n        and (\n            native.get(\"orchestrationTranscriptDigest\") != orchestration[\"transcriptDigest\"]\n            or native_checks.get(\"orchestration\") != \"passed\"\n            or native_counts.get(\"orchestrationRecords\") != orchestration[\"recordCount\"]\n        )\n        or not has_orchestration\n        and (\n            \"orchestrationTranscriptDigest\" in native\n            or \"orchestration\" in native_checks\n            or \"orchestrationRecords\" in native_counts\n        )\n        or native.get(\"tokenizer\")\n        != {\"status\": \"passed\", \"identity\": codec.fingerprint, \"sha256\": LING_TOKENIZER_SHA256}\n        or semantic.get(\"tokenizerEvidence\")\n        != {\n            \"schema\": \"semantic-tokenizer-admission/1\",\n            \"status\": \"passed\",\n            \"identity\": codec.fingerprint,\n            \"sha256\": LING_TOKENIZER_SHA256,\n            \"verification\": \"pinned-tokenizer-bytes\",\n        }\n        or native.get(\"nativeTrainingDigest\") != semantic.get(\"nativeTrainingDigest\")\n        or native.get(\"sourceVerification\") != source_receipt\n        or native.get(\"optimizerSteps\") != 0\n        or native.get(\"learningClaim\") is not None\n        or any(\n            native_checks.get(key) != \"passed\"\n            for key in (\"replay\", \"contexts\", \"continuation\", \"masks\", \"sourceBinding\", \"tokenizer\")\n        )\n        or has_orchestration\n        and native_checks.get(\"orchestration\") != \"passed\"\n    ):\n        raise ValueError(\n            \"Fresh source/native V8 admission, tokenizer or training evidence is missing\"\n        )\n    # Rebuild physical supervision and compare the content digest. This makes\n    # receipt presence insufficient if a shard changes after admission.\n    if not isinstance(document, dict):\n        raise ValueError(\"V8 artifact bytes were not retained for native revalidation\")\n    rebuilt, training = prepare_native_v8_training(\n        document,\n        codec=codec,\n        max_positions=geometry[\"maxPositions\"],\n        max_history=geometry[\"maxHistory\"],\n    )\n    if orchestration is not None:\n        from megatoken.data.semantic_orchestration_training_v8 import (\n            validate_orchestration_records_v8,\n        )\n\n        if (\n            training.get(\"orchestrationRecords\") != orchestration[\"recordCount\"]\n            or training.get(\"orchestrationTranscriptDigest\") != orchestration[\"transcriptDigest\"]\n            or not validate_orchestration_records_v8(episode, orchestration)\n        ):\n            raise ValueError(\n                \"V8 lifecycle targets or observations differ from the retained transcript\"\n            )\n    if any(\n        getattr(episode.lineage, key) != getattr(rebuilt.lineage, key)\n        for key in (\n            \"source_id\",\n            \"revision\",\n            \"repository\",\n            \"task_id\",\n            \"parent_episode_id\",\n            \"source_uri\",\n            \"created_at\",\n            \"source_row\",\n            \"raw_sha256\",\n        )\n    ):\n        raise ValueError(\"V8 source lineage differs from the source-bound artifact\")\n    normalized_records = tuple(\n        replace(record, provenance=\"unknown\")\n        if record.policy_mask\n        and not (record.logical_id or record.record_id).startswith(\n            \"semantic:v8:orchestration:target:\"\n        )\n        else record\n        for record in episode.records\n    )\n    normalized = replace(\n        episode,\n        records=normalized_records,\n        lineage=rebuilt.lineage,\n        supervision=rebuilt.supervision,\n    )\n    if (\n        training[\"nativeTrainingDigest\"] != semantic[\"nativeTrainingDigest\"]\n        or normalized != rebuilt\n    ):\n        raise ValueError(\"V8 physical records or target masks differ from admitted artifact bytes\")\n    result = {\n        \"generatedRecords\": training[\"generatedRecords\"],\n        \"split\": binding[\"split\"],\n        \"sourceId\": source[\"id\"],\n    }\n    if orchestration is not None:\n        result[\"orchestrationRecords\"] = orchestration[\"recordCount\"]\n    return result\n\n\ndef validate_prepared_semantic_v8(roots, *, codec, policy, max_history=None, max_positions=None):\n    from megatoken.data.storage import PreparedCorpus\n\n    policy = validate_semantic_training_policy_v8(policy)\n    with PreparedCorpus(roots, split=None) as corpus:\n        if not len(corpus) or corpus.codec_fingerprint != codec.fingerprint:\n            raise ValueError(\"V8 prepared supply is empty or uses a different codec\")\n        registry = None\n        for part in corpus.parts:\n            receipts = [\n                row\n                for row in part.manifest.get(\"sources\", [])\n                if row.get(\"schema\") == \"semantic-preparation/8\"\n            ]\n            if not receipts:\n                raise ValueError(\"V8 semantic roots require a V8 preparation manifest\")\n            for receipt in receipts:\n                if (\n                    receipt.get(\"producerRevision\") != policy[\"producerRevision\"]\n                    or receipt.get(\"consumerRevision\") != policy[\"consumerRevision\"]\n                    or receipt.get(\"registryDigest\") != policy[\"registryDigest\"]\n                    or receipt.get(\"tokenizerIdentity\") != codec.fingerprint\n                    or receipt.get(\"tokenizerSha256\") != LING_TOKENIZER_SHA256\n                    or receipt.get(\"contractDigest\") != CONTRACT_DIGEST\n                    or receipt.get(\"fixtureDigest\") != FIXTURE_DIGEST\n                    or receipt.get(\"optimizerSteps\") != 0\n                ):\n                    raise ValueError(\"V8 preparation manifest differs from the selected policy\")\n            saved = json.loads((part.root / \"semantic-v8-families.json\").read_text())\n            _verify_registry(saved, policy[\"registryDigest\"])\n            if registry is not None and saved != registry:\n                raise ValueError(\"V8 prepared roots use different complete family registries\")\n            registry = saved\n        counts = {\"train\": 0, \"validation\": 0, \"test\": 0}\n        for episode in corpus.iter_episodes():\n            validate_semantic_episode_v8(\n                episode,\n                codec=codec,\n                policy=policy,\n                registry=registry,\n                max_history=max_history,\n                max_positions=max_positions,\n                expected_split=episode.lineage.frozen_split,\n            )\n            counts[episode.lineage.frozen_split] += 1\n        return {\n            \"schema\": \"semantic-stage-supply/8\",\n            \"registryDigest\": policy[\"registryDigest\"],\n            \"episodes\": counts,\n            \"optimizerSteps\": 0,\n        }\n\n\ndef preflight_semantic_training_v8(roots, *, codec, policy, max_history=None, max_positions=None):\n    \"\"\"Detect V8 rows and fail closed on missing, stale, or mismatched admission.\"\"\"\n    from megatoken.data import PreparedCorpus\n\n    with PreparedCorpus(roots, split=None) as corpus:\n        receipts = [\n            receipt for part in corpus.parts for receipt in part.manifest.get(\"sources\", [])\n        ]\n        has_v8_receipt = any(\n            receipt.get(\"schema\") == \"semantic-preparation/8\" for receipt in receipts\n        )\n        semantic_schemas = set()\n        for episode in corpus.iter_episodes():\n            semantic = json.loads(episode.supervision.annotations_json).get(\"semantic_execution\")\n            if semantic is not None:\n                semantic_schemas.add(semantic.get(\"schema\"))\n        corpus_codec_fingerprint = corpus.codec_fingerprint\n\n    if policy is None:\n        if has_v8_receipt or \"semantic-execution/8\" in semantic_schemas:\n            raise ValueError(\"V8 semantic rows require an explicit pinned training policy\")\n        return None\n\n    policy = validate_semantic_training_policy_v8(policy)\n    if semantic_schemas - {\"semantic-execution/8\"}:\n        raise ValueError(\"V8 training cannot include semantic rows with an older or unknown schema\")\n    if not has_v8_receipt or \"semantic-execution/8\" not in semantic_schemas:\n        raise ValueError(\"V8 training policy requires matching V8 prepared semantic rows\")\n    if corpus_codec_fingerprint != codec.fingerprint:\n        raise ValueError(\"Corpus and training codec differ\")\n    return validate_prepared_semantic_v8(\n        roots,\n        codec=codec,\n        policy=policy,\n        max_history=max_history,\n        max_positions=max_positions,\n    )\n"}
2026-11-22T05:32:06.1689391Z FORMATTED_SOURCE_JSON {"path": "src/megatoken/training/engine.py", "content": "\"\"\"A single optimizer engine for bootstrap through student-state distillation.\n\nWindows are independent optimizer transactions: reconstruct the actual prefix\nunder current weights, retain gradients through selected writer/reader records,\nand discard all runtime state after updating parameters. No stale cache survives\nan update.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport shutil\nimport signal\nimport sys\nimport time\nfrom dataclasses import asdict\nfrom pathlib import Path\nfrom typing import Any\n\nimport torch\n\nfrom megatoken.contracts import ROLE_TO_ID\nfrom megatoken.controls import build_control_payload\nfrom megatoken.data import PreparedCorpus, stage_recipe\nfrom megatoken.data.chunking import ChunkingConfig\nfrom megatoken.data.media_assets import MediaRecord\nfrom megatoken.io import content_hash, sha256_file, write_json\nfrom megatoken.loading import (\n    build_model,\n    load_codec,\n    load_model_config,\n    parameter_report,\n    restore_weights,\n)\nfrom megatoken.model import ModelConfig\nfrom megatoken.runtime import capture_rng, doctor, restore_rng, seed_everything\nfrom megatoken.teacher import PINNED_TEACHER\nfrom megatoken.tensors import byte_tensor\nfrom megatoken.training.autoencode import (\n    AutoencodePlan,\n    FeatureSampler,\n    autoencode_losses,\n    embedding_center,\n)\nfrom megatoken.training.checkpoint import (\n    CheckpointWriter,\n    commit_checkpoint,\n    load_checkpoint,\n    resolve_checkpoint,\n    snapshot_to_cpu,\n    stage_checkpoint,\n    transducer_attachment,\n)\nfrom megatoken.training.config import DEFAULT_LOSS_WEIGHTS, TrainConfig\nfrom megatoken.training.diloco_client import DecoupledWorker\nfrom megatoken.training.diloco_protocol import training_identity\nfrom megatoken.training.distributed import DistributedContext\nfrom megatoken.training.heldout import HeldOutEvaluator\nfrom megatoken.training.history import NativeHistory\nfrom megatoken.training.losses import LossLedger\nfrom megatoken.training.media_dependencies import (\n    required_media_modalities,\n    validate_media_realizers,\n)\nfrom megatoken.training.meridians import (\n    MeridianPreparedBatch,\n    forward_meridian_batch,\n    prepare_meridian_batch,\n)\nfrom megatoken.training.metrics import (\n    Counters,\n    JsonlLogger,\n    dispatch_summary,\n    materialize_scalars,\n    rates,\n)\nfrom megatoken.training.optimizer import MasterAdamW\nfrom megatoken.training.retrieval import close_mounted\nfrom megatoken.training.router_balance import RouterBalanceWindow, balance_routers\nfrom megatoken.training.stream import (\n    EpisodeWindow,\n    IndependentWindowStream,\n    MixtureWindowStream,\n    WindowStream,\n)\nfrom megatoken.training.transducer import TransducerTrainer\nfrom megatoken.training.transducer_sync import (\n    RankRounds,\n    TransducerSync,\n    install_published,\n    resume_transducer,\n)\nfrom megatoken.training.windows import window_config\n\n\ndef ingest_records(\n    model: Any, state: Any, records: list[Any], device: torch.device, *, encoder_grad: bool = True\n):\n    payloads = [record.payload for record in records]\n    ids, lengths = byte_tensor(payloads, device)\n    roles = torch.tensor([ROLE_TO_ID[record.record.role] for record in records], device=device)\n    return model.core.observe(\n        ids, state, lengths=lengths, role_ids=roles, encoder_grad=encoder_grad\n    )\n\n\ndef episode_control_payload(episode: Any) -> bytes:\n    # Controls have explicit provenance and are never constructed from a\n    # matching target or a hidden verifier annotation.\n    return build_control_payload(\n        seed=episode.control_seed,\n        reference=episode.control_reference,\n        reference_origin=episode.reference_origin,\n        tools_json=episode.tools_json,\n    )\n\n\ndef prepare_batches(\n    model: Any, windows: list[EpisodeWindow], config: TrainConfig\n) -> list[MeridianPreparedBatch]:\n    \"\"\"Only native grouped-meridian episodes are valid training examples.\n\n    Earlier ungrouped/action fallback batching is removed, rather than silently\n    applying a different loss/history schedule.\n    \"\"\"\n    result: list[MeridianPreparedBatch] = []\n    verified_streams = {\n        \"verified_trajectories\",\n        \"verified_successful_multiturn\",\n        \"tested_artifacts\",\n        \"successful_replay\",\n        \"long_verified_dependencies\",\n        \"semantic_execution\",\n    }\n    for item in windows:\n        episode = item.episode\n        semantic_version = (\n            json.loads(episode.supervision.annotations_json)\n            .get(\"semantic_execution\", {})\n            .get(\"schema\")\n        )\n        if episode.stream == \"semantic_execution\":\n            if semantic_version not in {\n                \"semantic-execution/6\",\n                \"semantic-execution/7\",\n                \"semantic-execution/8\",\n            }:\n                raise ValueError(\"Semantic training rejects a missing or unknown execution schema\")\n            if semantic_version == \"semantic-execution/6\" and config.semantic_experiment is None:\n                raise ValueError(\"V6 semantic training requires its explicit admission policy\")\n        if semantic_version == \"semantic-execution/7\":\n            from .semantic_v7 import validate_semantic_episode_v7\n\n            if config.semantic_experiment is not None:\n                raise ValueError(\"V7 data cannot use a historical semantic experiment contract\")\n            validate_semantic_episode_v7(\n                episode,\n                codec=model.codec,\n                policy=config.semantic_v7_policy,\n                max_history=model.config.max_history_chunks,\n                max_positions=model.config.max_capacity,\n            )\n        elif semantic_version == \"semantic-execution/8\":\n            from .semantic_v8 import validate_semantic_episode_v8\n\n            if config.semantic_experiment is not None or config.semantic_v7_policy is not None:\n                raise ValueError(\"V8 data cannot use an older semantic training contract\")\n            registry_path = next(\n                (\n                    Path(root) / \"semantic-v8-families.json\"\n                    for root in config.datasets\n                    if (Path(root) / \"semantic-v8-families.json\").is_file()\n                ),\n                None,\n            )\n            if registry_path is None:\n                raise ValueError(\"V8 training root lost its frozen source-family registry\")\n            registry = json.loads(registry_path.read_text())\n            validate_semantic_episode_v8(\n                episode,\n                codec=model.codec,\n                policy=config.semantic_v8_policy,\n                registry=registry,\n                max_history=model.config.max_history_chunks,\n                max_positions=model.config.max_capacity,\n                expected_split=episode.lineage.frozen_split,\n            )\n        elif episode.stream == \"semantic_execution\" and (\n            config.semantic_v8_policy is not None or config.semantic_v7_policy is not None\n        ):\n            raise ValueError(\"Selected semantic policy does not accept this execution schema\")\n        elif config.semantic_experiment is not None:\n            from .semantic_budget import validate_semantic_episode, validate_semantic_geometry\n\n            validate_semantic_episode(\n                episode,\n                phase=config.phase,\n                representation=config.semantic_experiment[\"representation\"],\n            )\n            validate_semantic_geometry(\n                episode,\n                max_history=model.config.max_history_chunks,\n                max_positions=model.config.max_capacity,\n            )\n        if not episode.meridians:\n            raise ValueError(\n                \"Training requires causal native meridians; reprepare this old ungrouped episode\"\n            )\n        if any(\n            len(record.payload) > config.max_record_bytes\n            for record in (*item.window.prefix, *item.window.records)\n        ):\n            raise ValueError(\"A native record exceeds the configured original-byte limit\")\n        if (\n            not config.allow_unverified_data\n            and episode.stream in verified_streams\n            and not episode.supervision.verified_success\n            and semantic_version != \"semantic-execution/8\"\n        ):\n            raise ValueError(\"Training stream requires independent verified success\")\n        if episode.stream == \"long_verified_dependencies\" and not episode.dependencies:\n            raise ValueError(\"Long dependency stream requires causal source relationships\")\n        result.append(prepare_meridian_batch(model, item, NativeHistory.of(episode, model), config))\n    return result\n\n\ndef batch_counters(batches: list[MeridianPreparedBatch]) -> Counters:\n    result = Counters()\n    for batch in batches:\n        for item in batch.windows:\n            window = item.window\n            prefix_tokens = sum(record.tokens for record in window.prefix)\n            new_tokens = sum(record.tokens for record in window.records)\n            result.add(\n                Counters(\n                    D=new_tokens,\n                    I=new_tokens + prefix_tokens,\n                    G=len(window.records),\n                    Q=window.Q,\n                    source_bytes=sum(\n                        len(record.payload) for record in (*window.prefix, *window.records)\n                    ),\n                    record_ingestions=len(window.prefix) + len(window.records),\n                    reconstruction_tokens=prefix_tokens,\n                    reconstruction_records=len(window.prefix),\n                    scored_windows=int(bool(window.Q)),\n                    writer_reader_windows=int(bool(window.writer_reader_pairs)),\n                )\n            )\n        for step in batch.steps:\n            for modality, record in zip(step.modalities, step.records, strict=True):\n                if modality not in {\"audio\", \"image\", \"video\"}:\n                    continue\n                result.media_events += 1\n                geometry = MediaRecord.from_bytes(record.payload).output_geometry\n                if geometry is None:\n                    continue  # observed media: no physical output is realized\n                if modality == \"audio\":\n                    result.audio_samples += geometry.sample_count\n                elif modality == \"video\":\n                    result.video_frames += geometry.frames\n                else:\n                    result.image_events += 1\n        result.P += sum(plan.scored_positions for step in batch.steps for plan in step.plans)\n        result.facet_encodes += sum(len(step.plans) for step in batch.steps)\n        if batch.native_history.has_events:\n            for step in (*batch.prefix, *batch.steps):\n                for cursor in step.offsets:\n                    result.raw_facet_replays += len(\n                        batch.native_history.events_for_record(\n                            cursor,\n                            include_record=False,\n                        )\n                    ) + int(batch.native_history.paired_tape(cursor) is not None)\n        if any(episode_control_payload(item.episode) for item in batch.windows):\n            result.control_encodes += sum(len(step.plans) for step in batch.steps)\n    return result\n\n\n# The decoupled settings that change what a resumed learner computes. Where the\n# coordinator listens, timeouts, polling and storage do not.\n_DECOUPLED_IDENTITY = (\"run_id\", \"workers\", \"local_steps\", \"wire_dtype\")\n\n\ndef _resume_compatible(old: dict[str, Any], config: TrainConfig, phase_transition: bool) -> None:\n    current = asdict(config)\n    for state in (old, current):\n        decoupled = state.get(\"decoupled\")\n        state[\"decoupled\"] = (\n            None if decoupled is None else {key: decoupled[key] for key in _DECOUPLED_IDENTITY}\n        )\n    critical = (\n        \"purpose\",\n        \"model\",\n        \"model_overrides\",\n        \"codec\",\n        \"precision\",\n        \"expert_backend\",\n        \"weight_decay\",\n        \"inner_optimizer\",\n        \"decoupled\",\n    )\n    if not phase_transition:\n        critical += (\n            \"phase\",\n            \"engram_import\",\n            \"engram_imports\",\n            \"datasets\",\n            \"seed\",\n            \"microbatch_episodes\",\n            \"max_history_tokens\",\n            \"max_window_records\",\n            \"scored_decisions\",\n            \"generated_capacity\",\n            \"accumulate_scored\",\n            \"accumulate_ingested\",\n            \"accumulate_events\",\n            \"max_accumulation_windows\",\n            \"max_media_events_per_window\",\n            \"max_record_bytes\",\n            \"use_stage_mixture\",\n            \"use_effort_mixture\",\n            \"effort\",\n            \"loss_weights\",\n            \"grad_clip\",\n            \"budget\",\n            \"deterministic\",\n            \"gradient_checkpointing\",\n            \"representation_mode\",\n            \"router_balance_mode\",\n            \"trainable\",\n            \"text_anchors\",\n            \"text_anchor_weight\",\n            \"hindsight_targets\",\n            \"hindsight_distill_weight\",\n            \"semantic_experiment\",\n            \"semantic_v7_policy\",\n        )\n    # Keep the active V8 policy and registry binding fixed across resume.\n    critical += (\"semantic_v8_policy\",)\n    for key in critical:\n        if key not in old or old[key] != current[key]:\n            raise ValueError(\n                f\"Resume configuration changed {key}; use an explicit phase transition \"\n                \"only when the architecture/codec are unchanged\"\n            )\n\n\ndef train(\n    config: TrainConfig, *, resume: str | None = None, phase_transition: bool = False\n) -> dict[str, Any]:\n    from megatoken.data.recipes import validate_training_donors\n\n    if config.semantic_experiment:\n        from megatoken.training.semantic_budget import (\n            SemanticExperimentConfig,\n            SemanticExposure,\n            restore_semantic_training_state,\n            semantic_training_state,\n        )\n\n        experiment = SemanticExperimentConfig(**config.semantic_experiment)\n        cohort_digest = experiment.preflight(phase=config.phase)\n    else:\n        SemanticExposure = None\n        experiment = cohort_digest = None\n\n        def restore_semantic_training_state(payload, *, cohort_digest):\n            if cohort_digest is not None:\n                raise ValueError(\"A semantic cohort requires its experiment exposure state\")\n            if {\"semantic_exposure\", \"semantic_cohort_digest\"}.intersection(payload):\n                raise ValueError(\n                    \"A nonsemantic checkpoint cannot contain semantic experiment state\"\n                )\n            return None\n\n        def semantic_training_state(exposure, *, cohort_digest):\n            if exposure is not None or cohort_digest is not None:\n                raise ValueError(\"A nonsemantic run cannot retain semantic experiment state\")\n            return {}\n\n    validate_training_donors(config)\n    if phase_transition and not resume:\n        raise ValueError(\"A phase transition requires the previous phase's checkpoint\")\n    if config.decoupled is not None and (\n        int(os.environ.get(\"WORLD_SIZE\", \"1\")) != 1\n        or (torch.distributed.is_available() and torch.distributed.is_initialized())\n    ):\n        raise ValueError(\n            \"Decoupled learners require one independent process per sandbox, not torchrun\"\n        )\n    context = DistributedContext.initialize(config.device)\n    if experiment is not None and context.world_size != 1:\n        context.close()\n        raise ValueError(\"Semantic experiment budgets require one explicitly metered native rank\")\n    output = Path(config.output)\n    if config.decoupled is not None:\n        output = output / f\"worker-{config.decoupled.resolved_worker_id:02d}\"\n    checkpoint_store = None\n    if config.decoupled is not None and config.decoupled.checkpoint_s3:\n        from megatoken.training.diloco_storage import CheckpointStore\n\n        checkpoint_store = CheckpointStore(\n            config.decoupled.checkpoint_s3,\n            config.decoupled.run_id,\n            config.decoupled.resolved_worker_id,\n        )\n        if resume is None:\n            restored = checkpoint_store.restore(output / \"checkpoints\")\n            if restored is not None:\n                resume = str(restored)\n    logger = JsonlLogger(output / \"metrics.jsonl\", context.is_primary)\n    diloco = None\n    checkpoint_writer = None\n    optimizer = None\n    transducer = None\n    dataset = stream = heldout = teacher_targets = None\n    old_handlers = {}\n    stop_requested = False\n\n    def request_stop(signum, frame):\n        nonlocal stop_requested\n        stop_requested = True\n\n    try:\n        diagnostics = doctor(\n            require_cuda=context.device.type == \"cuda\",\n            require_blackwell=config.require_blackwell,\n            probe_cuda=context.device.type == \"cuda\",\n        )\n        if not diagnostics[\"ok\"]:\n            raise RuntimeError(\"Runtime preflight failed: \" + \"; \".join(diagnostics[\"errors\"]))\n        if config.codec == \"byte\" and config.model != \"tiny\" and not config.allow_byte_codec:\n            raise ValueError(\n                \"Large runs require the pinned raw codec; allow_byte_codec is only an explicit experiment\"\n            )\n        if context.device.type == \"cpu\":\n            torch.set_num_threads(min(4, torch.get_num_threads()))\n        seed_everything(config.seed, config.deterministic)\n        overrides = {\n            **config.model_overrides,\n            \"expert_backend\": config.expert_backend,\n            \"checkpoint_stages\": config.gradient_checkpointing,\n        }\n        model_config = load_model_config(config.model, **overrides)\n        if config.generated_capacity > model_config.max_capacity:\n            raise ValueError(\"generated_capacity exceeds the model's maximum output positions\")\n        if config.semantic_v8_policy is not None:\n            from .semantic_v8 import load_semantic_v8_codec\n\n            codec = load_semantic_v8_codec(config.codec, vocab_size=model_config.vocab_size)\n        else:\n            codec = load_codec(config.codec, vocab_size=model_config.vocab_size)\n        # Reject absent or causally unverified curriculum supply before loading\n        # model weights, donor pipelines, optimizer masters or checkpoint tensors.\n        windows_config = window_config(config)\n        dataset = PreparedCorpus(config.datasets)\n        if dataset.codec_fingerprint != codec.fingerprint:\n            raise ValueError(\"Prepared datasets use a different codec\")\n        has_v7 = any(\n            receipt.get(\"schema\") == \"semantic-preparation/7\"\n            for part in dataset.parts\n            for receipt in part.manifest.get(\"sources\", [])\n        )\n        if has_v7 or config.semantic_v7_policy is not None:\n            from .semantic_v7 import (\n                validate_prepared_semantic_v7,\n                validate_semantic_training_policy_v7,\n            )\n\n            v7_policy = validate_semantic_training_policy_v7(config.semantic_v7_policy)\n            v7_supply = validate_prepared_semantic_v7(\n                config.datasets,\n                codec=codec,\n                producer_revision=v7_policy[\"producerRevision\"],\n                consumer_revision=v7_policy[\"consumerRevision\"],\n                max_history=model_config.max_history_chunks,\n                max_positions=model_config.max_capacity,\n            )\n            if v7_supply[\"registryDigest\"] != v7_policy[\"registryDigest\"]:\n                raise ValueError(\n                    \"V7 prepared data differs from the explicitly frozen training registry\"\n                )\n        from .semantic_v8 import preflight_semantic_training_v8\n\n        preflight_semantic_training_v8(\n            config.datasets,\n            codec=codec,\n            policy=config.semantic_v8_policy,\n            max_history=model_config.max_history_chunks,\n            max_positions=model_config.max_capacity,\n        )\n        if experiment is not None:\n            from .semantic_budget import validate_stage_supply\n\n            engineering = json.loads(Path(experiment.engineering_receipt).read_text())\n            validate_stage_supply(\n                config.datasets,\n                phase=config.phase,\n                representation=experiment.representation,\n                codec=codec,\n                producer_revision=engineering[\"repositories\"][\"tracing-js-self\"],\n                consumer_revision=engineering[\"repositories\"][\"megatoken\"],\n                max_history=model_config.max_history_chunks,\n                max_positions=model_config.max_capacity,\n            )\n        if dataset.extractor not in (None, model_config.media_extractor):\n            raise ValueError(\n                f\"Prepared features come from teacher {dataset.extractor!r}, \"\n                f\"not this model's {model_config.media_extractor!r}\"\n            )\n        from megatoken.data.hindsight import HindsightTargets\n\n        teacher_targets = (\n            HindsightTargets(\n                config.hindsight_targets,\n                config=config,\n                codec=codec,\n                value_dim=model_config.transducer_geometry.value_dim,\n            )\n            if config.hindsight_targets\n            else None\n        )\n        if teacher_targets is not None:\n            teacher_targets.validate_corpus(dataset.identity)\n        recipe = stage_recipe(config.phase)\n        plan = AutoencodePlan.from_stage(recipe.constraints)\n        if config.use_stage_mixture:\n            from megatoken.data.coverage import require_coverage\n            from megatoken.data.recipes import STREAM_PRODUCERS\n\n            active_streams = recipe.mixture\n            missing = [\n                name\n                for name, weight in active_streams.items()\n                if weight > 0\n                and not any(\n                    part.manifest[\"counts\"].get(f\"split:train|stream:{name}\", 0)\n                    for part in dataset.parts\n                )\n            ]\n            if missing:\n                raise ValueError(\n                    f\"Stage {config.phase} has empty required training streams: {missing}\"\n                )\n            requirements = recipe.constraints.get(\"required_behaviors\", {})\n            require_coverage(dataset, requirements, active_streams)\n            if requirements:\n                with PreparedCorpus(config.datasets, split=\"validation\") as validation:\n                    require_coverage(validation, requirements, active_streams, split=\"validation\")\n                    missing = [\n                        name\n                        for name in STREAM_PRODUCERS\n                        if active_streams.get(name, 0) > 0\n                        and not any(\n                            part.manifest[\"counts\"].get(f\"split:validation|stream:{name}\", 0)\n                            for part in validation.parts\n                        )\n                    ]\n                    if missing:\n                        raise ValueError(\n                            f\"Stage {config.phase} has empty required validation streams: {missing}\"\n                        )\n        else:\n            active_streams = {\n                scope.removeprefix(\"stream:\")\n                for part in dataset.parts\n                for scope in part.manifest[\"counts\"]\n                if scope.startswith(\"stream:\")\n            }\n        required = required_media_modalities(\n            dataset,\n            dataset.scored_media_modalities(tuple(active_streams)),\n            autoencode_items=plan.items if config.use_stage_mixture else 0,\n        )\n        if required:\n            from megatoken.io import read_mapping\n\n            installed = {} if config.packs is None else read_mapping(config.packs).get(\"packs\", {})\n            pack_names = {\"audio\": \"pocket\", \"image\": \"sana\", \"video\": \"sana_video\"}\n            missing = [kind for kind in required if pack_names[kind] not in installed]\n            if missing:\n                raise ValueError(\n                    f\"Active training objectives need installed media packs for: {', '.join(missing)}\"\n                )\n        packs_fingerprint = sha256_file(config.packs) if config.packs else None\n        payload = None\n        if resume:\n            payload, resumed_metadata = load_checkpoint(resume, map_location=\"cpu\")\n            from megatoken.semantic_lineage_v8 import checkpoint_lineage_v8\n\n            checkpoint_lineage_v8(payload, resumed_metadata)\n            _resume_compatible(payload[\"train_config\"], config, phase_transition)\n            if payload[\"codec_fingerprint\"] != codec.fingerprint:\n                raise ValueError(\"Checkpoint codec identity differs\")\n            declared_model = ModelConfig.from_dict(payload[\"model_config\"])\n            # A named preset is a convenience for NEW runs. Its defaults may\n            # evolve while a long-running experiment is executing. The saved\n            # model geometry remains authoritative on restart; explicit caller\n            # overrides must still agree exactly with that declaration.\n            declared_values = declared_model.to_dict()\n            if any(\n                declared_values.get(key) != model_config.to_dict().get(key) for key in overrides\n            ):\n                raise ValueError(\"Checkpoint model configuration differs from explicit overrides\")\n            model_config = declared_model\n        model = build_model(\n            model_config,\n            codec,\n            device=context.device,\n            precision=config.precision,\n            packs=config.packs,\n        )\n        new_owners: tuple[str, ...] = ()\n        if payload is not None:\n            # Dynamic temporary imports must be restored before optimizer owner\n            # enumeration, or their FP32 masters and hooks would be missing.\n            new_owners = restore_weights(\n                model, payload, packs_fingerprint, phase_transition=phase_transition\n            )\n        from megatoken.assets import install_configured_imports\n\n        new_owners += install_configured_imports(\n            model, config, resumed=bool(resume), phase_transition=phase_transition\n        )\n        # Check decoder requirements before enumerating optimizer owners. This\n        # catches a missing pack at startup while leaving media observations\n        # that only feed text prediction usable without a decoder.\n        validate_media_realizers(model, required)\n        # Synchronous ranks are learners of one canonical bank merged on rank 0.\n        transducer = TransducerTrainer(\n            model.transducer,\n            teacher_targets=teacher_targets,\n            bank_trainable=config.trainable == \"all\",\n            teacher_weight=config.hindsight_distill_weight,\n            navigation_weight=config.navigation_weight,\n            navigation_examples=config.navigation_examples,\n            navigation_negatives=config.navigation_negatives,\n            worker=config.decoupled.resolved_worker_id if config.decoupled else context.rank,\n            provisional=config.decoupled is not None or context.world_size > 1,\n        )\n        rank_rounds = None\n        if context.world_size > 1:\n            rank_rounds = RankRounds(transducer, context)\n        if resume:\n            resume_transducer(\n                transducer,\n                rank_rounds,\n                resolve_checkpoint(resume),\n                allow_target_transition=phase_transition,\n            )\n        context.broadcast_model(model)\n        phase = config.schedule\n        optimizer = MasterAdamW(\n            model,\n            phase.learning_rate(0),\n            config.weight_decay,\n            inner_optimizer=config.inner_optimizer,\n        )\n        if config.trainable == \"media_bridge\":\n            # Every DiLoCo worker freezes the same owners, so their deltas are\n            # exactly zero everywhere and the outer merge stays unbiased.\n            bridge = {id(parameter) for parameter in model.media_bridge_parameters()}\n            optimizer.freeze(\n                [name for name, p in optimizer.model_parameters.items() if id(p) not in bridge]\n            )\n        elif config.trainable == \"latent_policy\":\n            from .outcome import latent_policy_parameter_ids\n\n            policy = latent_policy_parameter_ids(model)\n            optimizer.freeze(\n                [name for name, p in optimizer.model_parameters.items() if id(p) not in policy]\n            )\n        # Shape-harmonized expert banks are one global owner used by many\n        # routed sites. Keep their gradients in one clipping domain rather than\n        # letting a bank's contribution be multiplied by its number of uses.\n        # During media-bridge training those global owners remain frozen; only\n        # media-local gains, biases, norms and realizer conditions train.\n        shared_parameters = getattr(model.core, \"shared_parameters\", None)\n        shared_ids = (\n            {id(parameter) for parameter in shared_parameters()}\n            if shared_parameters is not None\n            else set()\n        )\n        encoder_ids = (\n            {id(parameter) for parameter in model.core.encoder_parameters()}\n            if config.representation_training == \"recurrent\" and config.trainable != \"media_bridge\"\n            else set()\n        ) - shared_ids\n        owned_ids = {id(parameter) for parameter in optimizer.model_parameters.values()}\n        # A module may expose shared/frozen tensors that have never been optimizer\n        # owners (for example inference-only buffers). Only optimizer-owned tensors\n        # belong in clipping partitions.\n        shared_ids &= owned_ids\n        encoder_ids &= owned_ids\n        if shared_ids or encoder_ids:\n            domains: dict[str, list[str]] = {}\n            if shared_ids:\n                shared_names = [\n                    name\n                    for name, parameter in optimizer.model_parameters.items()\n                    if id(parameter) in shared_ids\n                ]\n                if shared_names:\n                    domains[\"shared\"] = shared_names\n            if encoder_ids:\n                encoder_names = [\n                    name\n                    for name, parameter in optimizer.model_parameters.items()\n                    if id(parameter) in encoder_ids\n                ]\n                if encoder_names:\n                    domains[\"encoder\"] = encoder_names\n            excluded = shared_ids | encoder_ids\n            model_names = [\n                name\n                for name, parameter in optimizer.model_parameters.items()\n                if id(parameter) not in excluded\n            ]\n            if model_names:\n                domains[\"model\"] = model_names\n            # `set_gradient_domains` requires a partition of optimizer owners.\n            # It also ensures the global pools are represented exactly once.\n            optimizer.set_gradient_domains(domains)\n        text_anchors = None\n        if config.text_anchors:\n            from megatoken.training.text_anchors import TextAnchors\n\n            text_anchors = TextAnchors(\n                config.text_anchors, dataset.stores, extractor=model_config.media_extractor\n            )\n        sampler = center = None\n        if config.use_stage_mixture and plan.items:\n            sampler = FeatureSampler(\n                dataset,\n                seed=config.seed,\n                worker=config.decoupled.resolved_worker_id if config.decoupled else context.rank,\n            )\n            if not sampler:\n                raise ValueError(\n                    f\"Stage {config.phase} trains encode-and-reconstruct on prepared \"\n                    \"feature items, but the datasets have none\"\n                )\n            center = embedding_center(sampler).to(context.device)\n        chunking = ChunkingConfig.from_identity(dataset.chunking, codec)\n        chunking_identity = chunking.identity(codec)\n        if (\n            payload is not None\n            and not phase_transition\n            and payload[\"chunking\"] != chunking_identity\n        ):\n            raise ValueError(\"Exact resume changed the semantic chunking policy\")\n        data_rank = config.decoupled.resolved_worker_id if config.decoupled else context.rank\n        data_world = config.decoupled.workers if config.decoupled else context.world_size\n        if config.use_stage_mixture:\n            mixture = stage_recipe(config.phase).mixture\n            from megatoken.data.coverage import require_coverage\n\n            require_coverage(\n                dataset,\n                stage_recipe(config.phase).constraints.get(\"required_behaviors\", {}),\n                mixture,\n            )\n            stream = MixtureWindowStream(\n                config.datasets,\n                codec,\n                windows_config,\n                mixture,\n                phase.meter,\n                seed=config.seed,\n                rank=data_rank,\n                world_size=data_world,\n                reduce_counts=context.sum_counts,\n                independent=config.decoupled is not None,\n            )\n        else:\n            stream = (\n                IndependentWindowStream(\n                    dataset,\n                    codec,\n                    windows_config,\n                    seed=config.seed,\n                    rank=data_rank,\n                    world_size=data_world,\n                )\n                if config.decoupled is not None\n                else WindowStream(\n                    dataset,\n                    codec,\n                    windows_config,\n                    seed=config.seed,\n                    rank=context.rank,\n                    world_size=context.world_size,\n                    reduce_counts=context.sum_counts,\n                )\n            )\n        if config.eval_every:\n            heldout = HeldOutEvaluator(config, codec, windows_config, require=True)\n        semantic_training_v8 = None\n        if config.semantic_v8_policy is not None:\n            from megatoken.semantic_lineage_v8 import build_training_lineage_v8\n\n            semantic_training_v8 = build_training_lineage_v8(\n                policy=config.semantic_v8_policy,\n                tokenizer_identity=codec.fingerprint,\n                prepared_manifests=[\n                    json.loads((root / \"manifest.json\").read_text())[\"fingerprint\"]\n                    for root in dataset.all_roots\n                ],\n                corpus_identity=dataset.identity,\n                stream_identity=stream.fingerprint,\n                chunking=chunking_identity,\n            )\n            if payload is not None and not phase_transition:\n                from megatoken.semantic_lineage_v8 import checkpoint_lineage_v8\n\n                if checkpoint_lineage_v8(payload, resumed_metadata) != semantic_training_v8:\n                    raise ValueError(\"V8 resume changed its admitted data or training stream\")\n        if config.decoupled is not None:\n            diloco = DecoupledWorker(\n                config.decoupled,\n                model_config=model_config.to_dict(),\n                codec_fingerprint=codec.fingerprint,\n                masters=optimizer.masters,\n                output=output / \"diloco\",\n                token_budget=phase.budget,\n                train_identity=training_identity(config),\n                dataset_fingerprint=dataset.identity,\n                semantic_v8_lineage=semantic_training_v8,\n                semantic_v8_policy=config.semantic_v8_policy,\n            )\n            diloco.attach_transducer(TransducerSync())\n            if payload is None:\n                diloco.bootstrap(model, optimizer)\n                # Start from the coordinator's canonical bank, not an empty one.\n                fetched = diloco.fetch_transducer(-1)\n                if fetched is not None:\n                    install_published(transducer, diloco.transducer, fetched[2], fetched[1])\n        global_step = 0\n        consumed = 0\n        counters = Counters()\n        exposure = SemanticExposure() if experiment is not None else None\n        if payload is not None:\n            optimizer.load_state_dict(payload[\"optimizer\"], new=new_owners)\n            if diloco is not None:\n                if phase_transition:\n                    raise ValueError(\"Start a new coordinator run for a phase transition\")\n                diloco.resume(payload[\"diloco\"], optimizer)\n            global_step = payload[\"global_step\"]\n            if not phase_transition:\n                if len(payload[\"rank_state\"]) != context.world_size:\n                    raise ValueError(\"Exact resume requires the checkpoint's rank count\")\n                rank_state = payload[\"rank_state\"][context.rank]\n                stream.load_state_dict(rank_state[\"cursor\"])\n                if (sampler is None) != (rank_state[\"autoencode\"] is None):\n                    raise ValueError(\"Exact resume changed the encode-and-reconstruct sampler\")\n                if sampler is not None:\n                    sampler.load_state_dict(rank_state[\"autoencode\"])\n                restore_rng(rank_state[\"rng\"])\n                consumed = payload[\"phase_consumed\"]\n                counters = Counters(**payload[\"counters\"])\n                exposure = restore_semantic_training_state(payload, cohort_digest=cohort_digest)\n            else:\n                seed_everything(config.seed + data_rank, config.deterministic)\n        else:\n            # Initialization is identical; sampling/exploration is rank-specific.\n            seed_everything(config.seed + data_rank, config.deterministic)\n        semantic_v8_target_exposure = None\n        if config.semantic_v8_policy is not None:\n            from .semantic_v8 import (\n                advance_semantic_v8_target_exposure,\n                merge_semantic_v8_target_exposures,\n                restore_semantic_v8_target_exposure,\n                semantic_v8_target_exposure_from_batches,\n                semantic_v8_target_exposure_report,\n                semantic_v8_target_step_summary,\n            )\n\n            registry_digest = config.semantic_v8_policy[\"registryDigest\"]\n            semantic_v8_target_exposure = restore_semantic_v8_target_exposure(\n                payload,\n                registry_digest=registry_digest,\n                global_step=global_step,\n                phase_transition=phase_transition,\n            )\n\n        if config.compile:\n            # Compile the reusable tensor operators, not Python action tapes,\n            # data cursors, or mutable runtime history management.\n            model.core.compile_kernels(mode=config.compile_mode)\n        model.train()\n        model.core.set_model_version(global_step)\n        if context.is_primary:\n            write_json(output / \"config.json\", asdict(config))\n            write_json(output / \"runtime.json\", diagnostics)\n            write_json(output / \"parameters.json\", parameter_report(model))\n            from megatoken.omni.accounting import resident_footprint\n\n            write_json(output / \"tensor-accounting.json\", resident_footprint(model, optimizer))\n        logger.log(\n            \"start\",\n            phase=phase.name,\n            budget=phase.budget,\n            meter=phase.meter,\n            world_size=data_world,\n            mode=\"decoupled_diloco\" if diloco is not None else \"synchronous\",\n            model=model_config.name,\n            served_parameters=parameter_report(model)[\"totals\"][\"served\"],\n        )\n        for signum in (signal.SIGTERM, signal.SIGINT):\n            old_handlers[signum] = signal.signal(signum, request_stop)\n        last_saved = global_step if resume and not phase_transition else -1\n        updates_this_run = 0\n\n        checkpoint_writer = CheckpointWriter()\n\n        memory_attachment = transducer_attachment(\n            (transducer if rank_rounds is None else rank_rounds).state_dict\n        )\n\n        def checkpoint(label: str, pinned: bool = False) -> str:\n            \"\"\"Snapshot at the step boundary; periodic writes overlap training.\n\n            Pinned (phase/run boundary, interrupt) checkpoints are durable on return.\n            \"\"\"\n            nonlocal last_saved\n            rank_state = context.all_gather_object(\n                {\n                    \"cursor\": stream.state_dict(),\n                    \"rng\": capture_rng(),\n                    \"autoencode\": None if sampler is None else sampler.state_dict(),\n                }\n            )\n            name = f\"{phase.name}-{global_step:09d}-{label}\"\n            if rank_rounds is not None:\n                rank_rounds.flush(global_step)\n            if context.is_primary:\n                # Bound host memory to one in-flight snapshot.\n                checkpoint_writer.wait()\n                root = output / \"checkpoints\"\n                staged = stage_checkpoint(root, name)\n                try:\n                    extra = memory_attachment(staged)\n                    payload = snapshot_to_cpu(\n                        {\n                            \"model\": model.state_dict(),\n                            \"optimizer\": optimizer.state_dict(),\n                            **({\"diloco\": diloco.state_dict()} if diloco is not None else {}),\n                            \"model_config\": model_config.to_dict(),\n                            \"train_config\": asdict(config),\n                            \"codec_fingerprint\": codec.fingerprint,\n                            \"packs_fingerprint\": packs_fingerprint,\n                            \"chunking\": chunking_identity,\n                            \"rank_state\": rank_state,\n                            \"global_step\": global_step,\n                            \"phase_consumed\": consumed,\n                            \"counters\": asdict(counters),\n                            **(\n                                {\"semantic_training_v8\": semantic_training_v8}\n                                if semantic_training_v8 is not None\n                                else {}\n                            ),\n                            **semantic_training_state(exposure, cohort_digest=cohort_digest),\n                            **(\n                                {\"semantic_v8_target_exposure\": semantic_v8_target_exposure}\n                                if semantic_v8_target_exposure is not None\n                                else {}\n                            ),\n                        }\n                    )\n                    metadata = {\n                        \"global_step\": global_step,\n                        \"phase\": phase.name,\n                        \"phase_consumed\": consumed,\n                        \"dataset_fingerprint\": stream.fingerprint,\n                        \"codec_fingerprint\": codec.fingerprint,\n                        \"packs_fingerprint\": packs_fingerprint,\n                        \"chunking_fingerprint\": chunking_identity[\"fingerprint\"],\n                        \"routing_version\": model_config.routing_version,\n                        \"config_fingerprint\": content_hash(asdict(config)),\n                        **(\n                            {\"semantic_v8_lineage_digest\": semantic_training_v8[\"digest\"]}\n                            if semantic_training_v8 is not None\n                            else {}\n                        ),\n                    }\n                    from .stream import source_sampling_report\n\n                    metadata[\"source_sampling\"] = source_sampling_report(\n                        [rank[\"cursor\"] for rank in rank_state]\n                    )\n                except BaseException:\n                    shutil.rmtree(staged, ignore_errors=True)\n                    raise\n\n                def write() -> None:\n                    commit_checkpoint(\n                        root,\n                        name,\n                        staged,\n                        payload,\n                        metadata,\n                        extra=extra,\n                        pinned=pinned,\n                        keep=config.keep_checkpoints,\n                    )\n                    if checkpoint_store is not None:\n                        checkpoint_store.upload(root / name, keep=config.keep_checkpoints)\n\n                checkpoint_writer.submit(write)\n                if pinned:\n                    checkpoint_writer.wait()\n            context.barrier()\n            last_saved = global_step\n            return str(output / \"checkpoints\" / name)\n\n        last_checkpoint = str(resolve_checkpoint(resume)) if resume else \"\"\n        if phase_transition:\n            last_checkpoint = checkpoint(\"phase-start\", pinned=True)\n        empty_selection_rounds = 0\n        while (\n            consumed < phase.budget\n            and (diloco is None or not diloco.finished)\n            and (config.max_steps is None or updates_this_run < config.max_steps)\n            and (experiment is None or not exposure.finished(experiment))\n        ):\n            started = time.perf_counter()\n            selected = []\n            selected_counts = {\"I\": 0, \"P\": 0, \"G\": 0, \"Q\": 0}\n            for _ in range(config.max_accumulation_windows):\n                for _ in range(config.microbatch_episodes):\n                    item = stream.next()\n                    if item is None:\n                        continue\n                    selected.append(item)\n                    selected_counts[\"I\"] += item.window.I\n                    selected_counts[\"G\"] += item.window.G\n                    selected_counts[\"Q\"] += item.window.Q\n                    # Main prediction CE and the byte-codec auxiliary are both\n                    # actually evaluated in bootstrap and recurrent modes.\n                    selected_counts[\"P\"] += item.window.P * 2\n                global_selected = context.sum_counts(selected_counts)\n                if (\n                    global_selected[\"P\"] >= config.accumulate_scored\n                    or global_selected[\"I\"] >= config.accumulate_ingested\n                    or (phase.meter == \"G\" and global_selected[\"G\"] >= config.accumulate_events)\n                    or (phase.meter == \"Q\" and global_selected[\"Q\"] >= config.accumulate_events)\n                ):\n                    break\n            weights = dict(config.loss_weights)\n            # The old per-operation router loss has been replaced.\n            weights[\"router_balance\"] = 0.0\n            preparation_error = None\n            local_target_exposure = None\n            try:\n                batches = prepare_batches(model, selected, config)\n                if semantic_v8_target_exposure is not None:\n                    local_target_exposure = semantic_v8_target_exposure_from_batches(\n                        batches,\n                        registry_digest=config.semantic_v8_policy[\"registryDigest\"],\n                        effective_loss_weights=weights,\n                    )\n            except Exception as error:\n                preparation_error = error\n                batches = []\n            rejected = context.sum_counts({\"rejected_batches\": int(preparation_error is not None)})\n            if rejected[\"rejected_batches\"]:\n                raise ValueError(\n                    \"Distributed target preparation failed: \"\n                    + str(\n                        preparation_error or \"another rank rejected its targets or native history\"\n                    )\n                ) from preparation_error\n            local_counts = {\n                key: sum(batch.counts[key] for batch in batches) for key in DEFAULT_LOSS_WEIGHTS\n            }\n            global_counts = context.sum_counts(local_counts)\n            anchor_local = (\n                0\n                if text_anchors is None\n                else sum(\n                    text_anchors.key(entry.payload) in text_anchors.assets\n                    for batch in batches\n                    for step in batch.steps\n                    for entry, modality in zip(step.records, step.modalities, strict=True)\n                    if modality == \"text\"\n                )\n            )\n            anchor_denom = context.sum_counts({\"text_anchors\": anchor_local})[\"text_anchors\"]\n            if not any(global_counts.values()):\n                empty_selection_rounds += 1\n                if empty_selection_rounds > max(1, len(dataset)):\n                    raise RuntimeError(\n                        \"A complete sampling pass contains no supervised decisions; audit role/turn masks\"\n                    )\n                logger.log(\"unscored_source_block\", skipped_rounds=empty_selection_rounds)\n                continue\n            empty_selection_rounds = 0\n            target_exposure_step = None\n            target_exposure_candidate = None\n            target_exposure_receipt = None\n            if semantic_v8_target_exposure is not None:\n                target_exposure_step = merge_semantic_v8_target_exposures(\n                    context.all_gather_object(local_target_exposure),\n                    registry_digest=config.semantic_v8_policy[\"registryDigest\"],\n                )\n                target_exposure_candidate = advance_semantic_v8_target_exposure(\n                    semantic_v8_target_exposure,\n                    target_exposure_step,\n                    optimizer_step=global_step + 1,\n                    registry_digest=config.semantic_v8_policy[\"registryDigest\"],\n                )\n                target_exposure_receipt = semantic_v8_target_exposure_report(\n                    target_exposure_candidate\n                )\n            global_work = Counters(**context.sum_counts(asdict(batch_counters(batches))))\n            global_work.validate()\n            ledger = LossLedger(local_counts, global_counts, weights)\n            # Per-window mean losses are divided by the windows of the whole transaction.\n            window_scale = 1.0 / max(1, context.sum_counts({\"windows\": len(batches)})[\"windows\"])\n            optimizer.zero_grad()\n            # Include core selectors and any routed sites owned by the\n            # training-only transducer heads; those sites still train the same\n            # globally shared expert pools.\n            routers = balance_routers(model)\n            router_replay = RouterBalanceWindow()\n            learning_rate = phase.learning_rate(\n                diloco.global_tokens if diloco is not None else consumed\n            )\n            optimizer.set_lr(learning_rate)\n            model.core.dispatch_metrics(reset=True)\n            step_diagnostics: dict[str, float | torch.Tensor] = {}\n            for router in routers.values():\n                router.balance_recorder = router_replay\n            try:\n                for batch in batches:\n                    diagnostics_batch = forward_meridian_batch(\n                        model,\n                        batch,\n                        ledger,\n                        config,\n                        context.device,\n                        global_step,\n                        text_anchors=(\n                            None\n                            if text_anchors is None\n                            else (text_anchors, anchor_denom, config.text_anchor_weight)\n                        ),\n                        transducer=transducer,\n                        window_scale=window_scale,\n                    )\n                    for key, value in diagnostics_batch.items():\n                        step_diagnostics[key] = step_diagnostics.get(key, 0.0) + value\n                ledger.finish()\n                # All ranks participate, including workers with zero eligible\n                # assignments. The model's version remains fixed until step().\n                step_diagnostics.update(\n                    router_replay.backward(\n                        context,\n                        routers=routers,\n                        coefficient=config.loss_weights[\"router_balance\"],\n                    )\n                )\n            finally:\n                for router in routers.values():\n                    router.balance_recorder = None\n            step_diagnostics.update(transducer.after_backward(global_step))\n            if sampler is not None:\n                terms = autoencode_losses(\n                    model,\n                    sampler.draw(plan.items),\n                    space_fingerprint=PINNED_TEACHER,\n                    center=center,\n                )\n                totals = context.sum_counts({name: count for name, (_, count) in terms.items()})\n                weights = {\n                    \"reconstruction\": plan.reconstruction_weight,\n                    \"embedding\": plan.embedding_weight,\n                }\n                loss = sum(\n                    weights[name] * value / totals[name]\n                    for name, (value, _) in terms.items()\n                    if totals[name]\n                )\n                loss.backward()\n                for name, (value, count) in terms.items():\n                    if count:\n                        step_diagnostics[f\"autoencode_{name}\"] = float(value.detach()) / count\n            context.synchronize_gradients(optimizer.parameters)\n            optimizer_started = time.perf_counter()\n            step_metrics = optimizer.step(config.grad_clip)\n            optimizer_seconds = time.perf_counter() - optimizer_started\n            global_step += 1\n            step_metrics.update(\n                transducer.barrier(global_step, evolve=diloco is None and rank_rounds is None)\n            )\n            if rank_rounds is not None:\n                step_metrics.update(rank_rounds.step(global_step))\n            updates_this_run += 1\n            consumed += getattr(global_work, phase.meter)\n            counters.add(global_work)\n            diloco_metrics = (\n                diloco.after_step(\n                    optimizer,\n                    steps=global_step,\n                    tokens=getattr(global_work, phase.meter),\n                    transducer=transducer,\n                )\n                if diloco is not None\n                else {}\n            )\n            ready = diloco_metrics.pop(\"transducer_ready\", None)\n            if ready is not None:\n                install_published(transducer, diloco.transducer, ready[2], ready[1])\n            if target_exposure_candidate is not None:\n                semantic_v8_target_exposure = target_exposure_candidate\n            model.core.set_model_version(global_step)\n            local_sums = ledger.sums\n            merged_sums = context.all_gather_object(local_sums)\n            sums = {\n                key: sum(values.get(key, 0.0) for values in merged_sums) for key in global_counts\n            }\n            if context.device.type == \"cuda\":\n                torch.cuda.synchronize(context.device)\n            elapsed = time.perf_counter() - started\n            if exposure is not None:\n                exposure.consume(\n                    **context.sum_counts(\n                        {\n                            \"examples\": sum(int(item.episode_end) for item in selected),\n                            \"generatedTokens\": sum(\n                                record.tokens\n                                for item in selected\n                                for record in item.window.records\n                                if record.record.policy_mask\n                            ),\n                            \"observedTokens\": sum(\n                                record.tokens\n                                for item in selected\n                                for record in item.window.records\n                                if not record.record.policy_mask\n                            ),\n                        }\n                    ),\n                    computeSeconds=elapsed,\n                )\n            if global_step % config.log_every == 0:\n                gathered = context.all_gather_object(materialize_scalars(step_diagnostics))\n                diagnostics_global = {\n                    key: sum(item.get(key, 0.0) for item in gathered)\n                    for key in set().union(*(item.keys() for item in gathered))\n                }\n                for branch in (\"prior\", \"reconstruction\"):\n                    positions = diagnostics_global.get(f\"{branch}_lexical_positions\", 0)\n                    if positions:\n                        diagnostics_global[f\"{branch}_lexical_ce\"] = (\n                            diagnostics_global[f\"{branch}_lexical_loss_sum\"] / positions\n                        )\n                examples = diagnostics_global.get(\"facet_examples\", 0)\n                if examples:\n                    for kind in (\"prediction\", \"encoded\"):\n                        diagnostics_global[f\"{kind}_facet_norm\"] = (\n                            diagnostics_global[f\"{kind}_facet_norm_sum\"] / examples\n                        )\n                coordinates = diagnostics_global.get(\"facet_alignment_coordinates\", 0)\n                if coordinates:\n                    # This distance is a diagnostic, not the recurrent encoder\n                    # objective: ordinary observations have no forecast label.\n                    diagnostics_global[\"forecast_encoder_distance_mse\"] = (\n                        diagnostics_global[\"facet_alignment_squared_error_sum\"] / coordinates\n                    )\n                for term, diagnostic in (\n                    (\"facet_prediction\", \"facet_kl_per_coordinate\"),\n                    (\"encoder_alignment\", \"native_encoder_alignment_mse\"),\n                ):\n                    if global_counts[term]:\n                        diagnostics_global[diagnostic] = sums[term] / global_counts[term]\n                dispatch = model.core.dispatch_metrics(reset=True)\n                reduced = context.sum_tensors(\n                    {\n                        f\"{family}/{key}\": value\n                        for family, values in dispatch.items()\n                        for key, value in values.items()\n                    }\n                )\n                dispatch = {\n                    family: {key: reduced[f\"{family}/{key}\"] for key in values}\n                    for family, values in dispatch.items()\n                }\n                logger.log(\n                    \"train\",\n                    global_step=global_step,\n                    phase=phase.name,\n                    phase_consumed=consumed,\n                    phase_meter=phase.meter,\n                    loss={k: sums[k] / v for k, v in global_counts.items() if v},\n                    denominators=global_counts,\n                    lr=learning_rate,\n                    decoupled=diloco.metrics() if diloco is not None else None,\n                    decoupled_step=diloco_metrics,\n                    counters=asdict(counters),\n                    step_counters=asdict(global_work),\n                    optimizer_seconds=optimizer_seconds,\n                    step_seconds=elapsed,\n                    peak_memory_bytes=torch.cuda.max_memory_allocated()\n                    if context.device.type == \"cuda\"\n                    else 0,\n                    batch_sizes=[len(batch.windows) for batch in batches],\n                    efforts=[batch.effort for batch in batches],\n                    generator=diagnostics_global,\n                    experts=dispatch_summary(dispatch),\n                    budget_overshoot=max(0, consumed - phase.budget),\n                    **semantic_training_state(exposure, cohort_digest=cohort_digest),\n                    **(\n                        {\n                            \"semantic_v8_target_exposure_step\": semantic_v8_target_step_summary(\n                                target_exposure_step\n                            ),\n                            \"semantic_v8_target_exposure_totals\": {\n                                key: target_exposure_receipt[key]\n                                for key in (\n                                    \"sourceCount\",\n                                    \"logicalTargetCount\",\n                                    \"physicalTargetRecordCount\",\n                                    \"scoredOccurrences\",\n                                    \"lossDenominators\",\n                                )\n                            },\n                        }\n                        if target_exposure_receipt is not None\n                        else {}\n                    ),\n                    **rates(global_work, elapsed),\n                    **step_metrics,\n                )\n            if (\n                config.eval_every\n                and global_step % config.eval_every == 0\n                and (diloco is None or config.decoupled.resolved_worker_id == 0)\n            ):\n                evaluation_started = time.perf_counter()\n                local, failure = {}, None\n                try:\n                    local = heldout.sums(\n                        model, transducer, global_step, rank=context.rank, world=context.world_size\n                    )\n                except Exception as error:\n                    failure = error\n                # A failing rank must not leave its peers waiting in the gather.\n                gathered = context.all_gather_object(\n                    (local, None if failure is None else str(failure))\n                )\n                if any(message for _, message in gathered):\n                    raise RuntimeError(\n                        \"Held-out evaluation failed: \" + next(m for _, m in gathered if m)\n                    ) from failure\n                logger.log(\n                    \"evaluation\",\n                    global_step=global_step,\n                    phase=phase.name,\n                    phase_consumed=consumed,\n                    evaluation_seconds=time.perf_counter() - evaluation_started,\n                    **heldout.report([sums for sums, _ in gathered]),\n                )\n            if transducer.switch_due(global_step):\n                heldout = heldout or HeldOutEvaluator(config, codec, windows_config, require=False)\n                loss = heldout.bank_only_loss(model, transducer, global_step)\n                if rank_rounds is not None:\n                    rank_rounds.record_validation(global_step, loss)\n                elif diloco is None:\n                    if transducer.record_validation(global_step, loss):\n                        logger.log(\"transducer_switch\", global_step=global_step)\n                elif config.decoupled.resolved_worker_id == 0:\n                    diloco.report_transducer_validation(global_step, loss)\n                logger.log(\"transducer_validation\", global_step=global_step, bank_only_loss=loss)\n                model.train()\n            if config.checkpoint_every and global_step % config.checkpoint_every == 0:\n                last_checkpoint = checkpoint(\"periodic\")\n            stops = context.sum_counts({\"stop\": int(stop_requested)})\n            if stops[\"stop\"]:\n                last_checkpoint = checkpoint(\"interrupted\", pinned=True)\n                break\n        if diloco is not None and not stop_requested and updates_this_run > 0:\n            # Hand the coordinator the last, partial window before the final checkpoint.\n            diloco.finish(optimizer, transducer)\n        if (updates_this_run > 0 and consumed >= phase.budget) or last_saved != global_step:\n            last_checkpoint = checkpoint(\n                \"phase-end\" if consumed >= phase.budget else \"run-end\", pinned=True\n            )\n        result = {\n            \"global_step\": global_step,\n            \"phase\": phase.name,\n            \"phase_consumed\": consumed,\n            \"complete\": consumed >= phase.budget or (diloco is not None and diloco.finished),\n            \"termination\": \"requested\"\n            if stop_requested\n            else \"budget\"\n            if consumed >= phase.budget\n            else \"step_limit\",\n            \"checkpoint\": last_checkpoint,\n            \"counters\": asdict(counters),\n            **semantic_training_state(exposure, cohort_digest=cohort_digest),\n            **(\n                {\n                    \"semantic_v8_target_exposure\": semantic_v8_target_exposure_report(\n                        semantic_v8_target_exposure\n                    )\n                }\n                if semantic_v8_target_exposure is not None\n                else {}\n            ),\n        }\n        if experiment is not None:\n            result[\"experiment_budget\"] = exposure.receipt(\n                experiment, seed=config.seed, checkpoint_identity=None, cohort_digest=cohort_digest\n            )\n            if exposure.finished(experiment):\n                result.update(complete=True, termination=\"experiment_budget\")\n        if context.is_primary:\n            from megatoken.omni.accounting import resident_footprint\n\n            write_json(output / \"tensor-accounting.json\", resident_footprint(model, optimizer))\n        logger.log(\"finished\", **result)\n        return result\n    finally:\n        for signum, handler in old_handlers.items():\n            signal.signal(signum, handler)\n        # Every resource is released even if an earlier close fails (a failed checkpoint\n        # write must not leave the optimizer, streams and coordinator session open, nor\n        # replace the error that ended the run); the first failure is raised at the end.\n        failures: list[BaseException] = []\n\n        def release(closer) -> None:\n            try:\n                closer()\n            except Exception as error:\n                failures.append(error)\n\n        if checkpoint_writer is not None:\n            # A periodic write still in flight must land before the run returns.\n            release(checkpoint_writer.close)\n        if diloco is not None:\n            release(diloco.close)\n        if optimizer is not None:\n            release(optimizer.close)\n        if stream is not None:\n            release(stream.close)\n        if heldout is not None:\n            release(heldout.close)\n        if teacher_targets is not None:\n            release(teacher_targets.close)\n        if dataset is not None:\n            release(dataset.close)\n        release(close_mounted)\n        release(context.close)\n        if failures and sys.exc_info()[0] is None:\n            raise failures[0]\n"}
2026-11-22T05:32:06.1836386Z FORMATTED_SOURCE_JSON {"path": "tests/test_semantic_v8_target_exposure.py", "content": "\"\"\"V8 optimizer-window exposure counts only loss-bearing native target occurrences.\"\"\"\n\nimport json\nfrom types import SimpleNamespace\n\nimport pytest\n\nfrom megatoken.training.semantic_v8 import (\n    advance_semantic_v8_target_exposure,\n    empty_semantic_v8_target_exposure,\n    merge_semantic_v8_target_exposures,\n    restore_semantic_v8_target_exposure,\n    semantic_v8_target_exposure_from_batches,\n    semantic_v8_target_exposure_report,\n    validate_semantic_v8_target_exposure,\n)\n\nREGISTRY = \"a\" * 64\nSOURCE = \"support-train-01\"\n\n\ndef _extract_v8(batches, *, registry_digest, effective_loss_weights=None):\n    if effective_loss_weights is None:\n        effective_loss_weights = {\"language_model\": 1.0, \"structure\": 1.0}\n    return semantic_v8_target_exposure_from_batches(\n        batches,\n        registry_digest=registry_digest,\n        effective_loss_weights=effective_loss_weights,\n    )\n\n\ndef _batch(\n    *,\n    split=\"train\",\n    registry=REGISTRY,\n    logical_id=\"semantic:target:one\",\n    record_id=\"physical-one\",\n    window_index=0,\n    denominators=None,\n    policy_mask=True,\n    include_target=True,\n):\n    physical = SimpleNamespace(\n        logical_id=logical_id,\n        record_id=record_id,\n        policy_mask=policy_mask,\n    )\n    encoded = SimpleNamespace(record=physical)\n    plans = (\n        [SimpleNamespace(denominators=denominators or {\"language_model\": 4})]\n        if include_target\n        else []\n    )\n    step = SimpleNamespace(records=[encoded], plans=plans, offsets=[0])\n    binding = {\"sourceId\": SOURCE, \"registryDigest\": registry, \"split\": split}\n    episode = SimpleNamespace(\n        stream=\"semantic_execution\",\n        lineage=SimpleNamespace(frozen_split=split),\n        supervision=SimpleNamespace(\n            annotations_json=json.dumps(\n                {\n                    \"semantic_execution\": {\n                        \"schema\": \"semantic-execution/8\",\n                        \"sourceId\": SOURCE,\n                        \"datasetBinding\": binding,\n                    }\n                }\n            )\n        ),\n    )\n    item = SimpleNamespace(episode=episode, window=SimpleNamespace(index=window_index))\n    return SimpleNamespace(windows=[item], steps=[step])\n\n\ndef test_overlapping_rank_windows_keep_unique_coverage_and_sum_scored_occurrences():\n    first = _extract_v8([_batch(window_index=2)], registry_digest=REGISTRY)\n    overlap = _extract_v8([_batch(window_index=5)], registry_digest=REGISTRY)\n    update = merge_semantic_v8_target_exposures([first, overlap], registry_digest=REGISTRY)\n    state = empty_semantic_v8_target_exposure(REGISTRY)\n    state = advance_semantic_v8_target_exposure(\n        state, update, optimizer_step=1, registry_digest=REGISTRY\n    )\n    report = semantic_v8_target_exposure_report(state)\n    record = state[\"sources\"][SOURCE][\"logicalTargets\"][\"semantic:target:one\"][\"records\"][\n        \"physical-one\"\n    ]\n    assert report[\"sourceCount\"] == 1\n    assert report[\"logicalTargetCount\"] == 1\n    assert report[\"physicalTargetRecordCount\"] == 1\n    assert report[\"scoredOccurrences\"] == 2\n    assert report[\"lossDenominators\"] == {\"language_model\": 8}\n    assert record[\"windowIndices\"] == [2, 5]\n    assert record[\"optimizerUpdates\"] == 1\n\n\ndef test_partial_masks_sum_across_ranks_without_claiming_extra_unique_targets():\n    first = _extract_v8([_batch(denominators={\"language_model\": 4})], registry_digest=REGISTRY)\n    second = _extract_v8([_batch(denominators={\"structure\": 2})], registry_digest=REGISTRY)\n    update = merge_semantic_v8_target_exposures([first, second], registry_digest=REGISTRY)\n    state = advance_semantic_v8_target_exposure(\n        empty_semantic_v8_target_exposure(REGISTRY),\n        update,\n        optimizer_step=1,\n        registry_digest=REGISTRY,\n    )\n    report = semantic_v8_target_exposure_report(state)\n    assert report[\"logicalTargetCount\"] == report[\"physicalTargetRecordCount\"] == 1\n    assert report[\"scoredOccurrences\"] == 2\n    assert report[\"lossDenominators\"] == {\"language_model\": 4, \"structure\": 2}\n\n\ndef test_resume_accumulates_the_same_target_and_retains_exact_step_state():\n    state = empty_semantic_v8_target_exposure(REGISTRY)\n    step = merge_semantic_v8_target_exposures(\n        [_extract_v8([_batch()], registry_digest=REGISTRY)],\n        registry_digest=REGISTRY,\n    )\n    first = advance_semantic_v8_target_exposure(\n        state, step, optimizer_step=1, registry_digest=REGISTRY\n    )\n    restored = validate_semantic_v8_target_exposure(first, registry_digest=REGISTRY)\n    second = advance_semantic_v8_target_exposure(\n        restored, step, optimizer_step=2, registry_digest=REGISTRY\n    )\n    target = second[\"sources\"][SOURCE][\"logicalTargets\"][\"semantic:target:one\"][\"records\"][\n        \"physical-one\"\n    ]\n    assert target[\"optimizerUpdates\"] == 2\n    assert target[\"scoredOccurrences\"] == 2\n    assert target[\"lossDenominators\"] == {\"language_model\": 8}\n    assert second[\"lastGlobalStep\"] == 2\n\n\n@pytest.mark.parametrize(\n    (\"split\", \"registry\"),\n    [(\"validation\", REGISTRY), (\"train\", \"b\" * 64)],\n)\ndef test_wrong_frozen_source_split_or_registry_refuses_exposure(split, registry):\n    with pytest.raises(ValueError, match=\"source, registry or split\"):\n        _extract_v8([_batch(split=split, registry=registry)], registry_digest=REGISTRY)\n\n\ndef test_zero_loss_or_observed_window_produces_no_target_exposure():\n    observed = _extract_v8([_batch(include_target=False)], registry_digest=REGISTRY)\n    zero_loss = _extract_v8([_batch(denominators={\"language_model\": 0})], registry_digest=REGISTRY)\n    assert observed[\"occurrences\"] == []\n    assert zero_loss[\"occurrences\"] == []\n\n\ndef test_unmasked_plan_and_out_of_order_resume_cannot_advance_exposure():\n    with pytest.raises(ValueError, match=\"outside the target mask\"):\n        _extract_v8([_batch(policy_mask=False)], registry_digest=REGISTRY)\n    state = empty_semantic_v8_target_exposure(REGISTRY)\n    update = merge_semantic_v8_target_exposures(\n        [_extract_v8([_batch()], registry_digest=REGISTRY)],\n        registry_digest=REGISTRY,\n    )\n    with pytest.raises(ValueError, match=\"next optimizer update\"):\n        advance_semantic_v8_target_exposure(\n            state, update, optimizer_step=2, registry_digest=REGISTRY\n        )\n\n\ndef test_v8_resume_fails_closed_if_census_is_missing_or_checkpoint_step_differs():\n    payload = {\n        \"train_config\": {\"semantic_v8_policy\": {\"registryDigest\": REGISTRY}},\n        \"semantic_v8_target_exposure\": None,\n    }\n    with pytest.raises(ValueError, match=\"missing its target-exposure history\"):\n        restore_semantic_v8_target_exposure(payload, registry_digest=REGISTRY, global_step=4)\n\n    state = empty_semantic_v8_target_exposure(REGISTRY, starting_global_step=2)\n    payload[\"semantic_v8_target_exposure\"] = state\n    with pytest.raises(ValueError, match=\"differs from checkpoint step\"):\n        restore_semantic_v8_target_exposure(payload, registry_digest=REGISTRY, global_step=4)\n\n\ndef test_non_v8_checkpoint_can_start_only_at_explicit_fresh_stage_boundary():\n    payload = {\n        \"train_config\": {\"semantic_v8_policy\": None},\n        \"semantic_v8_target_exposure\": None,\n    }\n    with pytest.raises(ValueError, match=\"fresh stage\"):\n        restore_semantic_v8_target_exposure(payload, registry_digest=REGISTRY, global_step=7)\n    state = restore_semantic_v8_target_exposure(\n        payload,\n        registry_digest=REGISTRY,\n        global_step=7,\n        phase_transition=True,\n    )\n    assert state[\"startingGlobalStep\"] == state[\"lastGlobalStep\"] == 7\n    assert state[\"optimizerUpdates\"] == 0\n\n\ndef test_positive_denominator_with_zero_objective_weight_is_not_counted():\n    exposure = _extract_v8(\n        [_batch(denominators={\"language_model\": 4, \"router_balance\": 8})],\n        registry_digest=REGISTRY,\n        effective_loss_weights={\"language_model\": 0.0, \"router_balance\": 1.0},\n    )\n    assert exposure[\"occurrences\"] == []\n"}
2026-11-22T05:32:06.1897534Z FORMATTED_SOURCE_JSON {"path": "tests/test_semantic_v8_training_lifecycle.py", "content": "\"\"\"Bounded normal-loader optimizer/checkpoint/resume smoke with injected audit boundaries.\"\"\"\n\nimport json\nimport multiprocessing\nimport os\nimport socket\nimport subprocess\nimport sys\nimport time\nimport urllib.error\nimport urllib.request\nfrom pathlib import Path\n\nimport pytest\nimport torch\nfrom test_semantic_v8_training_policy import pinned_tokenizer_path, prepared_v8_fixture\n\nfrom megatoken.generation.codec import ByteCodec\nfrom megatoken.training.checkpoint import load_checkpoint, save_checkpoint, transducer_attachment\nfrom megatoken.training.config import TrainConfig\nfrom megatoken.training.engine import train\n\n\ndef test_v8_normal_update_checkpoint_fresh_process_resume(tmp_path, monkeypatch):\n    torch.set_num_threads(1)\n    # The fixture constructs native V8 rows with explicitly injected source and\n    # tokenizer audit boundaries. The ordinary trainer, model, optimizer and\n    # checkpoint operations below execute normally.\n    prepared_v8_fixture(tmp_path)\n    prepared = tmp_path / \"prepared-v8\"\n    registry = json.loads((prepared / \"semantic-v8-families.json\").read_text())\n    manifest = json.loads((prepared / \"manifest.json\").read_text())\n    pins = manifest[\"sources\"][0]\n    policy = {\n        \"schema\": \"semantic-training-policy/8\",\n        \"producerRevision\": pins[\"producerRevision\"],\n        \"consumerRevision\": pins[\"consumerRevision\"],\n        \"registryDigest\": registry[\"digest\"],\n    }\n    import megatoken.training.semantic_v8 as semantic_v8\n\n    # The normal training loader still validates each\n    # manifest, source/native receipt, split, physical record and batch policy.\n    monkeypatch.setattr(\n        semantic_v8,\n        \"load_semantic_v8_codec\",\n        lambda _path, *, vocab_size: ByteCodec.byte_fallback(),\n    )\n    config = TrainConfig(\n        purpose=\"diagnostic\",\n        phase=\"SC\",\n        model=\"tiny\",\n        codec=\"injected-tokenizer\",\n        datasets=[str(prepared)],\n        output=str(tmp_path / \"fit\"),\n        device=\"cpu\",\n        max_steps=1,\n        checkpoint_every=1,\n        keep_checkpoints=1,\n        microbatch_episodes=1,\n        accumulate_scored=1,\n        accumulate_ingested=1,\n        max_accumulation_windows=1,\n        allow_unverified_data=True,\n        semantic_v8_policy=policy,\n    )\n    first = train(config)\n    assert first[\"global_step\"] == 1\n    payload, checkpoint_metadata = load_checkpoint(first[\"checkpoint\"])\n    transducer_state = torch.load(\n        Path(first[\"checkpoint\"]) / checkpoint_metadata[\"transducer_checkpoint\"][\"file\"],\n        map_location=\"cpu\",\n        weights_only=True,\n    )\n    assert payload[\"global_step\"] == 1\n    exposure = payload[\"semantic_v8_target_exposure\"]\n    assert exposure[\"optimizerUpdates\"] == 1\n    assert exposure[\"registryDigest\"] == registry[\"digest\"]\n    assert set(exposure[\"sources\"]) == {\"source-1\"}\n    assert exposure[\"sources\"][\"source-1\"][\"split\"] == \"train\"\n    assert exposure[\"sources\"][\"source-1\"][\"logicalTargets\"]\n    assert first[\"semantic_v8_target_exposure\"][\"physicalTargetRecordCount\"] > 0\n    assert max(int(state[\"step\"]) for state in payload[\"optimizer\"][\"moments\"].values()) == 1\n\n    config_path = tmp_path / \"resume-config.json\"\n    config_path.write_text(json.dumps(config.__dict__, separators=(\",\", \":\")))\n    resume_code = \"\"\"\nimport importlib.abc, json, sys, torch, traceback\nblocked={\n    \"megatoken.data.algorithm_v7\",\n    \"megatoken.data.detailed_v7\",\n    \"megatoken.data.detailed_harness_v7\",\n    \"megatoken.data.detailed_context_v7\",\n    \"megatoken.data.semantic_harness_v6\",\n    \"megatoken.data.semantic_contract\",\n    \"megatoken.data.semantic_contract_v7\",\n    \"megatoken.training.semantic_budget\",\n}\nclass NoLegacyWire(importlib.abc.MetaPathFinder):\n    def find_spec(self, fullname, path=None, target=None):\n        if fullname in blocked:\n            raise AssertionError(\"Legacy wire dependency: \" + fullname + \"\\\\n\" + \"\".join(traceback.format_stack(limit=18)))\nsys.meta_path.insert(0, NoLegacyWire())\nfrom megatoken.data.semantic_json import stable_algorithm_hash\nfrom megatoken.generation.codec import ByteCodec\nfrom megatoken.training.config import TrainConfig\nfrom megatoken.training.engine import train\nimport megatoken.training.semantic_v8 as semantic_v8\ntorch.set_num_threads(1)\nsemantic_v8.load_semantic_v8_codec=lambda _path, *, vocab_size: ByteCodec.byte_fallback()\nconfig=TrainConfig.from_dict(json.loads(open(sys.argv[1]).read()))\nresult=train(config,resume=sys.argv[2])\nassert not blocked.intersection(sys.modules)\nprint(json.dumps({'global_step':result['global_step'],'termination':result['termination'],\n 'semantic_v8_target_exposure':result['semantic_v8_target_exposure']}))\n\"\"\"\n    environment = dict(os.environ, OMP_NUM_THREADS=\"1\", MKL_NUM_THREADS=\"1\")\n    completed = subprocess.run(\n        [sys.executable, \"-c\", resume_code, str(config_path), first[\"checkpoint\"]],\n        cwd=Path(__file__).resolve().parents[1],\n        env=environment,\n        capture_output=True,\n        text=True,\n        timeout=90,\n        check=False,\n    )\n    assert completed.returncode == 0, completed.stderr\n    result = json.loads(completed.stdout.strip().splitlines()[-1])\n    assert result[\"global_step\"] == 2\n    assert result[\"semantic_v8_target_exposure\"][\"optimizerUpdates\"] == 2\n    assert result[\"semantic_v8_target_exposure\"][\"lastGlobalStep\"] == 2\n    assert result[\"semantic_v8_target_exposure\"][\"sources\"][\"source-1\"][\"split\"] == \"train\"\n\n    forged_payload = {\n        **payload,\n        \"semantic_exposure\": {\n            \"schema\": \"semantic-exposure/4\",\n            \"examples\": 