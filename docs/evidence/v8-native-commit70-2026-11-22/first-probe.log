2026-11-22T09:27:42.0611376Z FORMATTED_SOURCE_JSON {"path": "src/megatoken/semantic_request_bridge_v8.py", "content": "\"\"\"Checkpoint-bound readback for committed native v8 requests.\n\nThis bridge stores the exact response bytes together with the native adapter's\npost-request checkpoint. It returns a stored response from a fresh adapter only\nafter that adapter has actually restored and re-captured the same checkpoint.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport fcntl\nimport hashlib\nimport json\nimport os\nimport stat\n\nfrom megatoken.data.semantic_json import stable_algorithm_hash\nfrom megatoken.io import strict_json_loads\nfrom megatoken.semantic_request_journal_v8 import (\n    DurableNativeRequestJournal,\n    NativeRequestJournalError,\n    NativeRequestOutcomeUnknown,\n)\n\n_BRIDGE_SCHEMA = \"semantic-native-committed-response/1\"\n\n\ndef _canonical(value: object) -> bytes:\n    return json.dumps(\n        value,\n        sort_keys=True,\n        separators=(\",\", \":\"),\n        ensure_ascii=False,\n        allow_nan=False,\n    ).encode(\"utf-8\")\n\n\ndef _sha(value: bytes) -> str:\n    return hashlib.sha256(value).hexdigest()\n\n\nclass NativePoststateMismatch(NativeRequestJournalError):\n    pass\n\n\ndef validate_execution_lock_fd(fd: int, expected_path: str) -> None:\n    \"\"\"Prove the inherited descriptor is the already locked expected inode.\"\"\"\n    from pathlib import Path\n\n    if type(fd) is not int or fd < 4:\n        raise NativeRequestJournalError(\"execution lock must use an inherited descriptor >= 4\")\n    if not isinstance(expected_path, str) or not os.path.isabs(expected_path):\n        raise NativeRequestJournalError(\"execution lock path must be absolute\")\n    probe = None\n    try:\n        inherited = os.fstat(fd)\n        if (\n            not stat.S_ISREG(inherited.st_mode)\n            or inherited.st_uid != os.geteuid()\n            or stat.S_IMODE(inherited.st_mode) & 0o077\n            or inherited.st_nlink != 1\n        ):\n            raise NativeRequestJournalError(\"unsafe inherited execution lock descriptor\")\n        flags = os.O_RDWR | getattr(os, \"O_NOFOLLOW\", 0)\n        probe = os.open(Path(expected_path), flags)\n        expected = os.fstat(probe)\n        if (\n            not stat.S_ISREG(expected.st_mode)\n            or expected.st_uid != os.geteuid()\n            or stat.S_IMODE(expected.st_mode) & 0o077\n            or expected.st_nlink != 1\n            or (expected.st_dev, expected.st_ino) != (inherited.st_dev, inherited.st_ino)\n        ):\n            raise NativeRequestJournalError(\n                \"inherited lock descriptor does not match expected lock path\"\n            )\n        try:\n            fcntl.flock(probe, fcntl.LOCK_EX | fcntl.LOCK_NB)\n        except BlockingIOError:\n            pass\n        else:\n            fcntl.flock(probe, fcntl.LOCK_UN)\n            raise NativeRequestJournalError(\"execution lock inode was not already locked\")\n        # Reacquiring through the inherited descriptor must succeed on the same\n        # open-file description; an independently opened contender must fail.\n        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)\n    except OSError as exc:\n        raise NativeRequestJournalError(\n            \"inherited open-file-description lock proof failed\"\n        ) from exc\n    finally:\n        if probe is not None:\n            os.close(probe)\n\n\ndef _checkpoint_digest(checkpoint: object) -> str:\n    if not isinstance(checkpoint, dict) or type(checkpoint.get(\"digest\")) is not str:\n        raise NativePoststateMismatch(\"invalid native post-request checkpoint\")\n    body = {key: value for key, value in checkpoint.items() if key != \"digest\"}\n    digest = stable_algorithm_hash(body)\n    if checkpoint[\"digest\"] != digest:\n        raise NativePoststateMismatch(\"native post-request checkpoint digest differs\")\n    return digest\n\n\ndef _assert_safe_committed_checkpoint(\n    checkpoint: dict, identity: dict, request: dict, reply: dict\n) -> None:\n    _checkpoint_digest(checkpoint)\n    if checkpoint.get(\"schema\") != \"semantic-model-checkpoint/8\":\n        raise NativePoststateMismatch(\"unsupported native post-request checkpoint\")\n    model = identity[\"model_identity\"]\n    initialized = checkpoint.get(\"initialization\")\n    if (\n        not isinstance(initialized, dict)\n        or initialized.get(\"checkpointIdentity\") != model[\"checkpoint\"]\n        or initialized.get(\"tokenizerIdentity\") != model[\"tokenizer\"]\n        or initialized.get(\"trainingIdentity\") != model.get(\"training\")\n    ):\n        raise NativePoststateMismatch(\"checkpoint model identity differs from request identity\")\n    if identity.get(\"operation\") != \"commit\" or request.get(\"op\") != \"commit\":\n        raise NativePoststateMismatch(\"only native commit response readback is supported\")\n    if reply.get(\"id\") != request.get(\"id\"):\n        raise NativePoststateMismatch(\"commit response ID differs from exact request\")\n    if reply.get(\"ok\") is not True or not isinstance(reply.get(\"result\"), dict):\n        raise NativePoststateMismatch(\"only a successful native commit can be checkpointed\")\n    result = reply[\"result\"]\n    session = request.get(\"session\")\n    selection = request.get(\"selection\")\n    if (\n        not isinstance(session, str)\n        or not isinstance(selection, dict)\n        or result.get(\"schema\") != \"semantic-native-commit/8\"\n        or result.get(\"committed\") is not True\n        or result.get(\"selectionId\") != selection.get(\"selectionId\")\n    ):\n        raise NativePoststateMismatch(\"native commit response binding differs\")\n    attempts = checkpoint.get(\"attempts\")\n    sessions = checkpoint.get(\"sessions\")\n    if not isinstance(attempts, list) or not isinstance(sessions, dict):\n        raise NativePoststateMismatch(\"checkpoint lacks native attempt/session ledgers\")\n    saved = sessions.get(session)\n    if not isinstance(saved, dict) or not isinstance(saved.get(\"public\"), dict):\n        raise NativePoststateMismatch(\"checkpoint lacks the committed public session\")\n    if stable_algorithm_hash(saved[\"public\"]) != result.get(\"publicDigest\"):\n        raise NativePoststateMismatch(\"commit response public digest differs from checkpoint\")\n    matches = [\n        row\n        for row in attempts\n        if isinstance(row, dict) and row.get(\"selectionId\") == result[\"selectionId\"]\n    ]\n    if (\n        len(matches) != 1\n        or matches[0].get(\"status\") != \"committed\"\n        or matches[0].get(\"session\") != session\n    ):\n        raise NativePoststateMismatch(\"checkpoint does not contain this committed attempt\")\n    if any(\n        isinstance(row, dict) and row.get(\"status\") == \"awaiting-commit\" for row in attempts\n    ) or any(\n        isinstance(row, dict) and row.get(\"unacknowledgedSelection\") is not None\n        for row in sessions.values()\n    ):\n        raise NativePoststateMismatch(\"checkpoint contains another unacknowledged selection\")\n\n\nclass CheckpointBoundNativeRequestBridge:\n    \"\"\"Bind exact commit response bytes to validated post-commit native state.\"\"\"\n\n    def __init__(self, journal: DurableNativeRequestJournal):\n        if not isinstance(journal, DurableNativeRequestJournal):\n            raise TypeError(\"journal must be a DurableNativeRequestJournal\")\n        self.journal = journal\n\n    def execute_commit(self, adapter, identity: dict, request_bytes: bytes, callback) -> bytes:\n        \"\"\"Execute or read back one commit; never redispatch an admitted unknown slot.\n\n        The callback performs the native operation and returns its exact JSON reply\n        bytes. Its reply and the checkpoint captured immediately afterward are\n        stored as one immutable journal outcome.\n        \"\"\"\n        if not isinstance(identity, dict) or identity.get(\"operation\") != \"commit\":\n            raise NativePoststateMismatch(\"bridge accepts only commit requests\")\n        expected_model = identity.get(\"model_identity\")\n        adapter_model = {\n            \"checkpoint\": getattr(adapter, \"model_identity\", None),\n            \"tokenizer\": getattr(getattr(adapter, \"codec\", None), \"fingerprint\", None),\n        }\n        training_identity = getattr(adapter, \"training_identity\", None)\n        if training_identity is not None:\n            adapter_model[\"training\"] = training_identity\n        if expected_model != adapter_model:\n            raise NativePoststateMismatch(\"request model identity differs before dispatch\")\n        try:\n            request = strict_json_loads(request_bytes.decode(\"utf-8\", errors=\"strict\"))\n        except (UnicodeError, ValueError) as exc:\n            raise NativeRequestJournalError(\"commit request is not strict UTF-8 JSON\") from exc\n        if (\n            not isinstance(request, dict)\n            or not isinstance(request.get(\"id\"), str)\n            or not request[\"id\"]\n            or request.get(\"op\") != \"commit\"\n            or request.get(\"nativeRequest\") != identity\n        ):\n            raise NativePoststateMismatch(\n                \"request envelope or operation differs from commit identity\"\n            )\n        captured = False\n\n        def execute_once(exact_request: bytes) -> bytes:\n            nonlocal captured\n            reply_bytes = callback(exact_request)\n            if not isinstance(reply_bytes, bytes):\n                raise NativeRequestJournalError(\"commit callback must return exact response bytes\")\n            try:\n                reply = strict_json_loads(reply_bytes.decode(\"utf-8\", errors=\"strict\"))\n            except (UnicodeError, ValueError) as exc:\n                raise NativeRequestJournalError(\n                    \"commit callback response is not strict JSON\"\n                ) from exc\n            checkpoint = adapter.checkpoint()\n            _assert_safe_committed_checkpoint(checkpoint, identity, request, reply)\n            body = {\n                \"schema\": _BRIDGE_SCHEMA,\n                \"identity\": identity,\n                \"request_sha256\": _sha(exact_request),\n                \"response_b64\": base64.b64encode(reply_bytes).decode(\"ascii\"),\n                \"postCheckpoint\": checkpoint,\n            }\n            body[\"digest\"] = stable_algorithm_hash(body)\n            captured = True\n            return _canonical(body)\n\n        try:\n            envelope_bytes = self.journal.execute(identity, request_bytes, execute_once)\n        except Exception as original_error:\n            try:\n                observed = self.journal.inspect(identity, request_bytes)\n            except Exception as readback_error:\n                raise NativeRequestOutcomeUnknown(\n                    \"commit may have been admitted but independent durable readback failed\"\n                ) from readback_error\n            if observed[\"status\"] == \"unknown\":\n                raise NativeRequestOutcomeUnknown(\n                    \"commit intent is durable but no outcome is known; request will not be retried\"\n                ) from original_error\n            if observed[\"status\"] == \"completed\":\n                envelope_bytes = observed[\"result_bytes\"]\n            else:\n                raise\n        envelope = self._decode_envelope(envelope_bytes, identity, request_bytes, request)\n        checkpoint = envelope[\"postCheckpoint\"]\n        reply_bytes = base64.b64decode(envelope[\"response_b64\"], validate=True)\n        reply = strict_json_loads(reply_bytes.decode(\"utf-8\", errors=\"strict\"))\n        _assert_safe_committed_checkpoint(checkpoint, identity, request, reply)\n        if captured:\n            current = adapter.checkpoint()\n            if _canonical(current) != _canonical(checkpoint):\n                raise NativePoststateMismatch(\"live native state differs from journaled poststate\")\n        else:\n            runtime = getattr(adapter, \"runtime\", None)\n            memory = getattr(runtime, \"memory\", None)\n            runtime_sessions = getattr(memory, \"sessions\", {})\n            pristine = (\n                not getattr(adapter, \"attempts\", ())\n                and not getattr(adapter, \"sessions\", {})\n                and not runtime_sessions\n            )\n            try:\n                current = adapter.checkpoint()\n            except Exception:\n                if not pristine:\n                    raise\n                current = None\n            if current is None or _canonical(current) != _canonical(checkpoint):\n                if not pristine:\n                    raise NativePoststateMismatch(\n                        \"active native state differs from journaled poststate\"\n                    )\n                adapter.restore(checkpoint=checkpoint)\n                current = adapter.checkpoint()\n            if _canonical(current) != _canonical(checkpoint):\n                raise NativePoststateMismatch(\n                    \"restored native state differs from journaled poststate\"\n                )\n        return reply_bytes\n\n    def _decode_envelope(\n        self, raw: bytes, identity: dict, request_bytes: bytes, request: dict\n    ) -> dict:\n        try:\n            envelope = json.loads(raw.decode(\"utf-8\"))\n        except (UnicodeError, json.JSONDecodeError) as exc:\n            raise NativeRequestJournalError(\"corrupt checkpoint-bound response record\") from exc\n        if (\n            not isinstance(envelope, dict)\n            or set(envelope)\n            != {\n                \"schema\",\n                \"identity\",\n                \"request_sha256\",\n                \"response_b64\",\n                \"postCheckpoint\",\n                \"digest\",\n            }\n            or _canonical(envelope) != raw\n        ):\n            raise NativeRequestJournalError(\"invalid checkpoint-bound response fields\")\n        body = {key: value for key, value in envelope.items() if key != \"digest\"}\n        if (\n            envelope[\"schema\"] != _BRIDGE_SCHEMA\n            or envelope[\"identity\"] != identity\n            or envelope[\"request_sha256\"] != _sha(request_bytes)\n            or envelope[\"digest\"] != stable_algorithm_hash(body)\n            or not isinstance(envelope[\"response_b64\"], str)\n        ):\n            raise NativeRequestJournalError(\"checkpoint-bound response identity differs\")\n        try:\n            response = base64.b64decode(envelope[\"response_b64\"], validate=True)\n        except ValueError as exc:\n            raise NativeRequestJournalError(\"invalid exact native response bytes\") from exc\n        if base64.b64encode(response).decode(\"ascii\") != envelope[\"response_b64\"]:\n            raise NativeRequestJournalError(\"noncanonical native response encoding\")\n        return envelope\n"}
2026-11-22T09:27:42.0980820Z FORMATTED_SOURCE_JSON {"path": "scripts/serve_semantic_v8.py", "content": "#!/usr/bin/env python3\n\"\"\"Serve actual native v8 selections through bounded JSONL messages.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport resource\nimport sys\nimport time\nfrom pathlib import Path\n\nimport torch\n\nfrom megatoken.io import strict_json_loads\nfrom megatoken.model.multitrack import MultiTrackGenerator\nfrom megatoken.multitrack_runtime import MultiTrackRuntime\nfrom megatoken.semantic_model_v8 import NativeSemanticInferenceV8\nfrom megatoken.semantic_request_bridge_v8 import (\n    CheckpointBoundNativeRequestBridge,\n    validate_execution_lock_fd,\n)\nfrom megatoken.semantic_request_journal_v8 import (\n    DurableNativeRequestJournal,\n    NativeRequestJournalError,\n)\nfrom megatoken.served import ServedBundle\n\nMAX_REQUEST_BYTES = 40 << 20\n\n\n@torch.inference_mode()\ndef dispatch(adapter, request):\n    if not isinstance(request, dict) or not isinstance(request.get(\"id\"), str):\n        raise ValueError(\"V8 RPC requires a stable request ID\")\n    operation = request.get(\"op\")\n    if operation in {\"metrics\", \"status\"}:\n        return adapter.metrics()\n    methods = {\n        name: getattr(adapter, name)\n        for name in (\n            \"initialize\",\n            \"select\",\n            \"commit\",\n            \"reject\",\n            \"complete\",\n            \"cancel\",\n            \"checkpoint\",\n            \"restore\",\n            \"open_orchestration\",\n            \"select_orchestration\",\n            \"commit_orchestration\",\n            \"bootstrap_orchestration_child\",\n            \"status_orchestration\",\n            \"cancel_orchestration\",\n        )\n    }\n    operation = operation.replace(\"-\", \"_\") if isinstance(operation, str) else operation\n    if operation not in methods:\n        raise ValueError(\"Unknown native v8 RPC operation\")\n    return methods[operation](\n        **{key: value for key, value in request.items() if key not in {\"id\", \"op\", \"nativeRequest\"}}\n    )\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)\n    parser.add_argument(\"--served\", type=Path, required=True)\n    parser.add_argument(\"--device\", default=\"cpu\")\n    parser.add_argument(\"--effort\", type=int, default=1)\n    parser.add_argument(\"--max-tokens\", type=int, default=512)\n    parser.add_argument(\"--max-fragments\", type=int, default=64)\n    parser.add_argument(\"--max-sessions\", type=int, default=16)\n    parser.add_argument(\"--threads\", type=int, default=1)\n    parser.add_argument(\"--profile-output\", type=Path)\n    parser.add_argument(\"--request-journal\", type=Path)\n    parser.add_argument(\"--execution-lock-fd\", type=int)\n    parser.add_argument(\"--execution-lock-session\")\n    parser.add_argument(\"--execution-lock-stream\")\n    parser.add_argument(\"--execution-lock-path\", type=Path)\n    args = parser.parse_args()\n    lock_options = (\n        args.execution_lock_fd,\n        args.execution_lock_session,\n        args.execution_lock_stream,\n        args.execution_lock_path,\n    )\n    if any(value is not None for value in lock_options) and not all(\n        value is not None for value in lock_options\n    ):\n        parser.error(\"Native execution locking requires its inherited descriptor and namespace\")\n    if args.request_journal is not None and not all(value is not None for value in lock_options):\n        parser.error(\"Native request journaling requires its inherited execution lock\")\n    request_bridge = None\n    if args.execution_lock_fd is not None:\n        try:\n            validate_execution_lock_fd(args.execution_lock_fd, str(args.execution_lock_path))\n        except Exception as error:\n            parser.error(f\"Cannot prove native execution lock ownership: {error}\")\n    if args.request_journal is not None:\n        try:\n            journal = DurableNativeRequestJournal(\n                args.request_journal,\n                max_request_bytes=MAX_REQUEST_BYTES,\n                max_result_bytes=MAX_REQUEST_BYTES,\n                max_log_bytes=256 << 20,\n            )\n        except Exception as error:\n            parser.error(f\"Cannot establish native request recovery: {error}\")\n        request_bridge = CheckpointBoundNativeRequestBridge(journal)\n    if args.profile_output is not None and args.profile_output.exists():\n        parser.error(\"Native v8 profiles are immutable; choose a new output path\")\n    if args.threads < 1:\n        parser.error(\"Native v8 CPU threads must be positive\")\n    torch.set_num_threads(args.threads)\n    device = torch.device(args.device)\n\n    def synchronize():\n        if device.type == \"cuda\":\n            torch.cuda.synchronize(device)\n\n    started = time.perf_counter()\n    bundle = ServedBundle(args.served, device=args.device)\n    runtime = MultiTrackRuntime(MultiTrackGenerator.of(bundle.model), chunking=bundle.chunking)\n    adapter = NativeSemanticInferenceV8(\n        runtime,\n        model_identity=bundle.manifest[\"model_sha256\"],\n        training_identity=bundle.manifest.get(\"semantic_v8_lineage_digest\"),\n        effort=args.effort,\n        max_tokens=args.max_tokens,\n        max_fragments=args.max_fragments,\n        max_sessions=args.max_sessions,\n    )\n    synchronize()\n    cold_seconds = time.perf_counter() - started\n    try:\n        while raw := sys.stdin.buffer.readline(MAX_REQUEST_BYTES + 1):\n            if len(raw) > MAX_REQUEST_BYTES:\n                raise ValueError(\"Native v8 request exceeds its byte budget\")\n            if not raw.strip():\n                continue\n            request = None\n            stop_after_reply = False\n            synchronize()\n            request_started = time.perf_counter()\n            try:\n                request = strict_json_loads(raw.decode(\"utf-8\", errors=\"strict\"))\n                if (\n                    not isinstance(request, dict)\n                    or not isinstance(request.get(\"id\"), str)\n                    or not isinstance(request.get(\"op\"), str)\n                ):\n                    raise ValueError(\"Native v8 RPC requires a stable string ID and operation\")\n                if \"nativeRequest\" in request and (\n                    request_bridge is None or request.get(\"op\") != \"commit\"\n                ):\n                    raise ValueError(\"nativeRequest identity is only valid for a journaled commit\")\n                if request_bridge is not None and request.get(\"op\") == \"commit\":\n                    identity = request.get(\"nativeRequest\")\n                    if (\n                        not isinstance(identity, dict)\n                        or identity.get(\"session_id\") != args.execution_lock_session\n                        or identity.get(\"stream_id\") != args.execution_lock_stream\n                    ):\n                        raise ValueError(\n                            \"Journaled commit identity differs from inherited execution-lock namespace\"\n                        )\n\n                    def commit_reply(_exact_request):\n                        result = dispatch(adapter, request)\n                        synchronize()\n                        reply = {\"id\": request[\"id\"], \"ok\": True, \"result\": result}\n                        reply[\"runtimeMetrics\"] = {\n                            \"schema\": \"semantic-inference-metrics/8\",\n                            \"computeSeconds\": time.perf_counter() - request_started,\n                            \"peakMemoryBytes\": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n                            * (1 if sys.platform == \"darwin\" else 1024),\n                        }\n                        return json.dumps(\n                            reply, ensure_ascii=False, separators=(\",\", \":\"), allow_nan=False\n                        ).encode(\"utf-8\")\n\n                    response = request_bridge.execute_commit(adapter, identity, raw, commit_reply)\n                    sys.stdout.buffer.write(response + b\"\\n\")\n                    sys.stdout.buffer.flush()\n                    continue\n                result = dispatch(adapter, request)\n                reply = {\"id\": request[\"id\"], \"ok\": True, \"result\": result}\n            except Exception as error:\n                stop_after_reply = isinstance(error, NativeRequestJournalError)\n                reply = {\n                    \"id\": request.get(\"id\") if isinstance(request, dict) else None,\n                    \"ok\": False,\n                    \"error\": {\n                        \"category\": type(error).__name__,\n                        \"message\": str(error),\n                        \"evidence\": getattr(error, \"evidence\", None),\n                    },\n                }\n            synchronize()\n            reply[\"runtimeMetrics\"] = {\n                \"schema\": \"semantic-inference-metrics/8\",\n                \"computeSeconds\": time.perf_counter() - request_started,\n                \"peakMemoryBytes\": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n                * (1 if sys.platform == \"darwin\" else 1024),\n            }\n            print(\n                json.dumps(reply, ensure_ascii=False, separators=(\",\", \":\"), allow_nan=False),\n                flush=True,\n            )\n            if stop_after_reply:\n                break\n    finally:\n        for identity in list(adapter.sessions):\n            adapter.cancel(session=identity, reason=\"process-closed\")\n        runtime.close()\n        if args.profile_output is not None:\n            args.profile_output.parent.mkdir(parents=True, exist_ok=True)\n            with args.profile_output.open(\"x\", encoding=\"utf-8\") as output:\n                json.dump(\n                    {**adapter.metrics(), \"coldLoadSeconds\": cold_seconds, \"runtimeClosed\": True},\n                    output,\n                    indent=2,\n                    allow_nan=False,\n                )\n                output.write(\"\\n\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}
2026-11-22T09:27:42.1379564Z FORMATTED_SOURCE_JSON {"path": "tests/test_semantic_request_bridge_v8.py", "content": "from __future__ import annotations\n\nimport copy\nimport json\n\nimport pytest\n\nfrom megatoken.data.semantic_json import stable_algorithm_hash\nfrom megatoken.semantic_request_bridge_v8 import (\n    CheckpointBoundNativeRequestBridge,\n    NativePoststateMismatch,\n)\nfrom megatoken.semantic_request_journal_v8 import (\n    DurableNativeRequestJournal,\n    NativeRequestJournalError,\n    NativeRequestOutcomeUnknown,\n)\n\n\ndef request_identity():\n    return {\n        \"schema\": \"semantic-native-request-identity/1\",\n        \"session_id\": \"session-1\",\n        \"stream_id\": \"stream-1\",\n        \"session_generation\": 1,\n        \"ordinal\": 1,\n        \"operation\": \"commit\",\n        \"model_identity\": {\"checkpoint\": \"a\" * 64, \"tokenizer\": \"b\" * 64},\n    }\n\n\ndef checkpoint(*, pending=False):\n    value = {\n        \"schema\": \"semantic-model-checkpoint/8\",\n        \"initialization\": {\n            \"checkpointIdentity\": \"a\" * 64,\n            \"tokenizerIdentity\": \"b\" * 64,\n            \"trainingIdentity\": None,\n        },\n        \"attempts\": [{\"selectionId\": \"v8:0\", \"status\": \"committed\", \"session\": \"session-1\"}],\n        \"sessions\": {\n            \"session-1\": {\n                \"public\": {\"timeline\": [{\"mode\": \"generated\"}]},\n                \"unacknowledgedSelection\": None,\n            }\n        },\n    }\n    if pending:\n        value[\"attempts\"].append(\n            {\"selectionId\": \"v8:other\", \"status\": \"awaiting-commit\", \"session\": \"other-session\"}\n        )\n        value[\"sessions\"][\"other-session\"] = {\n            \"public\": {\"timeline\": []},\n            \"unacknowledgedSelection\": \"v8:other\",\n        }\n    value[\"digest\"] = stable_algorithm_hash(value)\n    return value\n\n\nclass Adapter:\n    def __init__(self, state=None):\n        self.model_identity = \"a\" * 64\n        self.codec = type(\"Codec\", (), {\"fingerprint\": \"b\" * 64})()\n        self.training_identity = None\n        self.attempts = []\n        self.sessions = {}\n        self.runtime = type(\"Runtime\", (), {\"memory\": type(\"Memory\", (), {\"sessions\": {}})()})()\n        self.state = copy.deepcopy(state)\n\n    def checkpoint(self):\n        if self.state is None:\n            raise ValueError(\"no adapter checkpoint\")\n        return copy.deepcopy(self.state)\n\n    def restore(self, *, checkpoint):\n        if self.state is not None:\n            raise ValueError(\"restore requires empty adapter\")\n        self.state = copy.deepcopy(checkpoint)\n\n\ndef request_bytes():\n    return json.dumps(\n        {\n            \"id\": \"rpc-2\",\n            \"op\": \"commit\",\n            \"nativeRequest\": request_identity(),\n            \"session\": \"session-1\",\n            \"selection\": {\"selectionId\": \"v8:0\"},\n        },\n        separators=(\",\", \":\"),\n    ).encode()\n\n\ndef reply_bytes(cp=None):\n    cp = cp or checkpoint()\n    return json.dumps(\n        {\n            \"id\": \"rpc-2\",\n            \"ok\": True,\n            \"result\": {\n                \"schema\": \"semantic-native-commit/8\",\n                \"selectionId\": \"v8:0\",\n                \"publicDigest\": stable_algorithm_hash(cp[\"sessions\"][\"session-1\"][\"public\"]),\n                \"committed\": True,\n            },\n        },\n        separators=(\",\", \":\"),\n    ).encode()\n\n\ndef test_completed_commit_readback_restores_and_rechecks_poststate(tmp_path):\n    journal = DurableNativeRequestJournal(tmp_path / \"journal\")\n    bridge = CheckpointBoundNativeRequestBridge(journal)\n    identity = request_identity()\n    raw = request_bytes()\n    first = Adapter()\n    cp = checkpoint()\n    output = bridge.execute_commit(\n        first,\n        identity,\n        raw,\n        lambda _: setattr(first, \"state\", cp) or reply_bytes(cp),\n    )\n    assert output == reply_bytes(cp)\n\n    fresh = Adapter()\n    recovered = bridge.execute_commit(\n        fresh,\n        identity,\n        raw,\n        lambda _: pytest.fail(\"completed commit was dispatched again\"),\n    )\n    assert recovered == output\n    assert fresh.checkpoint() == cp\n\n\ndef test_unknown_commit_outcome_is_not_reexecuted(tmp_path):\n    journal = DurableNativeRequestJournal(tmp_path / \"journal\")\n    bridge = CheckpointBoundNativeRequestBridge(journal)\n    identity = request_identity()\n    raw = request_bytes()\n    with pytest.raises(NativeRequestOutcomeUnknown) as refused:\n        bridge.execute_commit(\n            Adapter(),\n            identity,\n            raw,\n            lambda _: (_ for _ in ()).throw(RuntimeError(\"post-dispatch crash\")),\n        )\n    assert isinstance(refused.value.__cause__, RuntimeError)\n    assert str(refused.value.__cause__) == \"post-dispatch crash\"\n    with pytest.raises(NativeRequestOutcomeUnknown):\n        bridge.execute_commit(\n            Adapter(), identity, raw, lambda _: pytest.fail(\"unknown commit redispatched\")\n        )\n\n\ndef test_fresh_restore_refuses_checkpoint_with_unacknowledged_selection(tmp_path):\n    journal = DurableNativeRequestJournal(tmp_path / \"journal\")\n    bridge = CheckpointBoundNativeRequestBridge(journal)\n    identity = request_identity()\n    raw = request_bytes()\n    pending = checkpoint(pending=True)\n    adapter = Adapter()\n    with pytest.raises(NativeRequestOutcomeUnknown) as refused:\n        bridge.execute_commit(\n            adapter,\n            identity,\n            raw,\n            lambda _: setattr(adapter, \"state\", pending) or reply_bytes(pending),\n        )\n    assert isinstance(refused.value.__cause__, NativePoststateMismatch)\n    assert \"unacknowledged selection\" in str(refused.value.__cause__)\n    with pytest.raises(NativeRequestOutcomeUnknown):\n        bridge.execute_commit(\n            Adapter(), identity, raw, lambda _: pytest.fail(\"unsafe checkpoint retried\")\n        )\n\n\ndef test_committed_reply_must_match_checkpoint_public_digest(tmp_path):\n    journal = DurableNativeRequestJournal(tmp_path / \"journal\")\n    bridge = CheckpointBoundNativeRequestBridge(journal)\n    identity = request_identity()\n    cp = checkpoint()\n    wrong = json.dumps(\n        {\n            \"id\": \"rpc-2\",\n            \"ok\": True,\n            \"result\": {\n                \"schema\": \"semantic-native-commit/8\",\n                \"selectionId\": \"v8:0\",\n                \"publicDigest\": \"0\" * 64,\n                \"committed\": True,\n            },\n        },\n        separators=(\",\", \":\"),\n    ).encode()\n    first = Adapter()\n    with pytest.raises(NativeRequestOutcomeUnknown) as refused:\n        bridge.execute_commit(\n            first,\n            identity,\n            request_bytes(),\n            lambda _: setattr(first, \"state\", cp) or wrong,\n        )\n    assert isinstance(refused.value.__cause__, NativePoststateMismatch)\n    assert \"public digest\" in str(refused.value.__cause__)\n    with pytest.raises(NativeRequestOutcomeUnknown):\n        bridge.execute_commit(\n            Adapter(), identity, request_bytes(), lambda _: pytest.fail(\"mismatched commit retried\")\n        )\n\n\ndef test_execution_lock_proves_existing_lock_on_exact_inherited_open_description(tmp_path):\n    import fcntl\n    import os\n\n    from megatoken.semantic_request_bridge_v8 import validate_execution_lock_fd\n\n    lock_path = tmp_path / \"execution.lock\"\n    owner = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)\n    contender = None\n    try:\n        with pytest.raises(NativeRequestJournalError, match=\"not already locked\"):\n            validate_execution_lock_fd(owner, str(lock_path))\n\n        fcntl.flock(owner, fcntl.LOCK_EX)\n        contender = os.open(lock_path, os.O_RDWR)\n        with pytest.raises(NativeRequestJournalError, match=\"open-file-description lock proof\"):\n            validate_execution_lock_fd(contender, str(lock_path))\n        validate_execution_lock_fd(owner, str(lock_path))\n    finally:\n        if contender is not None:\n            os.close(contender)\n        fcntl.flock(owner, fcntl.LOCK_UN)\n        os.close(owner)\n\n\n@pytest.mark.parametrize(\n    \"reply\",\n    [\n        lambda base: {**base, \"id\": \"wrong-rpc\"},\n        lambda base: {**base, \"ok\": False, \"error\": {\"category\": \"refused\"}},\n    ],\n)\ndef test_changed_or_rejected_reply_becomes_unknown_without_retry(tmp_path, reply):\n    journal = DurableNativeRequestJournal(tmp_path / \"journal\")\n    bridge = CheckpointBoundNativeRequestBridge(journal)\n    identity = request_identity()\n    raw = request_bytes()\n    cp = checkpoint()\n    adapter = Adapter()\n    base = json.loads(reply_bytes(cp))\n    changed = json.dumps(reply(base), separators=(\",\", \":\")).encode()\n    with pytest.raises(NativeRequestOutcomeUnknown) as refused:\n        bridge.execute_commit(\n            adapter,\n            identity,\n            raw,\n            lambda _: setattr(adapter, \"state\", cp) or changed,\n        )\n    assert isinstance(refused.value.__cause__, NativePoststateMismatch)\n    with pytest.raises(NativeRequestOutcomeUnknown):\n        bridge.execute_commit(\n            Adapter(), identity, raw, lambda _: pytest.fail(\"rejected commit was retried\")\n        )\n\n\ndef test_completed_readback_refuses_to_replace_existing_sibling_native_state(tmp_path):\n    journal = DurableNativeRequestJournal(tmp_path / \"journal\")\n    bridge = CheckpointBoundNativeRequestBridge(journal)\n    identity = request_identity()\n    raw = request_bytes()\n    target = checkpoint()\n    original = Adapter()\n    bridge.execute_commit(\n        original,\n        identity,\n        raw,\n        lambda _: setattr(original, \"state\", target) or reply_bytes(target),\n    )\n    sibling = checkpoint()\n    sibling[\"sessions\"][\"sibling-session\"] = {\n        \"public\": {\"timeline\": [{\"mode\": \"observed\"}]},\n        \"unacknowledgedSelection\": None,\n    }\n    sibling[\"digest\"] = stable_algorithm_hash({k: v for k, v in sibling.items() if k != \"digest\"})\n    current = Adapter(sibling)\n    current.attempts = [{\"selectionId\": \"v8:other\"}]\n    with pytest.raises(NativePoststateMismatch, match=\"active native state differs\"):\n        bridge.execute_commit(current, identity, raw, lambda _: pytest.fail(\"callback repeated\"))\n"}
2026-11-22T09:27:42.1813540Z FORMATTED_SOURCE_JSON {"path": "tests/test_semantic_model_v8.py", "content": "\"\"\"Protocol tests use an explicit fake decoder; no model-quality claim follows.\"\"\"\n\nimport copy\nimport json\nimport unittest\nfrom dataclasses import dataclass\nfrom pathlib import Path\nfrom types import SimpleNamespace\n\nfrom megatoken.contracts import ROLE_TO_ID\nfrom megatoken.controls import semantic_selection_instruction_v8\nfrom megatoken.data.native_v8 import prepare_native_v8_training\nfrom megatoken.generation.codec import ByteCodec\nfrom megatoken.multitrack_runtime import TrackSession\nfrom megatoken.semantic_model_v8 import NativeSelectionV8Error, NativeSemanticInferenceV8\nfrom megatoken.semantic_request_bridge_v8 import CheckpointBoundNativeRequestBridge\nfrom megatoken.semantic_request_journal_v8 import DurableNativeRequestJournal\nfrom tests.test_prediction_prefix_v8 import examples, prefix\n\n\n@dataclass\nclass Memory:\n    session_id: str\n    state: object\n    agenda: object\n    scheduler: object\n    writes: object = None\n    sources: object = None\n    lock: object = None\n\n\nclass FakeRuntime:\n    \"\"\"Only physical I/O and transaction boundaries; outputs are supplied by this test.\"\"\"\n\n    def __init__(self, fragments):\n        self.codec = ByteCodec.byte_fallback()\n        self.generator = SimpleNamespace(\n            generator=SimpleNamespace(codec=self.codec, config=SimpleNamespace(max_capacity=256))\n        )\n        self.memory = SimpleNamespace(sessions={}, close_session=self.close_session)\n        self.fragments = list(fragments)\n        self.observations = []\n        self.controls = []\n\n    def open(self, **kwargs):\n        self.metadata = kwargs[\"metadata\"]\n        memory = Memory(\"memory1\", 0, {}, SimpleNamespace(lookups=0))\n        self.memory.sessions[memory.session_id] = memory\n        return TrackSession(memory)\n\n    def observe(self, session, events, **kwargs):\n        for event in events:\n            self.observations.append(event)\n            session.context_archive.put(event)\n            session.occupied_events.add(event.event_id)\n            session.history.append(event.payload)\n        session.memory.state += 1\n        session.revision += 1\n\n    def generate(self, session, *, controls, event_ids, **kwargs):\n        payload, terminal = self.fragments.pop(0)\n        self.controls.extend(controls)\n        session.memory.state += 1\n        session.revision += 1\n        session.occupied_events.update(event_ids)\n        return SimpleNamespace(\n            tape=SimpleNamespace(\n                payloads=(payload,),\n                terminal=(terminal,),\n                valid=(True,),\n                modalities=(\"text\",),\n                tracks=(\"assistant\",),\n                emitted_ids=(tuple(self.codec.encode(payload)),),\n                event_ids=event_ids,\n                meridian_id=session.revision,\n            )\n        )\n\n    def release_generation(self, session, revision):\n        pass\n\n    def context_status(self, session, **kwargs):\n        return {\"visible_events\": sorted(session.occupied_events), \"cache_bytes\": session.state * 8}\n\n    def close_session(self, memory):\n        self.memory.sessions.pop(memory.session_id, None)\n\n\nclass NativeServingV8Tests(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.example = examples(\"semantic-regions-v8.json.gz.b64\")[0]\n\n    def setup_adapter(self, fragments):\n        runtime = FakeRuntime(fragments)\n        adapter = NativeSemanticInferenceV8(runtime, model_identity=\"a\" * 64)\n        adapter.initialize(\n            seed=17, checkpointIdentity=\"a\" * 64, tokenizerIdentity=runtime.codec.fingerprint\n        )\n        return adapter, runtime\n\n    def request(self, adapter, index=0):\n        public, contexts, context = prefix(self.example, index)\n        return adapter.select(\n            session=public[\"timeline\"][0][\"fields\"][\"session\"],\n            public=public,\n            contexts=contexts,\n            context=context,\n        )\n\n    def acknowledge(self, adapter, result, index=0):\n        before, contexts, context = prefix(self.example, index)\n        public = copy.deepcopy(self.example[\"public\"])\n        public[\"timeline\"] = public[\"timeline\"][: context[\"visibleThrough\"] + 1]\n        return adapter.commit(\n            session=before[\"timeline\"][0][\"fields\"][\"session\"],\n            public=public,\n            contexts=contexts + [context],\n            invocationId=context[\"invocationId\"],\n            record=result[\"record\"],\n            selection=result[\"selection\"],\n        )\n\n    def target(self, index=0):\n        context = self.example[\"contexts\"][index]\n        return self.example[\"public\"][\"timeline\"][context[\"visibleThrough\"]][\"fields\"][\n            \"line\"\n        ].encode()\n\n    def test_original_fragment_ids_and_bytes_survive_explicit_commit(self):\n        target = self.target()\n        adapter, runtime = self.setup_adapter([(target[:20], False), (target[20:], True)])\n        result = self.request(adapter)\n        identity = result[\"selection\"][\"session\"]\n        self.assertEqual(adapter.sessions[identity].runtime.state, 0)\n        self.assertEqual(result[\"selection\"][\"payloadHex\"], target.hex())\n        self.assertEqual(\n            b\"\".join(\n                runtime.codec.decode(row[\"emittedTokenIds\"])\n                for row in result[\"selection\"][\"fragments\"]\n            ),\n            target,\n        )\n        self.assertEqual(len(runtime.controls), 2)\n        self.assertIn(semantic_selection_instruction_v8().encode(), runtime.controls[0])\n        self.assertIn(b\"Continue the exact current record bytes\", runtime.controls[1])\n        with self.assertRaisesRegex(ValueError, \"requires commit or rejection\"):\n            self.request(adapter)\n        self.assertTrue(self.acknowledge(adapter, result)[\"committed\"])\n        self.assertGreater(adapter.sessions[identity].runtime.state, 0)\n        self.assertEqual(adapter.metrics()[\"committed\"], 1)\n\n    def test_rejected_candidate_leaves_native_state_available_for_retry(self):\n        target = self.target()\n        adapter, runtime = self.setup_adapter([(target, True), (target, True)])\n        first = self.request(adapter)\n        identity = first[\"selection\"][\"session\"]\n        adapter.reject(\n            session=identity, selectionId=first[\"selection\"][\"selectionId\"], reason=\"test refusal\"\n        )\n        self.assertEqual(adapter.sessions[identity].runtime.state, 0)\n        second = self.request(adapter)\n        self.acknowledge(adapter, second)\n        metrics = adapter.metrics()\n        self.assertEqual(metrics[\"predictionAttempts\"], 2)\n        self.assertEqual(metrics[\"failedAttempts\"], 1)\n        self.assertEqual(metrics[\"generatedTokens\"], 2 * len(runtime.codec.encode(target)))\n\n    def test_native_commit_independently_rejects_false_semantics(self):\n        target = self.target().replace(b'\"num\",4', b'\"num\",9', 1)\n        self.assertNotEqual(target, self.target())\n        adapter, _ = self.setup_adapter([(target, True)])\n        result = self.request(adapter)\n        before, contexts, context = prefix(self.example, 0)\n        public = copy.deepcopy(self.example[\"public\"])\n        public[\"timeline\"] = public[\"timeline\"][: context[\"visibleThrough\"] + 1]\n        public[\"timeline\"][-1][\"fields\"][\"line\"] = target.decode()\n        with self.assertRaises(ValueError):\n            adapter.commit(\n                session=result[\"selection\"][\"session\"],\n                public=public,\n                contexts=contexts + [context],\n                invocationId=context[\"invocationId\"],\n                record=result[\"record\"],\n                selection=result[\"selection\"],\n            )\n        self.assertEqual(adapter.sessions[result[\"selection\"][\"session\"]].runtime.state, 0)\n\n    def test_failed_emission_retains_original_cost_and_can_retry(self):\n        adapter, runtime = self.setup_adapter([(b\"\\xff\", True), (self.target(), True)])\n        with self.assertRaises(NativeSelectionV8Error) as error:\n            self.request(adapter)\n        self.assertEqual(error.exception.evidence[\"payloadHex\"], \"ff\")\n        self.assertEqual(error.exception.evidence[\"generatedTokens\"], 1)\n        self.assertEqual(adapter.metrics()[\"failedAttempts\"], 1)\n        self.acknowledge(adapter, self.request(adapter))\n        self.assertEqual(adapter.metrics()[\"committed\"], 1)\n\n    def test_continuation_requires_visible_context_and_every_earlier_fragment(self):\n        target = self.target()\n        for missing in (\"context\", \"fragment\"):\n            with self.subTest(missing=missing):\n                adapter, runtime = self.setup_adapter([(target[:20], False), (target[20:], True)])\n                original_status = runtime.context_status\n\n                def context_status(\n                    session,\n                    *,\n                    runtime=runtime,\n                    original_status=original_status,\n                    missing=missing,\n                    **kwargs,\n                ):\n                    status = original_status(session, **kwargs)\n                    if runtime.controls:\n                        event = (\n                            next(\n                                row.event_id\n                                for row in runtime.observations\n                                if row.role_id == ROLE_TO_ID[\"system\"]\n                            )\n                            if missing == \"context\"\n                            else \"v8:0:fragment:0\"\n                        )\n                        status[\"visible_events\"].remove(event)\n                    return status\n\n                runtime.context_status = context_status\n                with self.assertRaisesRegex(NativeSelectionV8Error, \"no longer visible\") as error:\n                    self.request(adapter)\n                self.assertEqual(len(runtime.controls), 1)\n                self.assertEqual(len(error.exception.evidence[\"fragments\"]), 1)\n                self.assertEqual(error.exception.evidence[\"payloadHex\"], target[:20].hex())\n                identity = error.exception.evidence[\"session\"]\n                self.assertEqual(adapter.sessions[identity].runtime.state, 0)\n                self.assertIsNone(adapter.sessions[identity].pending)\n\n    def test_observed_native_inputs_match_training_preparation(self):\n        adapter, runtime = self.setup_adapter([(self.target(), True)])\n        self.request(adapter)\n        episode, _ = prepare_native_v8_training(\n            self.example, codec=runtime.codec, max_positions=256, max_history=1024\n        )\n        expected = []\n        for record in episode.records:\n            if record.policy_mask:\n                break\n            expected.append(\n                (\n                    record.payload,\n                    ROLE_TO_ID[record.role],\n                    record.part_index + 1 == record.part_count,\n                )\n            )\n        self.assertEqual(\n            [(row.payload, row.role_id, row.terminal) for row in runtime.observations], expected\n        )\n        self.assertEqual(\n            json.loads(episode.supervision.annotations_json)[\"session_metadata\"], runtime.metadata\n        )\n        target_instruction = next(\n            event.instruction\n            for group in episode.meridians\n            for event in group.events\n            if event.instruction\n        )\n        self.assertEqual(target_instruction, semantic_selection_instruction_v8())\n\n    def test_wrong_initialization_and_unacknowledged_teacher_history_are_refused(self):\n        adapter, runtime = self.setup_adapter([(self.target(), True)])\n        with self.assertRaisesRegex(ValueError, \"acknowledged native history\"):\n            self.request(adapter, 1)\n        self.assertEqual(adapter.sessions, {})\n        self.assertEqual(runtime.memory.sessions, {})\n        self.assertEqual(adapter.metrics()[\"sessionOpenings\"], [])\n        self.assertFalse(hasattr(runtime, \"metadata\"))\n        self.assertEqual(runtime.observations, [])\n        self.assertEqual(runtime.controls, [])\n        with self.assertRaisesRegex(ValueError, \"identity differs\"):\n            adapter.initialize(seed=17, checkpointIdentity=\"a\" * 64, tokenizerIdentity=\"b\" * 64)\n        with self.assertRaisesRegex(ValueError, \"Initialize\"):\n            self.request(adapter)\n\n    def test_acknowledgement_requires_the_complete_original_selection_evidence(self):\n        adapter, _ = self.setup_adapter([(self.target(), True)])\n        result = self.request(adapter)\n        identity = result[\"selection\"][\"session\"]\n        alterations = [\n            (\"origin\", \"controlled\"),\n            (\"modelSelected\", 1),\n            (\"fragments\", []),\n            (\"session\", \"another-session\"),\n            (\"generatedTokens\", 0),\n            (\"extra\", \"rewritten\"),\n        ]\n        for key, value in alterations:\n            with self.subTest(field=key):\n                changed = copy.deepcopy(result)\n                changed[\"selection\"][key] = value\n                with self.assertRaisesRegex(ValueError, \"original native selection\"):\n                    self.acknowledge(adapter, changed)\n                self.assertIsNotNone(adapter.sessions[identity].pending)\n                self.assertEqual(adapter.sessions[identity].runtime.state, 0)\n                with self.assertRaisesRegex(ValueError, \"requires commit or rejection\"):\n                    self.request(adapter)\n        self.assertTrue(self.acknowledge(adapter, result)[\"committed\"])\n\n    def test_acknowledged_host_suffix_cannot_be_dropped_and_is_ingested_once(self):\n        from megatoken.controls import canonical_semantic_observation\n        from megatoken.data.algorithm_v7 import stable_algorithm_hash\n        from megatoken.data.native_v8 import _replay_shared_state\n        from megatoken.data.schema import make_records\n\n        adapter, runtime = self.setup_adapter([(self.target(0), True), (self.target(1), True)])\n        selected = self.request(adapter)\n        public, contexts, context = prefix(self.example, 0)\n        public[\"timeline\"].append(\n            copy.deepcopy(self.example[\"public\"][\"timeline\"][context[\"visibleThrough\"]])\n        )\n        publication = copy.deepcopy(public[\"timeline\"][0])\n        publication[\"sequence\"] = len(public[\"timeline\"]) + 1\n        publication[\"fields\"][\"programId\"] = \"other-program\"\n        public[\"timeline\"].append(publication)\n        identity = selected[\"selection\"][\"session\"]\n        contexts.append(context)\n        acknowledgement = adapter.commit(\n            session=identity,\n            public=public,\n            contexts=contexts,\n            invocationId=context[\"invocationId\"],\n            record=selected[\"record\"],\n            selection=selected[\"selection\"],\n        )\n        self.assertEqual(acknowledgement[\"publicDigest\"], stable_algorithm_hash(public))\n        observed = len(runtime.observations)\n        with self.assertRaisesRegex(ValueError, \"rewrites acknowledged native history\"):\n            self.request(adapter, 1)\n        self.assertEqual(len(runtime.observations), observed)\n        self.assertEqual(len(runtime.controls), 1)\n\n        # The acknowledged observation is valid, but is not neural input until\n        # the next independently reconstructed public prediction boundary.\n        following = copy.deepcopy(self.example[\"contexts\"][1])\n        following.update(\n            _replay_shared_state(\n                public[\"timeline\"],\n                contexts,\n                {},\n                roundtrip=False,\n                boundary_invocation=context[\"invocationId\"],\n            ),\n            visibleThrough=len(public[\"timeline\"]),\n            prefixDigest=stable_algorithm_hash(public[\"timeline\"]),\n        )\n        final = adapter.select(\n            session=identity, public=public, contexts=contexts, context=following\n        )\n        terminal = copy.deepcopy(self.example[\"public\"][\"timeline\"][-1])\n        terminal[\"sequence\"] = len(public[\"timeline\"]) + 1\n        public[\"timeline\"].append(terminal)\n        contexts.append(following)\n        adapter.commit(\n            session=identity,\n            public=public,\n            contexts=contexts,\n            invocationId=context[\"invocationId\"],\n            record=final[\"record\"],\n            selection=final[\"selection\"],\n        )\n        adapter.complete(\n            session=identity, public=public, contexts=contexts, invocationId=context[\"invocationId\"]\n        )\n        chunks = make_records(\n            canonical_semantic_observation(publication),\n            logical_id=f\"semantic:v8:observation:{publication['sequence']}\",\n            role=\"user\",\n            codec=runtime.codec,\n            max_tokens=256,\n            content_kind=\"text\",\n        )\n        for chunk in chunks:\n            self.assertEqual(\n                sum(row.event_id == chunk.record_id for row in runtime.observations), 1\n            )\n\n    def test_completion_requires_terminal_acknowledgement_and_explicit_session_close(self):\n        adapter, _ = self.setup_adapter([(self.target(0), True), (self.target(1), True)])\n        first = self.request(adapter)\n        self.acknowledge(adapter, first)\n        identity = first[\"selection\"][\"session\"]\n        before, contexts, _ = prefix(self.example, 1)\n        with self.assertRaisesRegex(ValueError, \"terminal record\"):\n            adapter.complete(\n                session=identity,\n                public=before,\n                contexts=contexts,\n                invocationId=first[\"selection\"][\"invocationId\"],\n            )\n        final = self.request(adapter, 1)\n        self.acknowledge(adapter, final, 1)\n        completed_public = copy.deepcopy(self.example[\"public\"])\n        publication = copy.deepcopy(completed_public[\"timeline\"][0])\n        publication[\"sequence\"] = len(completed_public[\"timeline\"]) + 1\n        publication[\"fields\"][\"programId\"] = \"completion-program\"\n        completed_public[\"timeline\"].append(publication)\n        completed = adapter.complete(\n            session=identity,\n            public=completed_public,\n            contexts=self.example[\"contexts\"],\n            invocationId=final[\"selection\"][\"invocationId\"],\n            completion={\"kind\": \"return\"},\n        )\n        self.assertTrue(completed[\"completed\"])\n        self.assertTrue(completed[\"sessionRetained\"])\n        with self.assertRaisesRegex(ValueError, \"completion rewrites acknowledged\"):\n            adapter.complete(\n                session=identity,\n                public=self.example[\"public\"],\n                contexts=self.example[\"contexts\"],\n                invocationId=final[\"selection\"][\"invocationId\"],\n            )\n        self.assertEqual(adapter.metrics()[\"activeSessions\"], 1)\n        adapter.cancel(session=identity, reason=\"completed\")\n        self.assertEqual(adapter.metrics()[\"activeSessions\"], 0)\n\n    def test_callback_completions_preserve_native_tape_for_later_callback_and_parent(self):\n        from megatoken.data.detailed_v7 import parse_record\n\n        self.example = examples(\"semantic-callback-regions-v8.json.gz.b64\")[0]\n        adapter, runtime = self.setup_adapter(\n            [(self.target(index), True) for index in range(len(self.example[\"contexts\"]))]\n        )\n        completed = []\n        last_revision = 0\n        for index, context in enumerate(self.example[\"contexts\"]):\n            result = self.request(adapter, index)\n            self.acknowledge(adapter, result, index)\n            identity = result[\"selection\"][\"session\"]\n            current = adapter.sessions[identity].runtime\n            self.assertGreater(current.revision, last_revision)\n            last_revision = current.revision\n            if (\n                result[\"record\"].startswith(\"detail \")\n                and parse_record(result[\"record\"])[0] == \"end\"\n            ):\n                public = copy.deepcopy(self.example[\"public\"])\n                public[\"timeline\"] = public[\"timeline\"][: context[\"visibleThrough\"] + 1]\n                response = adapter.complete(\n                    session=identity,\n                    public=public,\n                    contexts=self.example[\"contexts\"][: index + 1],\n                    invocationId=context[\"invocationId\"],\n                )\n                self.assertTrue(response[\"sessionRetained\"])\n                self.assertIs(adapter.sessions[identity].runtime, current)\n                self.assertIn(current.memory.session_id, runtime.memory.sessions)\n                completed.append(context[\"invocationId\"])\n        self.assertEqual(completed, [\"event1\", \"event2\", \"invocation1\"])\n        self.assertEqual(adapter.metrics()[\"predictionAttempts\"], len(self.example[\"contexts\"]))\n        self.assertEqual(len(adapter.metrics()[\"sessionOpenings\"]), 1)\n        adapter.cancel(session=identity, reason=\"completed\")\n\n    def test_commit_cannot_smuggle_extra_routing_payload(self):\n        adapter, _ = self.setup_adapter([(self.target(), True)])\n        result = self.request(adapter)\n        public, contexts, context = prefix(self.example, 0)\n        public[\"timeline\"].append(\n            copy.deepcopy(self.example[\"public\"][\"timeline\"][context[\"visibleThrough\"]])\n        )\n        public[\"timeline\"][-1][\"fields\"][\"futureAnswer\"] = 42\n        with self.assertRaisesRegex(ValueError, \"unexpected generated routing\"):\n            adapter.commit(\n                session=result[\"selection\"][\"session\"],\n                public=public,\n                contexts=contexts + [context],\n                invocationId=context[\"invocationId\"],\n                record=result[\"record\"],\n                selection=result[\"selection\"],\n            )\n\n    def test_actual_native_runtime_generates_without_mutating_unacknowledged_state(self):\n        import torch\n\n        from megatoken.generation.policy import FacetedGenerator\n        from megatoken.model import FacetedCore, ModelConfig\n        from megatoken.model.multitrack import MultiTrackGenerator\n        from megatoken.multitrack_runtime import MultiTrackRuntime\n\n        torch.set_num_threads(1)\n        torch.manual_seed(17)\n        model = FacetedGenerator(\n            FacetedCore(ModelConfig.tiny(max_history_chunks=128, max_capacity=512)),\n            ByteCodec.byte_fallback(),\n        ).eval()\n        weights = {key: value.clone() for key, value in model.state_dict().items()}\n        runtime = MultiTrackRuntime(MultiTrackGenerator.of(model))\n        adapter = NativeSemanticInferenceV8(\n            runtime, model_identity=\"a\" * 64, max_tokens=4, max_fragments=1\n        )\n        adapter.initialize(\n            seed=17, checkpointIdentity=\"a\" * 64, tokenizerIdentity=model.codec.fingerprint\n        )\n        public, contexts, context = prefix(self.example, 0)\n        identity = public[\"timeline\"][0][\"fields\"][\"session\"]\n        self.assertEqual(\n            adapter.initialization[\"generationSettings\"],\n            {\"device\": \"cpu\", \"maxTokens\": 4, \"maxFragments\": 1, \"effort\": 1},\n        )\n        try:\n            with torch.inference_mode():\n                original = adapter._opened(identity).runtime\n                before = original.state.raw.clone()\n                try:\n                    self.request(adapter)\n                except NativeSelectionV8Error as error:\n                    self.assertIsNotNone(error.evidence)\n                self.assertEqual(original.revision, 0)\n                self.assertTrue(torch.equal(original.state.raw, before))\n                measured = adapter.metrics()\n                self.assertEqual(len(measured[\"attempts\"][0][\"fragments\"]), 1)\n                self.assertGreater(measured[\"generatedTokens\"], 0)\n                self.assertIsNone(measured[\"learnedSuccess\"])\n                self.assertTrue(\n                    all(\n                        torch.equal(value, model.state_dict()[key])\n                        for key, value in weights.items()\n                    )\n                )\n        finally:\n            for session in list(adapter.sessions):\n                adapter.cancel(session=session, reason=\"test-complete\")\n            runtime.close()\n\n    def test_real_training_and_serving_prediction_state_and_controls_match_exactly(self):\n        import tempfile\n\n        import torch\n\n        from megatoken.data.chunking import ChunkingConfig\n        from megatoken.data.storage import PreparedCorpus\n        from megatoken.loading import build_model\n        from megatoken.model import ModelConfig\n        from megatoken.model.multitrack import MultiTrackGenerator\n        from megatoken.multitrack_runtime import MultiTrackRuntime\n        from megatoken.training.config import TrainConfig\n        from scripts.fit_semantic_v8 import capture_boundaries\n        from tests.test_semantic_v8_training_policy import prepared_v8_fixture\n\n        torch.set_num_threads(1)\n        torch.manual_seed(17)\n        temporary = tempfile.TemporaryDirectory()\n        self.addCleanup(temporary.cleanup)\n        _, codec, policy, prepared = prepared_v8_fixture(\n            Path(temporary.name), max_positions=128, max_history=128\n        )\n        model = build_model(\n            ModelConfig.tiny(max_history_chunks=128, max_capacity=512), codec\n        ).eval()\n        with PreparedCorpus([str(prepared)], split=\"train\") as corpus:\n            episode = next(corpus.iter_episodes())\n            chunking = ChunkingConfig.from_identity(corpus.chunking, codec)\n        self.assertLess(chunking.hard_max_tokens, model.config.max_capacity)\n        config = TrainConfig(\n            purpose=\"diagnostic\",\n            phase=\"P1\",\n            model=\"tiny\",\n            codec=\"injected-tokenizer\",\n            datasets=[str(prepared)],\n            semantic_v8_policy=policy,\n            device=\"cpu\",\n            precision=\"fp32\",\n            representation_mode=\"bootstrap\",\n            effort=1,\n            generated_capacity=128,\n            max_window_records=128,\n            max_history_tokens=16384,\n            max_record_bytes=16384,\n            scored_decisions=3,\n            max_steps=1,\n            gradient_checkpointing=False,\n            expert_backend=\"torch\",\n        )\n        boundaries, _ = capture_boundaries(model, episode, config, Path(__file__).parent)\n        runtime = MultiTrackRuntime(MultiTrackGenerator.of(model), chunking=chunking)\n        adapter = NativeSemanticInferenceV8(\n            runtime, model_identity=\"a\" * 64, max_tokens=4, max_fragments=1\n        )\n        actual_generate = runtime.generate\n        seen = []\n\n        def capture(session, **kwargs):\n            seen.append((session.state.detach(), kwargs))\n            return actual_generate(session, **kwargs)\n\n        runtime.generate = capture\n        try:\n            with torch.inference_mode():\n                adapter.initialize(\n                    seed=17, checkpointIdentity=\"a\" * 64, tokenizerIdentity=codec.fingerprint\n                )\n                try:\n                    self.request(adapter)\n                except NativeSelectionV8Error:\n                    pass  # Random model output is not the assertion under test.\n            self.assertEqual(len(seen), 1)\n            trained, training_request = boundaries[0]\n            served, serving_request = seen[0]\n            for left, right in (\n                (trained.raw, served.raw),\n                (trained.history.keys, served.history.keys),\n                (trained.history.values, served.history.values),\n            ):\n                self.assertTrue(torch.equal(left, right))\n            self.assertEqual(trained.history_event_ids, served.history_event_ids)\n            self.assertEqual(trained.history_event_tracks, served.history_event_tracks)\n            self.assertEqual(trained.track_descriptions, served.track_descriptions)\n            self.assertEqual(training_request[\"control_payloads\"], serving_request[\"controls\"])\n        finally:\n            for session in list(adapter.sessions):\n                adapter.cancel(session=session, reason=\"test-complete\")\n            runtime.close()\n\n    def test_committed_request_readback_restores_only_verified_poststate(self):\n        import tempfile\n\n        target = self.target()\n        fragments = [(target[:20], False), (target[20:], True)]\n        adapter, _runtime = self.setup_adapter(fragments)\n        selection = self.request(adapter)\n        session = selection[\"selection\"][\"session\"]\n        before, contexts, context = prefix(self.example, 0)\n        public = copy.deepcopy(self.example[\"public\"])\n        public[\"timeline\"] = public[\"timeline\"][: context[\"visibleThrough\"] + 1]\n        native_identity = {\n            \"schema\": \"semantic-native-request-identity/1\",\n            \"session_id\": session,\n            \"stream_id\": \"bridge-test\",\n            \"session_generation\": 1,\n            \"ordinal\": 1,\n            \"operation\": \"commit\",\n            \"model_identity\": {\n                \"checkpoint\": \"a\" * 64,\n                \"tokenizer\": adapter.codec.fingerprint,\n            },\n        }\n        request = {\n            \"id\": \"commit-rpc-1\",\n            \"op\": \"commit\",\n            \"nativeRequest\": native_identity,\n            \"session\": session,\n            \"public\": public,\n            \"contexts\": contexts + [context],\n            \"invocationId\": context[\"invocationId\"],\n            \"record\": selection[\"record\"],\n            \"selection\": selection[\"selection\"],\n        }\n        raw = json.dumps(request, separators=(\",\", \":\")).encode()\n\n        def commit(exact):\n            checked = json.loads(exact)\n            result = adapter.commit(\n                session=checked[\"session\"],\n                public=checked[\"public\"],\n                contexts=checked[\"contexts\"],\n                invocationId=checked[\"invocationId\"],\n                record=checked[\"record\"],\n                selection=checked[\"selection\"],\n            )\n            return json.dumps(\n                {\"id\": checked[\"id\"], \"ok\": True, \"result\": result},\n                separators=(\",\", \":\"),\n            ).encode()\n\n        with tempfile.TemporaryDirectory() as directory:\n            bridge = CheckpointBoundNativeRequestBridge(DurableNativeRequestJournal(directory))\n            original_response = bridge.execute_commit(adapter, native_identity, raw, commit)\n            fresh, _fresh_runtime = self.setup_adapter(fragments)\n            restored_response = bridge.execute_commit(\n                fresh,\n                native_identity,\n                raw,\n                lambda _: self.fail(\"completed native commit was redispatched\"),\n            )\n            self.assertEqual(restored_response, original_response)\n            self.assertEqual(fresh.checkpoint(), adapter.checkpoint())\n            self.assertEqual(fresh.attempts[-1][\"status\"], \"committed\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}
2026-11-22T09:27:42.2175064Z FORMATTED_SOURCE_JSON {"path": "tests/test_serve_semantic_v8.py", "content": "\"\"\"Exercise the JSONL loop without replacing parsing with a direct adapter call.\"\"\"\n\nimport io\nimport json\nimport runpy\nimport sys\nfrom pathlib import Path\nfrom types import SimpleNamespace\n\n\ndef test_jsonl_rejects_ambiguous_or_nonstandard_json_and_recovers(monkeypatch, capsys):\n    script = Path(__file__).parents[1] / \"scripts\" / \"serve_semantic_v8.py\"\n    main = runpy.run_path(str(script))[\"main\"]\n    calls = []\n    adapter = SimpleNamespace(sessions={}, metrics=lambda: calls.append(\"metrics\") or {})\n    runtime = SimpleNamespace(close=lambda: calls.append(\"close\"))\n    bundle = SimpleNamespace(\n        model=None,\n        chunking=None,\n        manifest={\"model_sha256\": \"a\" * 64, \"semantic_v8_lineage_digest\": \"b\" * 64},\n    )\n    monkeypatch.setitem(main.__globals__, \"ServedBundle\", lambda *args, **kwargs: bundle)\n    monkeypatch.setitem(main.__globals__, \"MultiTrackGenerator\", SimpleNamespace(of=lambda _: None))\n    monkeypatch.setitem(main.__globals__, \"MultiTrackRuntime\", lambda *args, **kwargs: runtime)\n\n    def construct(*args, **kwargs):\n        assert kwargs[\"training_identity\"] == \"b\" * 64\n        return adapter\n\n    monkeypatch.setitem(main.__globals__, \"NativeSemanticInferenceV8\", construct)\n    monkeypatch.setattr(sys, \"argv\", [str(script), \"--served\", \"unused\"])\n    monkeypatch.setattr(\n        sys,\n        \"stdin\",\n        SimpleNamespace(\n            buffer=io.BytesIO(\n                b'{\"id\":\"duplicate\",\"op\":\"unknown\",\"op\":\"metrics\"}\\n'\n                b'{\"id\":\"nonfinite\",\"op\":\"metrics\",\"extra\":NaN}\\n'\n                b'{\"id\":\"utf8\",\"op\":\"metrics\",\"extra\":\"\\xff\"}\\n'\n                b'{\"id\":\"valid\",\"op\":\"metrics\"}\\n'\n            )\n        ),\n    )\n    assert main() == 0\n    replies = [json.loads(line) for line in capsys.readouterr().out.splitlines()]\n    assert len(replies) == 4\n    assert [reply[\"ok\"] for reply in replies] == [False, False, False, True]\n    assert \"duplicate JSON object key\" in replies[0][\"error\"][\"message\"]\n    assert \"nonstandard JSON constant\" in replies[1][\"error\"][\"message\"]\n    assert replies[-1][\"id\"] == \"valid\"\n    assert calls == [\"metrics\", \"close\"]\n\n\ndef test_opt_in_jsonl_commit_readback_requires_same_locked_ofd_and_restores_checkpoint(\n    monkeypatch, capsys, tmp_path\n):\n    import copy\n    import fcntl\n    import os\n\n    from megatoken.data.semantic_json import stable_algorithm_hash\n\n    script = Path(__file__).parents[1] / \"scripts\" / \"serve_semantic_v8.py\"\n    main = runpy.run_path(str(script))[\"main\"]\n    namespace = main.__globals__\n    model = {\"checkpoint\": \"a\" * 64, \"tokenizer\": \"b\" * 64}\n    public = {\"timeline\": [{\"mode\": \"generated\", \"fields\": {\"line\": \"answer\"}}]}\n    request_identity = {\n        \"schema\": \"semantic-native-request-identity/1\",\n        \"session_id\": \"lock-session\",\n        \"stream_id\": \"lock-stream\",\n        \"session_generation\": 4,\n        \"ordinal\": 1,\n        \"operation\": \"commit\",\n        \"model_identity\": model,\n    }\n    request = {\n        \"id\": \"v8-native-4-1\",\n        \"op\": \"commit\",\n        \"nativeRequest\": request_identity,\n        \"session\": \"session-a\",\n        \"selection\": {\"selectionId\": \"v8:0\"},\n        \"public\": public,\n        \"contexts\": [],\n        \"invocationId\": \"invocation-a\",\n        \"record\": \"answer\",\n    }\n    line = json.dumps(request, separators=(\",\", \":\")).encode() + b\"\\n\"\n    calls = []\n\n    class Adapter:\n        def __init__(self, runtime, **kwargs):\n            self.runtime = runtime\n            self.model_identity = \"a\" * 64\n            self.codec = SimpleNamespace(fingerprint=\"b\" * 64)\n            self.training_identity = None\n            self.initialization = {\n                \"checkpointIdentity\": self.model_identity,\n                \"tokenizerIdentity\": self.codec.fingerprint,\n                \"trainingIdentity\": None,\n            }\n            self.attempts = []\n            self.sessions = {}\n            self.state = None\n\n        def checkpoint(self):\n            if self.state is None:\n                raise ValueError(\"fresh adapter has no state\")\n            return copy.deepcopy(self.state)\n\n        def restore(self, *, checkpoint):\n            assert self.state is None\n            self.state = copy.deepcopy(checkpoint)\n            self.attempts = copy.deepcopy(checkpoint[\"attempts\"])\n\n        def cancel(self, **kwargs):\n            return {\"closed\": True}\n\n        def metrics(self):\n            return {}\n\n    class Runtime:\n        memory = SimpleNamespace(sessions={})\n\n        def close(self):\n            return None\n\n    bundle = SimpleNamespace(\n        model=None,\n        chunking=None,\n        manifest={\"model_sha256\": model[\"checkpoint\"]},\n    )\n    monkeypatch.setitem(namespace, \"ServedBundle\", lambda *args, **kwargs: bundle)\n    monkeypatch.setitem(namespace, \"MultiTrackGenerator\", SimpleNamespace(of=lambda _: None))\n    monkeypatch.setitem(namespace, \"MultiTrackRuntime\", lambda *args, **kwargs: Runtime())\n    monkeypatch.setitem(namespace, \"NativeSemanticInferenceV8\", Adapter)\n\n    def dispatch(adapter, value):\n        calls.append(value[\"id\"])\n        attempt = {\"selectionId\": \"v8:0\", \"status\": \"committed\", \"session\": value[\"session\"]}\n        adapter.attempts = [attempt]\n        adapter.state = {\n            \"schema\": \"semantic-model-checkpoint/8\",\n            \"initialization\": adapter.initialization,\n            \"attempts\": adapter.attempts,\n            \"sessions\": {\n                value[\"session\"]: {\n                    \"public\": copy.deepcopy(value[\"public\"]),\n                    \"unacknowledgedSelection\": None,\n                }\n            },\n        }\n        adapter.state[\"digest\"] = stable_algorithm_hash(adapter.state)\n        return {\n            \"schema\": \"semantic-native-commit/8\",\n            \"selectionId\": \"v8:0\",\n            \"publicDigest\": stable_algorithm_hash(value[\"public\"]),\n            \"committed\": True,\n        }\n\n    monkeypatch.setitem(namespace, \"dispatch\", dispatch)\n    lock_path = tmp_path / \"execution.lock\"\n    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)\n    fcntl.flock(fd, fcntl.LOCK_EX)\n    argv = [\n        str(script),\n        \"--served\",\n        \"unused\",\n        \"--request-journal\",\n        str(tmp_path / \"journal\"),\n        \"--execution-lock-fd\",\n        str(fd),\n        \"--execution-lock-session\",\n        \"lock-session\",\n        \"--execution-lock-stream\",\n        \"lock-stream\",\n        \"--execution-lock-path\",\n        str(lock_path),\n    ]\n    try:\n        for expected_calls in ([\"v8-native-4-1\"], [\"v8-native-4-1\"]):\n            monkeypatch.setattr(sys, \"argv\", argv)\n            monkeypatch.setattr(sys, \"stdin\", SimpleNamespace(buffer=io.BytesIO(line)))\n            assert main() == 0\n            output = capsys.readouterr().out.splitlines()\n            assert len(output) == 1\n            reply = json.loads(output[0])\n            assert reply[\"id\"] == request[\"id\"]\n            assert reply[\"ok\"] is True\n            assert reply[\"result\"][\"publicDigest\"] == stable_algorithm_hash(public)\n            assert calls == expected_calls\n    finally:\n        fcntl.flock(fd, fcntl.LOCK_UN)\n        os.close(fd)\n\n\ndef test_real_jsonl_subprocess_reads_exact_committed_reply_after_process_restart(\n    tmp_path,\n):\n    import fcntl\n    import json\n    import os\n    import subprocess\n    import sys\n\n    from megatoken.data.semantic_json import stable_algorithm_hash\n\n    fixture = Path(__file__).parent / \"fixtures\" / \"serve_semantic_v8_bridge_fixture.py\"\n    lock_path = tmp_path / \"execution.lock\"\n    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)\n    fcntl.flock(fd, fcntl.LOCK_EX)\n    public = {\"timeline\": [{\"mode\": \"generated\", \"fields\": {\"line\": \"persisted\"}}]}\n    request = {\n        \"id\": \"v8-native-8-1\",\n        \"op\": \"commit\",\n        \"nativeRequest\": {\n            \"schema\": \"semantic-native-request-identity/1\",\n            \"session_id\": \"scope-session\",\n            \"stream_id\": \"scope-stream\",\n            \"session_generation\": 8,\n            \"ordinal\": 1,\n            \"operation\": \"commit\",\n            \"model_identity\": {\"checkpoint\": \"a\" * 64, \"tokenizer\": \"b\" * 64},\n        },\n        \"session\": \"native-session\",\n        \"selection\": {\"selectionId\": \"v8:0\"},\n        \"public\": public,\n        \"contexts\": [],\n        \"invocationId\": \"invocation-a\",\n        \"record\": \"persisted\",\n    }\n    request_line = json.dumps(request, separators=(\",\", \":\")).encode() + b\"\\n\"\n    calls_path = tmp_path / \"calls.txt\"\n    env = dict(\n        os.environ,\n        JOURNAL_PATH=str(tmp_path / \"journal\"),\n        LOCK_FD=str(fd),\n        LOCK_PATH=str(lock_path),\n        LOCK_SESSION=\"scope-session\",\n        LOCK_STREAM=\"scope-stream\",\n        CALLS_PATH=str(calls_path),\n    )\n    try:\n        outputs = []\n        for _ in range(2):\n            child = subprocess.run(\n                [sys.executable, str(fixture)],\n                input=request_line,\n                capture_output=True,\n                timeout=45,\n                pass_fds=(fd,),\n                env=env,\n                check=False,\n            )\n            assert child.returncode == 0, child.stderr.decode(\"utf-8\", errors=\"replace\")\n            outputs.append(child.stdout)\n        assert outputs[0] == outputs[1]\n        reply = json.loads(outputs[1])\n        assert reply[\"id\"] == request[\"id\"]\n        assert reply[\"ok\"] is True\n        assert reply[\"result\"][\"publicDigest\"] == stable_algorithm_hash(public)\n        assert calls_path.read_text(encoding=\"utf-8\").splitlines() == [request[\"id\"]]\n    finally:\n        fcntl.flock(fd, fcntl.LOCK_UN)\n        os.close(fd)\n\n\ndef test_jsonl_stops_and_never_retries_after_commit_outcome_becomes_unknown(tmp_path):\n    import fcntl\n    import json\n    import os\n    import subprocess\n    import sys\n\n    fixture = Path(__file__).parent / \"fixtures\" / \"serve_semantic_v8_bridge_fixture.py\"\n    lock_path = tmp_path / \"execution.lock\"\n    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)\n    fcntl.flock(fd, fcntl.LOCK_EX)\n    request = {\n        \"id\": \"v8-native-8-1\",\n        \"op\": \"commit\",\n        \"nativeRequest\": {\n            \"schema\": \"semantic-native-request-identity/1\",\n            \"session_id\": \"scope-session\",\n            \"stream_id\": \"scope-stream\",\n            \"session_generation\": 8,\n            \"ordinal\": 1,\n            \"operation\": \"commit\",\n            \"model_identity\": {\"checkpoint\": \"a\" * 64, \"tokenizer\": \"b\" * 64},\n        },\n        \"session\": \"native-session\",\n        \"selection\": {\"selectionId\": \"v8:0\"},\n        \"public\": {\"timeline\": [{\"mode\": \"generated\", \"fields\": {\"line\": \"unknown\"}}]},\n        \"contexts\": [],\n        \"invocationId\": \"invocation-b\",\n        \"record\": \"unknown\",\n    }\n    line = json.dumps(request, separators=(\",\", \":\")).encode() + b\"\\n\"\n    calls_path = tmp_path / \"calls.txt\"\n    env = dict(\n        os.environ,\n        JOURNAL_PATH=str(tmp_path / \"journal\"),\n        LOCK_FD=str(fd),\n        LOCK_PATH=str(lock_path),\n        LOCK_SESSION=\"scope-session\",\n        LOCK_STREAM=\"scope-stream\",\n        CALLS_PATH=str(calls_path),\n        FAIL_AFTER_DISPATCH=\"1\",\n    )\n    try:\n        fixture_outputs = []\n        for input_bytes in (line + line, line):\n            child = subprocess.run(\n                [sys.executable, str(fixture)],\n                input=input_bytes,\n                capture_output=True,\n                timeout=45,\n                pass_fds=(fd,),\n                env=env,\n                check=False,\n            )\n            assert child.returncode == 0, child.stderr.decode(\"utf-8\", errors=\"replace\")\n            replies = [json.loads(row) for row in child.stdout.splitlines()]\n            assert len(replies) == 1\n            assert replies[0][\"id\"] == request[\"id\"]\n            assert replies[0][\"ok\"] is False\n            assert replies[0][\"error\"][\"category\"] == \"NativeRequestOutcomeUnknown\"\n            fixture_outputs.append(child.stdout)\n        assert calls_path.read_text(encoding=\"utf-8\").splitlines() == [request[\"id\"]]\n    finally:\n        fcntl.flock(fd, fcntl.LOCK_UN)\n        os.close(fd)\n\n\ndef test_jsonl_server_refuses_abbreviated_recovery_flags_before_loading_model(monkeypatch, capsys):\n    import pytest\n\n    script = Path(__file__).parents[1] / \"scripts\" / \"serve_semantic_v8.py\"\n    main = runpy.run_path(str(script))[\"main\"]\n    monkeypatch.setattr(sys, \"argv\", [str(script), \"--served\", \"unused\", \"--request-j\", \"unused\"])\n    with pytest.raises(SystemExit) as refused:\n        main()\n    assert refused.value.code == 2\n    assert \"unrecognized arguments: --request-j\" in capsys.readouterr().err\n"}
