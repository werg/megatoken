{
  "schema": "megatoken.cloud-job/1",
  "id": "prepare-teacher-structure",
  "image": "nvcr.io/nvidia/pytorch:26.09-py3",
  "resources": {
    "cpu": "8",
    "memory": "32Gi",
    "gpu": 1
  },
  "lifetime_hours": 24,
  "pip": [
    "transformers==5.20.2",
    "safetensors>=0.5,<1",
    "pyarrow>=18,<24"
  ],
  "inputs": [],
  "command": [
    "python",
    "-m",
    "megatoken",
    "prepare-hindsight",
    "--train-config",
    "configs/train/coherence.example.yaml",
    "--writer",
    "/work/assets/hindsight-writer",
    "--output",
    "/work/out/hindsight",
    "--device",
    "cuda"
  ],
  "outputs": [
    "out/hindsight"
  ],
  "serve_port": 8080,
  "serve_outputs": true
}
